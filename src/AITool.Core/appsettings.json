{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "CoreServer": {
    "Port": 5029
  },
  "ProxyForwarding": {
    "RequestTimeoutSeconds": 60,
    "RetryCount": 1
  },
  "Cors": {
    "AllowedOrigins": [ "http://127.0.0.1:5030", "http://localhost:5030" ]
  },
  "AllowedHosts": "*"
}
