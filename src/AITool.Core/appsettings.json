{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "CoreServer": {
    "Port": 5029
  },
  "CoreAuth": {
    "_comment": "跨宿主共享密钥：Admin → Core 的 /api/core/* 管理端点鉴权用（请求头 X-Core-Auth）。留空 = 仅允许本机回环访问管理端点（/v1 代理不受影响）。跨机部署（Admin 在本地、Core 在服务器）必须配置，且与 Admin 的 CoreServer:SharedSecret 保持一致。",
    "SharedSecret": ""
  },
  "NativeMemory": {
    "MallocArenaMax": 2,
    "MallocTrimThresholdBytes": 65536,
    "MallocMmapThresholdBytes": 131072
  },
  "ProxyForwarding": {
    "RequestTimeoutSeconds": 60,
    "RetryCount": 1,
    "SseHeartbeatSeconds": 15
  },
  "Cors": {
    "AllowedOrigins": [ "http://127.0.0.1:5030", "http://localhost:5030" ]
  },
  "AllowedHosts": "*",
  "Debug": {
    "_comment": "设置调试页 /debug/runtime 的访问密钥保护。此值为密钥明文的 SHA256 十六进制哈希。生成方式：echo -n '你的密钥' | sha256sum",
    "KeyHash": "db5848285c51d5787a64e1d98be6ac934c162e8a6a821f8c3842104e3c739f93"
  }
}
