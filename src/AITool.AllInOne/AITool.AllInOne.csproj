<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Workstation GC + 堆上限（与 Admin/Core 同款，见 runtimeconfig.template.json）。 -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!-- 前端产物以普通 Content 拷贝输出，关闭 StaticWebAssets 管道避免双重包含冲突。 -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <!-- 只生成 zh-Hans 的语言资源 -->
    <SatelliteResourceLanguages>zh</SatelliteResourceLanguages>
    <Version>1.0.1.26</Version>
    <AssemblyVersion>1.0.1.26</AssemblyVersion>
    <FileVersion>1.0.1.26</FileVersion>
    <!-- 编译时间戳注入到程序集元数据（AssemblyMetadata），供运行时读取展示 -->
    <BuildTimestamp>$([System.DateTime]::UtcNow.ToString("O"))</BuildTimestamp>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AITool.Admin\AITool.Admin.csproj" />
    <ProjectReference Include="..\AITool.Core\AITool.Core.csproj" />
  </ItemGroup>

  <!-- 前端构建产物直接复用 Admin 的 wwwroot（vite 输出到 Admin/wwwroot）。 -->
  <ItemGroup>
    <Content Include="..\AITool.Admin\wwwroot\**" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\AITool.Admin\wwwroot')" />
  </ItemGroup>

</Project>