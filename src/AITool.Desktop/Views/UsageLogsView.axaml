<UserControl
    x:Class="AITool.Desktop.Views.UsageLogsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AITool.Desktop.ViewModels"
    x:DataType="vm:UsageLogsViewModel"
    x:CompileBindings="False">
  <Grid MinWidth="0" ClipToBounds="True" RowDefinitions="Auto,*" RowSpacing="24">
    <StackPanel Spacing="4">
      <TextBlock FontSize="22" FontWeight="Bold" Foreground="#1E293B" Text="调用日志" />
      <TextBlock Classes="page-subtitle" Text="查看代理服务和对话测试的调用记录" />
    </StackPanel>

    <ScrollViewer
        Grid.Row="1"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="14">
        <Border Classes="content-card" Padding="0">
          <StackPanel>
            <!-- 顶部工具栏保持单行，筛选标题和自动刷新互不挤压。 -->
            <Border Padding="18,12">
              <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <Button
                    Classes="filter-toggle"
                    Command="{Binding ToggleFiltersCommand}"
                    HorizontalAlignment="Left"
                    HorizontalContentAlignment="Left"
                    Padding="0"
                    Focusable="False">
                  <TextBlock FontWeight="SemiBold" Foreground="#1E293B" Text="筛选与汇总" />
                </Button>
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                  <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#64748B" Text="自动刷新" />
                  <ToggleSwitch
                      VerticalAlignment="Center"
                      IsChecked="{Binding AutoRefresh, Mode=TwoWay}"
                      OnContent="开"
                      OffContent="关" />
                  <Button
                      Classes="secondary-button"
                      VerticalAlignment="Center"
                      Content="?"
                      Padding="8,4"
                      ToolTip.Tip="自动刷新每 5 秒更新一次当前页。" />
                </StackPanel>
              </Grid>
            </Border>

            <Border
                BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0"
                Padding="18,14"
                IsVisible="{Binding FiltersExpanded}">
              <Grid
                  ColumnDefinitions="1*,1*,1*"
                  RowDefinitions="Auto,Auto,Auto"
                  ColumnSpacing="16"
                  RowSpacing="12">
                <StackPanel HorizontalAlignment="Stretch" Spacing="4">
                  <TextBlock FontSize="11" Foreground="#64748B" Text="时间范围" />
                  <ComboBox
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding RangeOptions}"
                      SelectedItem="{Binding SelectedRange}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Stretch" Spacing="4">
                  <TextBlock FontSize="11" Foreground="#64748B" Text="站点" />
                  <ComboBox
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Sites}"
                      SelectedItem="{Binding SelectedSite}"
                      PlaceholderText="全部站点">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Stretch" Spacing="4">
                  <TextBlock FontSize="11" Foreground="#64748B" Text="访问密钥" />
                  <ComboBox
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding AccessKeys}"
                      SelectedItem="{Binding SelectedAccessKey}"
                      PlaceholderText="全部密钥">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="1" HorizontalAlignment="Stretch" Spacing="4">
                  <TextBlock FontSize="11" Foreground="#64748B" Text="来源" />
                  <ComboBox
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding SourceOptions}"
                      SelectedItem="{Binding SelectedSource}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Spacing="4">
                  <TextBlock FontSize="11" Foreground="#64748B" Text="状态" />
                  <ComboBox
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding StatusOptions}"
                      SelectedItem="{Binding SelectedStatus}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch" Spacing="4">
                  <TextBlock FontSize="11" Foreground="#64748B" Text="模型搜索" />
                  <TextBox
                      Classes="form-input"
                      HorizontalAlignment="Stretch"
                      Text="{Binding ModelKeyword}"
                      Watermark="模型模糊搜索" />
                </StackPanel>

                <StackPanel Grid.Row="2" HorizontalAlignment="Stretch" Spacing="4" IsVisible="{Binding IsCustomRange}">
                  <TextBlock FontSize="11" Foreground="#64748B" Text="开始时间" />
                  <DatePicker HorizontalAlignment="Stretch" SelectedDate="{Binding StartTime}" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" Spacing="4" IsVisible="{Binding IsCustomRange}">
                  <TextBlock FontSize="11" Foreground="#64748B" Text="结束时间" />
                  <DatePicker HorizontalAlignment="Stretch" SelectedDate="{Binding EndTime}" />
                </StackPanel>
                <StackPanel
                    Grid.Row="2"
                    Grid.Column="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Spacing="8">
                  <Button Classes="secondary-button" Command="{Binding RefreshCommand}" Content="刷新" Padding="12,7" />
                  <Button Classes="primary-button" Command="{Binding SearchCommand}" Content="查询" Padding="14,7" />
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </Border>

        <Grid ColumnDefinitions="1*,1*,1*,1*" ColumnSpacing="12" IsVisible="{Binding FiltersExpanded}">
          <Border Classes="content-card" Padding="14">
            <StackPanel Spacing="4">
              <TextBlock FontSize="12" Foreground="#64748B" Text="总请求" />
              <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="#1E293B" Text="{Binding Summary.TotalRequests}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="content-card" Padding="14">
            <StackPanel Spacing="4">
              <TextBlock FontSize="12" Foreground="#64748B" Text="成功率" />
              <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="#166534" Text="{Binding Summary.SuccessRateText}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Classes="content-card" Padding="14">
            <StackPanel Spacing="4">
              <TextBlock FontSize="12" Foreground="#64748B" Text="总 Tokens" />
              <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="#1E293B" Text="{Binding Summary.TotalTokens}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="3" Classes="content-card" Padding="14">
            <StackPanel Spacing="4">
              <TextBlock FontSize="12" Foreground="#64748B" Text="失败请求" />
              <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="#B91C1C" Text="{Binding Summary.FailedRequests}" />
            </StackPanel>
          </Border>
        </Grid>

        <Border Classes="content-card" Padding="0">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel MinWidth="1260">
              <Border Background="#F8FAFC" Padding="16,13">
                <Grid ColumnDefinitions="1.25*,0.85*,1.25*,1.2*,1.1*,1*,1.45*,0.8*,0.8*,0.8*,0.9*,Auto" ColumnSpacing="10">
                  <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="时间" />
                  <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="来源" />
                  <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="模型" />
                  <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="目标站点" />
                  <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="访问密钥" />
                  <TextBlock Grid.Column="5" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="状态" />
                  <TextBlock Grid.Column="6" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="用时/首字" />
                  <TextBlock Grid.Column="7" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="输入" />
                  <TextBlock Grid.Column="8" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="缓存" />
                  <TextBlock Grid.Column="9" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="输出" />
                  <TextBlock Grid.Column="10" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="总 Token" />
                  <TextBlock Grid.Column="11" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="操作" />
                </Grid>
              </Border>
              <TextBlock HorizontalAlignment="Center" Foreground="#94A3B8" IsVisible="{Binding HasNoItems}" Margin="0,30" Text="暂无调用日志" />
              <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,12">
                      <Grid ColumnDefinitions="1.25*,0.85*,1.25*,1.2*,1.1*,1*,1.45*,0.8*,0.8*,0.8*,0.9*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#64748B" Text="{Binding RequestedAtText}" TextTrimming="CharacterEllipsis" />
                        <Border Grid.Column="1" VerticalAlignment="Center" Background="#EEF4FF" CornerRadius="10" Padding="7,3" HorizontalAlignment="Left"><TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#5B8DEF" Text="{Binding SourceLabel}" /></Border>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12" Foreground="#1E293B" Text="{Binding AttemptedModel}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="12" Foreground="#64748B" Text="{Binding SiteName}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="12" Foreground="#64748B" Text="{Binding AccessKeyName}" TextTrimming="CharacterEllipsis" />
                        <Border Grid.Column="5" VerticalAlignment="Center" Background="#E8F7EA" CornerRadius="10" Padding="7,3" HorizontalAlignment="Left" IsVisible="{Binding IsSuccessfulStatus}"><TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#166534" Text="{Binding StatusText}" /></Border>
                        <Border Grid.Column="5" VerticalAlignment="Center" Background="#FEE2E2" CornerRadius="10" Padding="7,3" HorizontalAlignment="Left" IsVisible="{Binding IsFailedStatus}"><TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#B91C1C" Text="{Binding StatusText}" /></Border>
                        <StackPanel Grid.Column="6" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
                          <Border Background="#F1F5F9" CornerRadius="9" Padding="6,3"><TextBlock VerticalAlignment="Center" FontSize="10" Foreground="#475569" Text="{Binding DurationText}" /></Border>
                          <Border Background="#EFF6FF" CornerRadius="9" Padding="6,3"><TextBlock VerticalAlignment="Center" FontSize="10" Foreground="#315EA8" Text="{Binding FirstTokenText}" /></Border>
                          <Border Background="#F8FAFC" CornerRadius="9" Padding="6,3"><TextBlock VerticalAlignment="Center" FontSize="10" Foreground="#64748B" Text="{Binding StreamingText}" /></Border>
                        </StackPanel>
                        <TextBlock Grid.Column="7" VerticalAlignment="Center" FontSize="12" Foreground="#64748B" Text="{Binding InputTokensText}" />
                        <TextBlock Grid.Column="8" VerticalAlignment="Center" FontSize="12" Foreground="#64748B" Text="{Binding CachedTokensText}" />
                        <TextBlock Grid.Column="9" VerticalAlignment="Center" FontSize="12" Foreground="#64748B" Text="{Binding OutputTokensText}" />
                        <TextBlock Grid.Column="10" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" Text="{Binding TotalTokensText}" />
                        <Button Grid.Column="11" VerticalAlignment="Center" Classes="secondary-button" Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="查看链路" Padding="9,6" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Border>

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,0,0,8">
          <TextBlock VerticalAlignment="Center" Foreground="#64748B" Text="{Binding PaginationSummary}" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button Classes="secondary-button" Command="{Binding FirstPageCommand}" Content="首页" IsEnabled="{Binding CanFirst}" Padding="10,6" />
            <Button Classes="secondary-button" Command="{Binding PreviousPageCommand}" Content="上一页" IsEnabled="{Binding CanPrevious}" Padding="10,6" />
            <TextBlock VerticalAlignment="Center" Foreground="#64748B" Text="{Binding PageText}" Margin="5,0" />
            <Button Classes="secondary-button" Command="{Binding NextPageCommand}" Content="下一页" IsEnabled="{Binding CanNext}" Padding="10,6" />
            <Button Classes="secondary-button" Command="{Binding LastPageCommand}" Content="末页" IsEnabled="{Binding CanLast}" Padding="10,6" />
            <TextBox Classes="form-input" VerticalContentAlignment="Center" Width="70" Text="{Binding PageJumpInput}" Watermark="页码" />
            <Button Classes="secondary-button" Command="{Binding JumpPageCommand}" Content="前往" Padding="10,6" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <!-- 详情作为右侧浮层，不参与日志表格的横向测量。 -->
    <Border
        Grid.Row="1"
        Classes="content-card"
        Width="420"
        Padding="20"
        HorizontalAlignment="Right"
        IsVisible="{Binding HasDetail}"
        ZIndex="10">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <StackPanel Spacing="3">
              <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#1E293B" Text="请求链路详情" />
              <TextBlock FontSize="12" Foreground="#94A3B8" Text="查看本次请求的全部尝试记录" />
            </StackPanel>
            <Button Grid.Column="1" Classes="secondary-button" Command="{Binding CloseDetailCommand}" Content="关闭" Padding="10,6" />
          </Grid>
          <Border Background="#F8FAFC" CornerRadius="8" Padding="12">
            <StackPanel Spacing="7">
              <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding SelectedDetail.RequestId}" TextWrapping="Wrap" />
              <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding SelectedDetail.RequestModel}" />
              <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding SelectedDetail.RouteEntry}" />
              <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding SelectedDetail.ProtocolType}" />
              <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding SelectedDetail.ForwardingMode}" />
              <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding SelectedDetail.ReasoningEffort}" />
            </StackPanel>
          </Border>
          <TextBlock FontWeight="SemiBold" Foreground="#1E293B" Text="尝试记录" />
          <ItemsControl ItemsSource="{Binding SelectedDetail.Attempts}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                  <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                      <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#1E293B" Text="{Binding AttemptedModel}" />
                      <Border Grid.Column="1" VerticalAlignment="Center" Background="#E8F7EA" CornerRadius="10" Padding="7,3" IsVisible="{Binding IsSuccessfulStatus}"><TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#166534" Text="{Binding StatusText}" /></Border>
                      <Border Grid.Column="1" VerticalAlignment="Center" Background="#FEE2E2" CornerRadius="10" Padding="7,3" IsVisible="{Binding IsFailedStatus}"><TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#B91C1C" Text="{Binding StatusText}" /></Border>
                    </Grid>
                    <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding TargetSiteName}" />
                    <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding DurationText}" />
                    <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding TokensText}" />
                    <TextBlock FontSize="12" Foreground="#B91C1C" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
