<UserControl
    x:Class="AITool.Desktop.Views.UsageLogsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AITool.Desktop.ViewModels"
    x:DataType="vm:UsageLogsViewModel"
    x:CompileBindings="False">
  <Grid MinWidth="0" ClipToBounds="True" RowDefinitions="Auto,*" RowSpacing="24">
    <StackPanel Spacing="4">
      <TextBlock FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" Text="调用日志" />
      <TextBlock Classes="page-subtitle" Text="查看代理服务和对话测试的调用记录" />
    </StackPanel>

    <ScrollViewer
        Grid.Row="1"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="14">
        <Border Classes="content-card" Padding="0">
          <StackPanel>
            <!-- 顶部工具栏保持单行，筛选标题和自动刷新互不挤压。 -->
            <Border Padding="18,12">
              <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <Button
                    Classes="filter-toggle"
                    Command="{Binding ToggleFiltersCommand}"
                    HorizontalAlignment="Left"
                    HorizontalContentAlignment="Left"
                    Padding="0">
                  <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" Text="筛选与汇总" />
                </Button>
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                  <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="自动刷新" />
                  <ToggleSwitch
                      VerticalAlignment="Center"
                      IsChecked="{Binding AutoRefresh, Mode=TwoWay}"
                      OnContent="开"
                      OffContent="关" />
                  <Button
                      Classes="secondary-button"
                      VerticalAlignment="Center"
                      Content="?"
                      Padding="8,4"
                      ToolTip.Tip="自动刷新每 5 秒更新一次当前页。" />
                </StackPanel>
              </Grid>
            </Border>

            <Border
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="18,14"
                IsVisible="{Binding FiltersExpanded}">
              <WrapPanel
                  Orientation="Horizontal"
                  ItemWidth="210"
                  ItemHeight="78">
                <StackPanel HorizontalAlignment="Stretch" Spacing="4">
                  <TextBlock FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="时间范围" />
                  <ComboBox
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding RangeOptions}"
                      SelectedItem="{Binding SelectedRange}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Stretch" Spacing="4">
                  <TextBlock FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="站点" />
                  <ComboBox
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Sites}"
                      SelectedItem="{Binding SelectedSite}"
                      PlaceholderText="全部站点">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Stretch" Spacing="4">
                  <TextBlock FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="访问密钥" />
                  <ComboBox
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding AccessKeys}"
                      SelectedItem="{Binding SelectedAccessKey}"
                      PlaceholderText="全部密钥">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="1" HorizontalAlignment="Stretch" Spacing="4">
                  <TextBlock FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="来源" />
                  <ComboBox
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding SourceOptions}"
                      SelectedItem="{Binding SelectedSource}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Spacing="4">
                  <TextBlock FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="状态" />
                  <ComboBox
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding StatusOptions}"
                      SelectedItem="{Binding SelectedStatus}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch" Spacing="4">
                  <TextBlock FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="模型搜索" />
                  <TextBox
                      Classes="form-input"
                      HorizontalAlignment="Stretch"
                      Text="{Binding ModelKeyword}"
                      Watermark="模型模糊搜索" />
                </StackPanel>

                <StackPanel Grid.Row="2" HorizontalAlignment="Stretch" Spacing="4" IsVisible="{Binding IsCustomRange}">
                  <TextBlock FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="开始时间" />
                  <TextBox Classes="form-input" HorizontalAlignment="Stretch" Text="{Binding StartTime}" Watermark="例如 2026-08-06 00:00:00" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" Spacing="4" IsVisible="{Binding IsCustomRange}">
                  <TextBlock FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="结束时间" />
                  <TextBox Classes="form-input" HorizontalAlignment="Stretch" Text="{Binding EndTime}" Watermark="例如 2026-08-06 23:59:59" />
                </StackPanel>
                <StackPanel
                    Grid.Row="2"
                    Grid.Column="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Spacing="8">
                  <Button Classes="secondary-button" Command="{Binding RefreshCommand}" Content="刷新" Padding="12,7" />
                  <Button Classes="primary-button" Command="{Binding SearchCommand}" Content="查询" Padding="14,7" />
                </StackPanel>
              </WrapPanel>
            </Border>
          </StackPanel>
        </Border>

        <Border Background="{DynamicResource AppInfoSoftBrush}" CornerRadius="10" Padding="14" IsVisible="{Binding IsLoading}">
          <StackPanel Spacing="7">
            <ProgressBar IsIndeterminate="True" Height="4" />
            <TextBlock FontSize="12" Foreground="{DynamicResource AppInfoTextBrush}" Text="正在加载调用日志，请稍候..." />
          </StackPanel>
        </Border>
        <Border Background="{DynamicResource AppInputBackgroundBrush}" CornerRadius="10" Padding="14" IsVisible="{Binding IsDetailLoading}">
          <TextBlock FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="正在加载请求链路详情，请稍候..." />
        </Border>
        <Border Background="{DynamicResource AppDangerSoftBrush}" CornerRadius="10" Padding="14" IsVisible="{Binding HasError}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
            <StackPanel Spacing="4">
              <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource AppDangerTextBrush}" Text="调用日志加载失败" />
              <TextBlock Foreground="{DynamicResource AppDangerTextBrush}" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Classes="secondary-button" Command="{Binding RetryCommand}" Content="重试" IsEnabled="{Binding CanRetry}" Padding="12,7" />
          </Grid>
        </Border>

        <Grid ColumnDefinitions="1*,1*,1*,1*" ColumnSpacing="12" IsVisible="{Binding FiltersExpanded}">
          <Border Classes="content-card" Padding="14">
            <StackPanel Spacing="4">
              <TextBlock FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="总请求" />
              <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" Text="{Binding Summary.TotalRequests}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="content-card" Padding="14">
            <StackPanel Spacing="4">
              <TextBlock FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="成功率" />
              <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource AppSuccessTextBrush}" Text="{Binding Summary.SuccessRateText}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Classes="content-card" Padding="14">
            <StackPanel Spacing="4">
              <TextBlock FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="总 Tokens" />
              <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" Text="{Binding Summary.TotalTokensText}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="3" Classes="content-card" Padding="14">
            <StackPanel Spacing="4">
              <TextBlock FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="失败请求" />
              <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource AppDangerTextBrush}" Text="{Binding Summary.FailedRequests}" />
            </StackPanel>
          </Border>
        </Grid>

        <Border Classes="content-card" Padding="0">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel MinWidth="1260">
              <Border Background="{DynamicResource AppInputBackgroundBrush}" Padding="16,13">
                <Grid ColumnDefinitions="1.25*,0.85*,1.25*,1.2*,1.1*,1*,1.45*,0.8*,0.8*,0.8*,0.9*,Auto" ColumnSpacing="10">
                  <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="时间" />
                  <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="来源" />
                  <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="模型" />
                  <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="目标站点" />
                  <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="访问密钥" />
                  <TextBlock Grid.Column="5" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="状态" />
                  <TextBlock Grid.Column="6" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="用时/首字" />
                  <TextBlock Grid.Column="7" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="输入" />
                  <TextBlock Grid.Column="8" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="缓存" />
                  <TextBlock Grid.Column="9" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="输出" />
                  <TextBlock Grid.Column="10" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="总 Token" />
                  <TextBlock Grid.Column="11" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="操作" />
                </Grid>
              </Border>
              <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource AppTextTertiaryBrush}" IsVisible="{Binding HasNoItems}" Margin="0,30" Text="暂无调用日志" />
              <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="16,12">
                      <Grid ColumnDefinitions="1.25*,0.85*,1.25*,1.2*,1.1*,1*,1.45*,0.8*,0.8*,0.8*,0.9*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding RequestedAtText}" TextTrimming="CharacterEllipsis" />
                        <Border Grid.Column="1" VerticalAlignment="Center" Background="{DynamicResource AppPrimarySoftBrush}" CornerRadius="10" Padding="7,3" HorizontalAlignment="Left"><TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppInfoTextBrush}" Text="{Binding SourceLabel}" /></Border>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource AppTextPrimaryBrush}" Text="{Binding ModelText}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding SiteNameText}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding AccessKeyNameText}" TextTrimming="CharacterEllipsis" />
                        <Border Grid.Column="5" VerticalAlignment="Center" Background="{DynamicResource AppSuccessSoftBrush}" CornerRadius="10" Padding="7,3" HorizontalAlignment="Left" IsVisible="{Binding IsSuccessfulStatus}"><TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppSuccessTextBrush}" Text="{Binding StatusText}" /></Border>
                        <Border Grid.Column="5" VerticalAlignment="Center" Background="{DynamicResource AppDangerSoftBrush}" CornerRadius="10" Padding="7,3" HorizontalAlignment="Left" IsVisible="{Binding IsFailedStatus}"><TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppDangerTextBrush}" Text="{Binding StatusText}" /></Border>
                        <StackPanel Grid.Column="6" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
                          <Border Background="{DynamicResource AppSurfaceSoftBrush}" CornerRadius="9" Padding="6,3"><TextBlock VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource AppCodeForegroundBrush}" Text="{Binding DurationText}" /></Border>
                          <Border Background="{DynamicResource AppInfoSoftBrush}" CornerRadius="9" Padding="6,3"><TextBlock VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource AppInfoTextBrush}" Text="{Binding FirstTokenText}" /></Border>
                          <Border Background="{DynamicResource AppInputBackgroundBrush}" CornerRadius="9" Padding="6,3"><TextBlock VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding StreamingText}" /></Border>
                        </StackPanel>
                        <TextBlock Grid.Column="7" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding InputTokensText}" />
                        <TextBlock Grid.Column="8" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding CachedTokensText}" />
                        <TextBlock Grid.Column="9" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding OutputTokensText}" />
                        <TextBlock Grid.Column="10" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" Text="{Binding TotalTokensText}" />
                        <Button Grid.Column="11" VerticalAlignment="Center" Classes="secondary-button" Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="查看链路" Padding="9,6" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Border>

        <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
          <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding PaginationSummary}" Margin="0,0,16,8" />
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button Classes="secondary-button" Command="{Binding FirstPageCommand}" Content="首页" IsEnabled="{Binding CanFirst}" Padding="10,6" />
            <Button Classes="secondary-button" Command="{Binding PreviousPageCommand}" Content="上一页" IsEnabled="{Binding CanPrevious}" Padding="10,6" />
            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding PageText}" Margin="5,0" />
            <Button Classes="secondary-button" Command="{Binding NextPageCommand}" Content="下一页" IsEnabled="{Binding CanNext}" Padding="10,6" />
            <Button Classes="secondary-button" Command="{Binding LastPageCommand}" Content="末页" IsEnabled="{Binding CanLast}" Padding="10,6" />
            <TextBox Classes="form-input" VerticalContentAlignment="Center" Width="70" Text="{Binding PageJumpInput}" Watermark="页码" />
            <Button Classes="secondary-button" Command="{Binding JumpPageCommand}" Content="前往" Padding="10,6" />
          </StackPanel>
        </WrapPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- 详情作为右侧浮层，不参与日志表格的横向测量。 -->
    <Border
        Grid.Row="1"
        Classes="content-card"
        MaxWidth="420"
        MinWidth="300"
        Padding="20"
        HorizontalAlignment="Right"
        IsVisible="{Binding HasDetail}"
        ZIndex="10">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <StackPanel Spacing="3">
              <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" Text="请求链路详情" />
              <TextBlock FontSize="12" Foreground="{DynamicResource AppTextTertiaryBrush}" Text="查看本次请求的全部尝试记录" />
            </StackPanel>
            <Button Grid.Column="1" Classes="secondary-button" Command="{Binding CloseDetailCommand}" Content="关闭" Padding="10,6" />
          </Grid>
          <Border Background="{DynamicResource AppInputBackgroundBrush}" CornerRadius="8" Padding="12">
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="7">
              <TextBlock FontSize="12" Foreground="{DynamicResource AppTextTertiaryBrush}" Text="请求 ID" />
              <TextBlock Grid.Column="1" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding SelectedDetail.RequestIdText}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="1" FontSize="12" Foreground="{DynamicResource AppTextTertiaryBrush}" Text="请求模型" />
              <TextBlock Grid.Row="1" Grid.Column="1" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding SelectedDetail.RequestModelText}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="2" FontSize="12" Foreground="{DynamicResource AppTextTertiaryBrush}" Text="路由入口" />
              <TextBlock Grid.Row="2" Grid.Column="1" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding SelectedDetail.RouteEntryText}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="3" FontSize="12" Foreground="{DynamicResource AppTextTertiaryBrush}" Text="协议" />
              <TextBlock Grid.Row="3" Grid.Column="1" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding SelectedDetail.ProtocolTypeText}" />
              <TextBlock Grid.Row="4" FontSize="12" Foreground="{DynamicResource AppTextTertiaryBrush}" Text="调用方式" />
              <TextBlock Grid.Row="4" Grid.Column="1" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding SelectedDetail.ForwardingModeText}" />
              <TextBlock Grid.Row="5" FontSize="12" Foreground="{DynamicResource AppTextTertiaryBrush}" Text="访问密钥" />
              <TextBlock Grid.Row="5" Grid.Column="1" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding SelectedDetail.AccessKeyNameText}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="6" FontSize="12" Foreground="{DynamicResource AppTextTertiaryBrush}" Text="思考等级" />
              <TextBlock Grid.Row="6" Grid.Column="1" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding SelectedDetail.ReasoningEffortText}" />
            </Grid>
          </Border>
          <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" Text="尝试记录" />
          <ItemsControl ItemsSource="{Binding SelectedDetail.Attempts}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                  <StackPanel Spacing="7">
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                      <StackPanel Spacing="3">
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" Text="{Binding ModelText}" TextWrapping="Wrap" />
                        <TextBlock FontSize="11" Foreground="{DynamicResource AppTextTertiaryBrush}" Text="{Binding AttemptIndexText}" />
                      </StackPanel>
                      <Border Grid.Column="1" VerticalAlignment="Center" Background="{DynamicResource AppSuccessSoftBrush}" CornerRadius="10" Padding="7,3" IsVisible="{Binding IsSuccessfulStatus}"><TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppSuccessTextBrush}" Text="{Binding StatusText}" /></Border>
                      <Border Grid.Column="1" VerticalAlignment="Center" Background="{DynamicResource AppDangerSoftBrush}" CornerRadius="10" Padding="7,3" IsVisible="{Binding IsFailedStatus}"><TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppDangerTextBrush}" Text="{Binding StatusText}" /></Border>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="5">
                      <TextBlock FontSize="12" Foreground="{DynamicResource AppTextTertiaryBrush}" Text="目标站点" />
                      <TextBlock Grid.Column="1" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding SiteNameText}" TextWrapping="Wrap" />
                      <TextBlock Grid.Row="1" FontSize="12" Foreground="{DynamicResource AppTextTertiaryBrush}" Text="站点模型" />
                      <TextBlock Grid.Row="1" Grid.Column="1" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding SiteModelNameText}" TextWrapping="Wrap" />
                      <TextBlock Grid.Row="2" FontSize="12" Foreground="{DynamicResource AppTextTertiaryBrush}" Text="访问密钥" />
                      <TextBlock Grid.Row="2" Grid.Column="1" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding AccessKeyNameText}" TextWrapping="Wrap" />
                      <TextBlock Grid.Row="3" FontSize="12" Foreground="{DynamicResource AppTextTertiaryBrush}" Text="尝试时间" />
                      <TextBlock Grid.Row="3" Grid.Column="1" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding RequestedAtText}" />
                      <TextBlock Grid.Row="4" FontSize="12" Foreground="{DynamicResource AppTextTertiaryBrush}" Text="调用方式" />
                      <TextBlock Grid.Row="4" Grid.Column="1" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding ForwardingModeText}" />
                      <TextBlock Grid.Row="5" FontSize="12" Foreground="{DynamicResource AppTextTertiaryBrush}" Text="思考等级" />
                      <TextBlock Grid.Row="5" Grid.Column="1" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding ReasoningEffortText}" />
                      <TextBlock Grid.Row="6" FontSize="12" Foreground="{DynamicResource AppTextTertiaryBrush}" Text="耗时" />
                      <TextBlock Grid.Row="6" Grid.Column="1" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding DurationText}" />
                      <TextBlock Grid.Row="7" FontSize="12" Foreground="{DynamicResource AppTextTertiaryBrush}" Text="结果" />
                      <TextBlock Grid.Row="7" Grid.Column="1" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding ResultDetailsText}" />
                    </Grid>
                    <TextBlock FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding TokensText}" TextWrapping="Wrap" />
                    <TextBlock FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding StreamDetailsText}" TextWrapping="Wrap" />
                    <TextBlock FontSize="12" Foreground="{DynamicResource AppDangerTextBrush}" Text="{Binding ErrorText}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
