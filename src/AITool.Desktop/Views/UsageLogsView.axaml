<UserControl
    x:Class="AITool.Desktop.Views.UsageLogsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AITool.Desktop.ViewModels"
    x:DataType="vm:UsageLogsViewModel"
    x:CompileBindings="False">
  <Grid>
    <Grid RowDefinitions="Auto,Auto,*">
      <Border Classes="content-card" Padding="16" Margin="0,0,0,14"><Grid ColumnDefinitions="1.2*,1.2*,1*,1*,1.5*,Auto" ColumnSpacing="10"><ComboBox ItemsSource="{Binding Sites}" SelectedItem="{Binding SelectedSite}" PlaceholderText="全部站点"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox><ComboBox Grid.Column="1" ItemsSource="{Binding AccessKeys}" SelectedItem="{Binding SelectedAccessKey}" PlaceholderText="全部密钥"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBox Grid.Column="2" Classes="form-input" Text="{Binding Source}" Watermark="来源" /><TextBox Grid.Column="3" Classes="form-input" Text="{Binding Status}" Watermark="状态" /><TextBox Grid.Column="4" Classes="form-input" Text="{Binding ModelKeyword}" Watermark="模型关键字" /><Button Grid.Column="5" Classes="primary-button" Command="{Binding SearchCommand}" Content="查询" Padding="14,8" /></Grid></Border>
      <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="12" Margin="0,0,0,14"><Border Classes="content-card" Padding="14"><StackPanel Spacing="3"><TextBlock FontSize="12" Foreground="#64748B" Text="请求数" /><TextBlock FontSize="22" FontWeight="SemiBold" Foreground="#1E293B" Text="{Binding Summary.TotalRequests}" /></StackPanel></Border><Border Grid.Column="1" Classes="content-card" Padding="14"><StackPanel Spacing="3"><TextBlock FontSize="12" Foreground="#64748B" Text="失败数" /><TextBlock FontSize="22" FontWeight="SemiBold" Foreground="#B91C1C" Text="{Binding Summary.FailedRequests}" /></StackPanel></Border><Border Grid.Column="2" Classes="content-card" Padding="14"><StackPanel Spacing="3"><TextBlock FontSize="12" Foreground="#64748B" Text="成功率" /><TextBlock FontSize="22" FontWeight="SemiBold" Foreground="#166534" Text="{Binding Summary.SuccessRateText}" /></StackPanel></Border><Border Grid.Column="3" Classes="content-card" Padding="14"><StackPanel Spacing="3"><TextBlock FontSize="12" Foreground="#64748B" Text="Token 总数" /><TextBlock FontSize="22" FontWeight="SemiBold" Foreground="#1E293B" Text="{Binding Summary.TotalTokens}" /></StackPanel></Border></Grid>
      <Grid Grid.Row="2"><Border Classes="content-card" Padding="0"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><StackPanel MinWidth="980"><Border Background="#F8FAFC" Padding="18,14"><Grid ColumnDefinitions="1.5*,1.3*,1.2*,1*,1*,1*,Auto" ColumnSpacing="10"><TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Text="请求时间" /><TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Text="请求模型" /><TextBlock Grid.Column="2" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Text="站点" /><TextBlock Grid.Column="3" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Text="来源" /><TextBlock Grid.Column="4" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Text="状态" /><TextBlock Grid.Column="5" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Text="耗时" /><TextBlock Grid.Column="6" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Text="操作" /></Grid></Border><TextBlock HorizontalAlignment="Center" Foreground="#94A3B8" IsVisible="{Binding HasNoItems}" Text="暂无调用日志" Margin="0,30" /><ItemsControl ItemsSource="{Binding Items}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="18,13"><Grid ColumnDefinitions="1.5*,1.3*,1.2*,1*,1*,1*,Auto" ColumnSpacing="10"><TextBlock FontSize="12" Foreground="#64748B" Text="{Binding RequestedAt}" /><StackPanel Grid.Column="1" Spacing="2"><TextBlock Foreground="#1E293B" Text="{Binding RequestModel}" /><TextBlock FontSize="11" Foreground="#94A3B8" Text="{Binding AttemptedModel}" /></StackPanel><TextBlock Grid.Column="2" Foreground="#64748B" Text="{Binding SiteName}" /><TextBlock Grid.Column="3" Foreground="#64748B" Text="{Binding SourceText}" /><TextBlock Grid.Column="4" Foreground="#1E293B" Text="{Binding StatusText}" /><TextBlock Grid.Column="5" Foreground="#64748B" Text="{Binding DurationText}" /><Button Grid.Column="6" Classes="secondary-button" Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="详情" Padding="10,6" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></Border><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,12,0,0"><Button Classes="secondary-button" Command="{Binding PreviousPageCommand}" Content="上一页" IsEnabled="{Binding CanPrevious}" Padding="12,7" /><TextBlock VerticalAlignment="Center" Foreground="#64748B" Text="{Binding PageText}" /><Button Classes="secondary-button" Command="{Binding NextPageCommand}" Content="下一页" IsEnabled="{Binding CanNext}" Padding="12,7" /></StackPanel><Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="14" IsVisible="{Binding HasDetail}" Padding="22" Width="680" HorizontalAlignment="Center" VerticalAlignment="Center" ZIndex="10"><StackPanel Spacing="12"><Grid ColumnDefinitions="*,Auto"><TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#1E293B" Text="请求详情" /><Button Grid.Column="1" Classes="secondary-button" Command="{Binding CloseDetailCommand}" Content="关闭" Padding="10,6" /></Grid><TextBlock Foreground="#64748B" Text="{Binding SelectedDetail.RequestId}" /><TextBlock Foreground="#64748B" Text="{Binding SelectedDetail.RequestModel}" /><ItemsControl ItemsSource="{Binding SelectedDetail.Attempts}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#F8FAFC" CornerRadius="6" Padding="10"><Grid ColumnDefinitions="*,*,Auto"><TextBlock Foreground="#1E293B" Text="{Binding SiteName}" /><TextBlock Grid.Column="1" Foreground="#64748B" Text="{Binding AttemptedModel}" /><TextBlock Grid.Column="2" Foreground="#64748B" Text="{Binding StatusText}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></Grid>
    </Grid>
  </Grid>
</UserControl>
