<UserControl
    x:Class="AITool.Desktop.Views.SystemSettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AITool.Desktop.ViewModels"
    x:DataType="vm:SystemSettingsViewModel"
    x:CompileBindings="False">
  <Grid RowDefinitions="Auto,*" RowSpacing="24">
    <StackPanel Spacing="4">
      <TextBlock FontSize="22" FontWeight="Bold" Foreground="#1E293B" Text="系统设置" />
      <TextBlock Classes="page-subtitle" Text="配置检测、代理、日志和 Codex 功能参数" />
    </StackPanel>
    <ScrollViewer Grid.Row="1"><StackPanel Spacing="14">
      <Border Background="#E8F7EA" CornerRadius="8" Padding="12" IsVisible="{Binding HasMessage}"><TextBlock Foreground="#166534" Text="{Binding Message}" /></Border>
      <Border Background="#FEE2E2" CornerRadius="8" Padding="12" IsVisible="{Binding HasError}"><TextBlock Foreground="#B91C1C" Text="{Binding ErrorMessage}" TextWrapping="Wrap" /></Border>
      <Border Classes="content-card" Padding="18"><StackPanel Spacing="14"><TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#1E293B" Text="检测设置" /><Grid ColumnDefinitions="*,*,*" ColumnSpacing="14"><StackPanel Spacing="6"><TextBlock FontSize="12" Foreground="#64748B" Text="检测超时（秒）" /><NumericUpDown Classes="form-input" Minimum="1" Value="{Binding Settings.DetectionRequestTimeoutSeconds}" /></StackPanel><StackPanel Grid.Column="1" Spacing="6"><TextBlock FontSize="12" Foreground="#64748B" Text="检测重试次数" /><NumericUpDown Classes="form-input" Minimum="0" Value="{Binding Settings.DetectionRetryCount}" /></StackPanel><StackPanel Grid.Column="2" Spacing="6"><TextBlock FontSize="12" Foreground="#64748B" Text="检测并发数" /><NumericUpDown Classes="form-input" Minimum="1" Value="{Binding Settings.DetectionConcurrency}" /></StackPanel></Grid></StackPanel></Border>
      <Border Classes="content-card" Padding="18"><StackPanel Spacing="14"><TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#1E293B" Text="代理和熔断设置" /><Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="14"><StackPanel Spacing="6"><TextBlock FontSize="12" Foreground="#64748B" Text="代理超时（秒）" /><NumericUpDown Classes="form-input" Minimum="1" Value="{Binding Settings.ProxyRequestTimeoutSeconds}" /></StackPanel><StackPanel Grid.Column="1" Spacing="6"><TextBlock FontSize="12" Foreground="#64748B" Text="代理重试次数" /><NumericUpDown Classes="form-input" Minimum="0" Value="{Binding Settings.ProxyRetryCount}" /></StackPanel><StackPanel Grid.Column="2" Spacing="6"><TextBlock FontSize="12" Foreground="#64748B" Text="熔断失败阈值" /><NumericUpDown Classes="form-input" Minimum="1" Value="{Binding Settings.CircuitBreakerFailureThreshold}" /></StackPanel><StackPanel Grid.Column="3" Spacing="6"><TextBlock FontSize="12" Foreground="#64748B" Text="恢复时间（分钟）" /><NumericUpDown Classes="form-input" Minimum="1" Value="{Binding Settings.CircuitBreakerRecoveryMinutes}" /></StackPanel></Grid></StackPanel></Border>
      <Border Classes="content-card" Padding="18"><StackPanel Spacing="14"><TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#1E293B" Text="日志和功能开关" /><Grid ColumnDefinitions="*,*,*" ColumnSpacing="14"><StackPanel Spacing="6"><TextBlock FontSize="12" Foreground="#64748B" Text="日志保留天数" /><NumericUpDown Classes="form-input" Minimum="1" Value="{Binding Settings.UsageLogRetentionDays}" /></StackPanel><CheckBox Grid.Column="1" Content="启用日志自动清理" IsChecked="{Binding Settings.UsageLogAutoCleanupEnabled}" VerticalAlignment="Bottom" /><CheckBox Grid.Column="2" Content="启用开发者功能" IsChecked="{Binding Settings.DeveloperFeaturesEnabled}" VerticalAlignment="Bottom" /></Grid><Grid ColumnDefinitions="*,*,*" ColumnSpacing="14"><CheckBox Content="启用 Codex 功能" IsChecked="{Binding Settings.CodexFeaturesEnabled}" /><CheckBox Grid.Column="1" Content="启用 Codex 自动巡检" IsChecked="{Binding Settings.CodexInspectionEnabled}" /><StackPanel Grid.Column="2" Spacing="6"><TextBlock FontSize="12" Foreground="#64748B" Text="巡检周期（分钟）" /><NumericUpDown Classes="form-input" Minimum="5" Value="{Binding Settings.CodexInspectionIntervalMinutes}" /></StackPanel></Grid></StackPanel></Border>
      <StackPanel Orientation="Horizontal" Spacing="10"><Button Classes="primary-button" Command="{Binding SaveCommand}" Content="保存设置" IsEnabled="{Binding CanSave}" Padding="14,8" /></StackPanel>
      <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="8" Padding="18"><StackPanel Spacing="12"><TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#9A3412" Text="危险操作：清理调用日志" /><Grid ColumnDefinitions="*,*,*" ColumnSpacing="12"><TextBox Classes="form-input" Text="{Binding ClearSource}" Watermark="来源，可选" /><TextBox Grid.Column="1" Classes="form-input" Text="{Binding ClearStartTime}" Watermark="开始时间，可选" /><TextBox Grid.Column="2" Classes="form-input" Text="{Binding ClearEndTime}" Watermark="结束时间，可选" /></Grid><StackPanel Orientation="Horizontal" Spacing="10"><Button Classes="secondary-button" Command="{Binding ClearFilteredLogsCommand}" Content="清空筛选范围" Padding="12,8" /><Button Classes="secondary-button" Command="{Binding ClearAllLogsCommand}" Content="清空全部日志" Padding="12,8" /></StackPanel></StackPanel></Border>
    </StackPanel></ScrollViewer>
  </Grid>
</UserControl>
