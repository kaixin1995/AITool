<UserControl
    x:Class="AITool.Desktop.Views.ChatView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AITool.Desktop.ViewModels"
    x:DataType="vm:ChatViewModel"
    x:CompileBindings="False">
  <Grid RowDefinitions="Auto,*,Auto">
    <Grid ColumnDefinitions="2*,2*,Auto,Auto,Auto,Auto" ColumnSpacing="10" Margin="0,0,0,14"><StackPanel Spacing="5"><TextBlock FontSize="12" Foreground="#64748B" Text="站点 / 模型" /><TextBox Classes="form-input" Text="{Binding ModelSearchText}" Watermark="搜索站点或模型" /><ComboBox ItemsSource="{Binding FilteredTargets}" SelectedItem="{Binding SelectedTarget}" PlaceholderText="选择站点模型"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayText}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel><CheckBox Grid.Column="2" Content="启用流式" IsChecked="{Binding EnableStreaming}" VerticalAlignment="Bottom" /><CheckBox Grid.Column="3" Content="开启思考" IsChecked="{Binding EnableReasoning}" VerticalAlignment="Bottom" /><StackPanel Grid.Column="4" Spacing="5" IsVisible="{Binding EnableReasoning}"><TextBlock FontSize="12" Foreground="#64748B" Text="思考等级" /><ComboBox ItemsSource="{Binding ReasoningEffortOptions}" SelectedItem="{Binding ReasoningEffort}" /></StackPanel><StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom"><Button Classes="secondary-button" Command="{Binding RefreshCommand}" Content="重新加载候选" Padding="12,7" /><Button Classes="secondary-button" Command="{Binding ClearCommand}" Content="清空" Padding="12,7" /></StackPanel></Grid>
    <Border Grid.Row="1" Classes="content-card" Padding="18"><ScrollViewer x:Name="MessagesScrollViewer" VerticalScrollBarVisibility="Auto"><StackPanel Spacing="14"><TextBlock HorizontalAlignment="Center" Foreground="#94A3B8" IsVisible="{Binding HasNoMessages}" Text="选择站点模型后输入问题开始对话" Margin="0,30" /><ItemsControl ItemsSource="{Binding Messages}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#F8FAFC" CornerRadius="10" Padding="14"><StackPanel Spacing="8"><TextBlock FontSize="12" Foreground="#64748B" Text="{Binding RoleText}" /><TextBlock Foreground="#1E293B" Text="{Binding Content}" TextWrapping="Wrap" /><Border Background="#FFF7ED" CornerRadius="6" Padding="10" IsVisible="{Binding HasReasoning}"><TextBlock Foreground="#9A3412" Text="{Binding Reasoning}" TextWrapping="Wrap" /></Border><ItemsControl ItemsSource="{Binding Attempts}" IsVisible="{Binding HasAttempts}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10"><StackPanel Spacing="6"><Grid ColumnDefinitions="*,Auto"><TextBlock FontWeight="SemiBold" Foreground="#1E293B" Text="{Binding AttemptTitle}" /><Border Grid.Column="1" Background="#E8F7EA" CornerRadius="10" Padding="7,3" IsVisible="{Binding IsSuccess}"><TextBlock FontSize="11" Foreground="#166534" Text="{Binding StatusText}" /></Border><Border Grid.Column="1" Background="#FEE2E2" CornerRadius="10" Padding="7,3" IsVisible="{Binding HasError}"><TextBlock FontSize="11" Foreground="#B91C1C" Text="{Binding StatusText}" /></Border></Grid><TextBlock FontSize="12" Foreground="#64748B" Text="{Binding AttemptModelText}" TextTrimming="CharacterEllipsis" /><WrapPanel><TextBlock FontSize="11" Foreground="#64748B" Text="{Binding DurationText}" Margin="0,0,10,0" /><TextBlock FontSize="11" Foreground="#64748B" Text="{Binding FirstTokenText}" Margin="0,0,10,0" /><TextBlock FontSize="11" Foreground="#64748B" Text="{Binding StreamingText}" Margin="0,0,10,0" /><TextBlock FontSize="11" Foreground="#64748B" Text="{Binding TokenText}" /></WrapPanel><TextBlock FontSize="11" Foreground="#64748B" Text="{Binding ForwardingMode}" /><TextBlock FontSize="11" Foreground="#64748B" Text="{Binding UpstreamProtocolType}" /><TextBlock FontSize="12" Foreground="#B91C1C" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextWrapping="Wrap" /><TextBox Classes="code-box" AcceptsReturn="True" IsReadOnly="True" Height="90" Text="{Binding RequestBody}" IsVisible="{Binding HasRequestBody}" TextWrapping="Wrap" /><TextBox Classes="code-box response-box" AcceptsReturn="True" IsReadOnly="True" Height="90" Text="{Binding ResponseBody}" IsVisible="{Binding HasResponseBody}" TextWrapping="Wrap" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock FontSize="11" Foreground="#94A3B8" Text="{Binding TotalDurationText}" /><TextBlock FontSize="11" Foreground="#94A3B8" Text="{Binding CreatedAt}" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Border Background="#FEE2E2" CornerRadius="8" Padding="12" IsVisible="{Binding HasError}"><TextBlock Foreground="#B91C1C" Text="{Binding ErrorMessage}" TextWrapping="Wrap" /></Border></StackPanel></ScrollViewer></Border>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,14,0,0"><TextBox Classes="form-input" Text="{Binding Input}" Watermark="输入消息，按发送提交" AcceptsReturn="True" MinHeight="70" TextWrapping="Wrap" /><StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Bottom"><Button Classes="primary-button" Command="{Binding SendCommand}" Content="发送" IsEnabled="{Binding CanSend}" Padding="16,9" /><Button Classes="secondary-button" Command="{Binding StopCommand}" Content="停止" IsEnabled="{Binding IsSending}" Padding="16,9" /></StackPanel></Grid>
  </Grid>
</UserControl>
