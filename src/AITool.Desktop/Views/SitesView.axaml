<UserControl
    x:Class="AITool.Desktop.Views.SitesView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AITool.Desktop.ViewModels"
    x:DataType="vm:SitesViewModel"
    x:CompileBindings="False">
  <Grid>
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="16">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock Classes="page-title" Text="站点管理" />
          <TextBlock Classes="page-subtitle" Text="管理上游服务地址、协议、模型目录和启用状态" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Classes="secondary-button" Command="{Binding FetchAllModelsCommand}" Content="一键拉取全部" IsEnabled="{Binding CanFetchModels}" Padding="12,7" />
          <Button Classes="secondary-button" Click="ExportSites" Content="导出 JSON" Padding="12,7" />
          <Button Classes="secondary-button" Click="ImportSites" Content="导入 JSON" Padding="12,7" />
          <Button Classes="primary-button" Command="{Binding OpenCreateCommand}" Content="新增站点" Padding="14,8" />
        </StackPanel>
      </Grid>

      <StackPanel Grid.Row="1" Spacing="8">
        <Border Background="{DynamicResource AppDangerSoftBrush}" CornerRadius="8" Padding="14" IsVisible="{Binding HasError}">
          <TextBlock Foreground="{DynamicResource AppDangerTextBrush}" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
        </Border>
        <Border Background="{DynamicResource AppResponseBackgroundBrush}" CornerRadius="8" Padding="14" IsVisible="{Binding HasOperationError}">
          <TextBlock Foreground="{DynamicResource AppWarningTextBrush}" Text="{Binding OperationErrorMessage}" TextWrapping="Wrap" />
        </Border>
        <Border Background="{DynamicResource AppSuccessSoftBrush}" CornerRadius="8" Padding="14" IsVisible="{Binding HasOperationMessage}">
          <TextBlock Foreground="{DynamicResource AppSuccessTextBrush}" Text="{Binding OperationMessage}" TextWrapping="Wrap" />
        </Border>
        <Border Background="{DynamicResource AppResponseBackgroundBrush}" CornerRadius="8" Padding="14" IsVisible="{Binding HasEditorError}">
          <TextBlock Foreground="{DynamicResource AppWarningTextBrush}" Text="{Binding EditorErrorMessage}" TextWrapping="Wrap" />
        </Border>
      </StackPanel>

      <Grid Grid.Row="2">
        <TextBlock HorizontalAlignment="Center" Margin="0,35,0,0" Foreground="{DynamicResource AppTextSecondaryBrush}" IsVisible="{Binding IsLoading}" Text="正在加载站点..." />

        <Border Classes="content-card" IsVisible="{Binding IsListVisible}" Padding="0">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel MinWidth="1180">
              <Border Background="{DynamicResource AppInputBackgroundBrush}" Padding="18,12">
                <Grid ColumnDefinitions="Auto,2*,2.5*,1.25*,1.15*,1.35*,1.2*,Auto" ColumnSpacing="10">
                  <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="选择" />
                  <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="站点名称" />
                  <TextBlock Grid.Column="2" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="服务地址" />
                  <TextBlock Grid.Column="3" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="协议能力" />
                  <TextBlock Grid.Column="4" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="状态" />
                  <TextBlock Grid.Column="5" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="创建时间" />
                  <TextBlock Grid.Column="6" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="路径模式" />
                  <TextBlock Grid.Column="7" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="操作" />
                </Grid>
              </Border>
              <Border Background="{DynamicResource AppCardBackgroundBrush}" Padding="18,10" IsVisible="{Binding HasSites}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="已选择：" />
                  <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource AppCodeForegroundBrush}" Text="{Binding SelectedSiteCount}" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Classes="secondary-button" Command="{Binding SelectAllSitesCommand}" Content="全选" Padding="10,5" />
                    <Button Classes="secondary-button" Command="{Binding ClearSiteSelectionCommand}" Content="清空选择" Padding="10,5" />
                    <Button Classes="secondary-button" Click="ConfirmBulkDeleteSites" Content="批量删除" IsEnabled="{Binding CanBulkDelete}" Padding="10,5" />
                  </StackPanel>
                </Grid>
              </Border>
              <ItemsControl ItemsSource="{Binding PagedSites}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="18,12">
                      <Grid ColumnDefinitions="Auto,2*,2.5*,1.25*,1.15*,1.35*,1.2*,Auto" ColumnSpacing="10">
                        <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                        <StackPanel Grid.Column="1" Spacing="3">
                          <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" Text="{Binding Name}" />
                          <TextBlock FontSize="12" Foreground="{DynamicResource AppTextTertiaryBrush}" Text="{Binding ApiKeyMasked}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Foreground="{DynamicResource AppCodeForegroundBrush}" Text="{Binding BaseUrl}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                          <Border Background="{DynamicResource AppSuccessSoftBrush}" CornerRadius="10" Padding="6,3" IsVisible="{Binding SupportsOpenAi}">
                            <TextBlock FontSize="11" Foreground="{DynamicResource AppSuccessTextBrush}" Text="OpenAI" />
                          </Border>
                          <Border Background="{DynamicResource AppInfoSoftBrush}" CornerRadius="10" Padding="6,3" IsVisible="{Binding SupportsAnthropic}">
                            <TextBlock FontSize="11" Foreground="{DynamicResource AppInfoTextBrush}" Text="Anthropic" />
                          </Border>
                          <Border Background="{DynamicResource AppWarningSoftBrush}" CornerRadius="10" Padding="6,3" IsVisible="{Binding SupportsResponses}">
                            <TextBlock FontSize="11" Foreground="{DynamicResource AppWarningTextBrush}" Text="Responses" />
                          </Border>
                        </StackPanel>
                        <Grid Grid.Column="4" HorizontalAlignment="Left" VerticalAlignment="Center">
                          <Border Background="{DynamicResource AppSuccessSoftBrush}" CornerRadius="12" Padding="9,4" IsVisible="{Binding IsEnabled}">
                            <TextBlock Foreground="{DynamicResource AppSuccessTextBrush}" Text="{Binding StatusText}" />
                          </Border>
                          <Border Background="{DynamicResource AppSurfaceSoftBrush}" CornerRadius="12" Padding="9,4" IsVisible="{Binding IsDisabled}">
                            <TextBlock Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding StatusText}" />
                          </Border>
                        </Grid>
                        <TextBlock Grid.Column="5" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding CreatedAtText}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="6" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding EndpointPathMode}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <Button Classes="secondary-button" Command="{Binding DataContext.FetchModelsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="拉取" IsEnabled="{Binding DataContext.CanFetchModels, RelativeSource={RelativeSource AncestorType=UserControl}}" Padding="9,5" />
                          <Button Classes="secondary-button" Command="{Binding DataContext.OpenEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="编辑" Padding="9,5" />
                          <Button Classes="secondary-button" Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="{Binding ToggleActionText}" Padding="9,5" />
                          <Button Classes="secondary-button" Click="ConfirmDeleteSite" Content="删除" Padding="9,5" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Background="{DynamicResource AppCardBackgroundBrush}" Padding="18,12" IsVisible="{Binding HasSites}">
                <Grid ColumnDefinitions="*,Auto,*">
                  <Button Classes="secondary-button" Command="{Binding PreviousPageCommand}" Content="上一页" IsEnabled="{Binding CanPreviousPage}" HorizontalAlignment="Left" Padding="10,6" />
                  <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding PageText}" />
                  <Button Grid.Column="2" Classes="secondary-button" Command="{Binding NextPageCommand}" Content="下一页" IsEnabled="{Binding CanNextPage}" HorizontalAlignment="Right" Padding="10,6" />
                </Grid>
              </Border>
              <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource AppTextTertiaryBrush}" IsVisible="{Binding NoSites}" Margin="20" Text="暂无站点" />
            </StackPanel>
          </ScrollViewer>
        </Border>

        <Border Background="{DynamicResource AppCardBackgroundBrush}" BorderBrush="{DynamicResource AppBorderStrongBrush}" BorderThickness="1" CornerRadius="14" IsVisible="{Binding IsEditorOpen}" Padding="24" Width="540" HorizontalAlignment="Center" VerticalAlignment="Center" ZIndex="10">
          <ScrollViewer MaxHeight="680">
            <StackPanel Spacing="14">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" Text="{Binding EditorTitle}" />
                <Button Grid.Column="1" Classes="secondary-button" Command="{Binding CloseEditorCommand}" Content="关闭" Padding="10,6" />
              </Grid>
              <TextBlock Foreground="{DynamicResource AppTextSecondaryBrush}" IsVisible="{Binding IsEditorLoading}" Text="正在加载站点详情..." />
              <StackPanel Spacing="6"><TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppCodeForegroundBrush}" Text="名称" /><TextBox Classes="form-input" Text="{Binding Form.Name, Mode=TwoWay}" /></StackPanel>
              <StackPanel Spacing="6"><TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppCodeForegroundBrush}" Text="服务地址" /><TextBox Classes="form-input" Text="{Binding Form.BaseUrl, Mode=TwoWay}" Watermark="https://api.example.com" /></StackPanel>
              <StackPanel Spacing="6"><TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppCodeForegroundBrush}" Text="API 密钥" /><TextBox Classes="form-input" PasswordChar="●" Text="{Binding Form.ApiKey, Mode=TwoWay}" Watermark="编辑时留空表示保留原密钥" /></StackPanel>
              <StackPanel Spacing="6">
                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppCodeForegroundBrush}" Text="路径模式" />
                <ComboBox ItemsSource="{Binding EndpointPathModeOptions}" SelectedValue="{Binding Form.EndpointPathMode, Mode=TwoWay}" SelectedValueBinding="{Binding Value}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="18">
                <CheckBox Content="支持 OpenAI" IsChecked="{Binding Form.SupportsOpenAi, Mode=TwoWay}" />
                <CheckBox Content="支持 Anthropic" IsChecked="{Binding Form.SupportsAnthropic, Mode=TwoWay}" />
                <CheckBox Content="启用" IsChecked="{Binding Form.IsEnabled, Mode=TwoWay}" />
              </StackPanel>
              <TextBlock Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="12" Text="两个协议均未勾选时，后端按仅支持 Responses 处理。" TextWrapping="Wrap" />
              <Button Classes="primary-button" Command="{Binding SaveCommand}" Content="保存站点" IsEnabled="{Binding CanSave}" HorizontalContentAlignment="Center" Padding="12,9" />
            </StackPanel>
          </ScrollViewer>
        </Border>

        <Border Background="{DynamicResource AppCardBackgroundBrush}" BorderBrush="{DynamicResource AppBorderStrongBrush}" BorderThickness="1" CornerRadius="14" IsVisible="{Binding IsImportPreviewOpen}" Padding="24" Margin="12" MaxWidth="980" MaxHeight="780" HorizontalAlignment="Stretch" VerticalAlignment="Center" ZIndex="21">
          <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="3">
                <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" Text="导入站点" />
                <TextBlock FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="先解析并选择需要导入的站点，确认后才会写入服务端。" />
              </StackPanel>
              <Button Grid.Column="1" Classes="secondary-button" Click="CloseImportPreview" Content="关闭" Padding="10,6" />
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <TextBox Classes="form-input" AcceptsReturn="True" MinHeight="110" Text="{Binding ImportJsonText, Mode=TwoWay}" TextWrapping="Wrap" Watermark="粘贴站点导出 JSON" />
              <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Bottom">
                <Button Classes="secondary-button" Click="ParseImportPreview" Content="解析预览" Padding="12,7" />
                <Button Classes="secondary-button" Click="ImportSites" Content="选择文件" Padding="12,7" />
              </StackPanel>
            </Grid>
            <Border Grid.Row="2" Background="{DynamicResource AppInputBackgroundBrush}" CornerRadius="8" Padding="10">
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel MinWidth="780" Spacing="6">
                  <Border Background="{DynamicResource AppCardBackgroundBrush}" Padding="8,10"><Grid ColumnDefinitions="Auto,2*,2.5*,1.2*,1.1*,1.2*" ColumnSpacing="10">
                    <CheckBox IsChecked="{Binding AllImportItemsSelected, Mode=TwoWay}" />
                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="站点名称" />
                    <TextBlock Grid.Column="2" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="服务地址" />
                    <TextBlock Grid.Column="3" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="协议" />
                    <TextBlock Grid.Column="4" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="密钥" />
                    <TextBlock Grid.Column="5" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="状态" />
                  </Grid></Border>
                  <ItemsControl ItemsSource="{Binding ImportPreviewItems}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="Auto,2*,2.5*,1.2*,1.1*,1.2*" ColumnSpacing="10">
                          <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource AppTextPrimaryBrush}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{DynamicResource AppCodeForegroundBrush}" Text="{Binding BaseUrl}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding ProtocolType}" />
                          <TextBlock Grid.Column="4" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding ApiKeyMasked}" />
                          <Border Grid.Column="5" Background="{DynamicResource AppSuccessSoftBrush}" CornerRadius="10" Padding="7,3" HorizontalAlignment="Left" IsVisible="{Binding IsSelected}">
                            <TextBlock FontSize="11" Foreground="{DynamicResource AppSuccessTextBrush}" Text="待导入" />
                          </Border>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource AppTextTertiaryBrush}" IsVisible="{Binding HasNoImportPreviewItems}" Margin="20" Text="暂无解析结果" />
                </StackPanel>
              </ScrollViewer>
            </Border>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
              <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding SelectedImportCount, StringFormat='已选 {0} 条'}" />
              <Button Classes="secondary-button" Command="{Binding SelectAllImportCommand}" Content="全选" Padding="12,7" />
              <Button Classes="secondary-button" Command="{Binding ClearImportSelectionCommand}" Content="清空选择" Padding="12,7" />
              <Button Classes="secondary-button" Click="CloseImportPreview" Content="取消" Padding="12,7" />
              <Button Classes="primary-button" Command="{Binding ImportSelectedSitesCommand}" Content="确认导入" IsEnabled="{Binding CanConfirmImport}" Padding="12,7" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Background="{DynamicResource AppCardBackgroundBrush}" BorderBrush="{DynamicResource AppBorderStrongBrush}" BorderThickness="1" CornerRadius="14" IsVisible="{Binding IsExportPreviewOpen}" Padding="24" Margin="12" MaxWidth="980" MaxHeight="780" HorizontalAlignment="Stretch" VerticalAlignment="Center" ZIndex="22">
          <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="3">
                <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" Text="导出站点" />
                <TextBlock FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="选择需要导出的站点，预览内容包含 API 密钥，请妥善保管导出文件。" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" Classes="secondary-button" Click="CloseExportPreview" Content="关闭" Padding="10,6" />
            </Grid>
            <ProgressBar Grid.Row="1" Height="5" IsIndeterminate="True" IsVisible="{Binding IsExportLoading}" />
            <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="10">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="secondary-button" Command="{Binding SelectAllExportCommand}" Content="全选" Padding="10,6" />
                <Button Classes="secondary-button" Command="{Binding ClearExportSelectionCommand}" Content="清空选择" Padding="10,6" />
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding SelectedExportCount, StringFormat='已选 {0} 个'}" />
              </StackPanel>
              <TextBox Grid.Row="1" Classes="form-input" AcceptsReturn="True" IsReadOnly="True" MinHeight="260" Text="{Binding ExportPreviewJson}" TextWrapping="Wrap" VerticalContentAlignment="Top" />
            </Grid>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
              <Button Classes="secondary-button" Click="CopyExportSites" Content="复制 JSON" IsEnabled="{Binding CanExportPreview}" Padding="12,7" />
              <Button Classes="primary-button" Click="DownloadExportSites" Content="下载文件" IsEnabled="{Binding CanExportPreview}" Padding="12,7" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Background="{DynamicResource AppCardBackgroundBrush}" BorderBrush="{DynamicResource AppBorderStrongBrush}" BorderThickness="1" CornerRadius="14" IsVisible="{Binding CatalogVisible}" Padding="24" Margin="12" HorizontalAlignment="Stretch" VerticalAlignment="Center" MaxWidth="920" MaxHeight="760" ZIndex="20">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="14" MinWidth="0">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" Text="模型目录" />
              <Button Grid.Column="1" Classes="secondary-button" Command="{Binding CloseCatalogCommand}" Content="关闭" Padding="10,6" />
            </Grid>
            <Border Grid.Row="1" Background="{DynamicResource AppResponseBackgroundBrush}" CornerRadius="6" Padding="10" IsVisible="{Binding HasCatalogError}">
              <TextBlock Foreground="{DynamicResource AppWarningTextBrush}" Text="{Binding CatalogErrorMessage}" TextWrapping="Wrap" />
            </Border>
            <StackPanel Grid.Row="2" Spacing="6" IsVisible="{Binding HasCatalogProgress}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding CatalogProgressText}" />
                <TextBlock Grid.Column="1" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding CatalogProgressPercent, StringFormat={}{0}%}" />
              </Grid>
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding CatalogProgressPercent}" Height="8" />
            </StackPanel>
            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBox Classes="form-input" Text="{Binding CatalogSearch, Mode=TwoWay}" Watermark="搜索站点或模型" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Classes="secondary-button" Command="{Binding SelectAllCatalogCommand}" Content="全选" Padding="10,6" />
                <Button Classes="secondary-button" Command="{Binding ClearCatalogSelectionCommand}" Content="清空" Padding="10,6" />
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding SelectedCatalogCount, StringFormat='已选 {0}'}" />
              </StackPanel>
            </Grid>
            <ScrollViewer Grid.Row="4" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="10" MinWidth="0">
                <ItemsControl ItemsSource="{Binding FilteredCatalogSites}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource AppInputBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel Spacing="10">
                          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" Text="{Binding SiteName}" />
                            <Border Grid.Column="1" Background="{DynamicResource AppBorderBrush}" CornerRadius="10" Padding="7,3">
                              <TextBlock FontSize="11" Foreground="{DynamicResource AppCodeForegroundBrush}" Text="{Binding StatusText}" />
                            </Border>
                            <TextBlock Grid.Column="2" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding Models.Count, StringFormat={}{0} 个模型}" VerticalAlignment="Center" />
                          </Grid>
                          <Border Background="{DynamicResource AppDangerSoftBrush}" CornerRadius="6" Padding="10" IsVisible="{Binding HasError}">
                            <TextBlock Foreground="{DynamicResource AppDangerTextBrush}" Text="{Binding Error}" TextWrapping="Wrap" />
                          </Border>
                          <ItemsControl ItemsSource="{Binding Models}" IsVisible="{Binding HasModels}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Grid ColumnDefinitions="Auto,2*,2* ,Auto" ColumnSpacing="8" Margin="0,3">
                                  <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                  <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource AppCodeForegroundBrush}" Text="{Binding RemoteModelName}" TextTrimming="CharacterEllipsis" />
                                  <TextBox Grid.Column="2" Classes="form-input" MinHeight="34" Padding="8,5" Text="{Binding DisplayName, Mode=TwoWay}" Watermark="显示名称 / 别名" />
                                  <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="12" Text="{Binding ExistingStatusText}" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource AppTextTertiaryBrush}" IsVisible="{Binding NoCatalogSites}" Margin="20" Text="暂无可导入模型" />
              </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
              <Button Classes="secondary-button" Command="{Binding CloseCatalogCommand}" Content="取消" Padding="12,7" />
              <Button Classes="primary-button" Command="{Binding ImportSelectedModelsCommand}" Content="导入选中" IsEnabled="{Binding CanImportCatalog}" Padding="12,7" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
