<UserControl
    x:Class="AITool.Desktop.Views.RoutesView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AITool.Desktop.ViewModels"
    x:DataType="vm:RoutesViewModel"
    x:CompileBindings="False">
  <Grid RowDefinitions="Auto,Auto" RowSpacing="24" ColumnDefinitions="260,*" ColumnSpacing="18" VerticalAlignment="Top">
      <StackPanel Grid.ColumnSpan="2" Spacing="4">
        <TextBlock FontSize="22" FontWeight="Bold" Foreground="#1E293B" Text="路由规则管理" />
        <TextBlock Classes="page-subtitle" Text="主入口绑定有序候选实例队列，请求时按顺序失败切换、成功即停止" TextWrapping="Wrap" />
      </StackPanel>

      <Border Grid.Row="1" Classes="content-card" Padding="14">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,14,0,0">
            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Text="新增路由入口" />
            <TextBox Classes="form-input" Text="{Binding NewEntryName}" Watermark="例如 claude-3-7-sonnet" />
            <Button Classes="primary-button" Command="{Binding CreateEntryCommand}" Content="创建入口" IsEnabled="{Binding CanCreate}" HorizontalContentAlignment="Center" Padding="10,8" />
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Entries}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ToggleButton
                      Classes="nav-item"
                      Command="{Binding DataContext.SelectEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding}"
                      IsChecked="{Binding IsSelected, Mode=TwoWay}">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Foreground="#1E293B" Text="{Binding EntryName}" TextTrimming="CharacterEllipsis" />
                      <Border Grid.Column="1" Background="#EEF4FF" CornerRadius="10" Padding="7,3"><TextBlock FontSize="11" Foreground="#5B8DEF" Text="{Binding CandidateCount}" /></Border>
                    </Grid>
                  </ToggleButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Border Grid.Row="1" Grid.Column="1" Classes="content-card" Padding="0">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border Background="#F8FAFC" Padding="18,14">
              <Grid ColumnDefinitions="2*,1.5*,1.3*,1*,Auto">
                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Text="站点" />
                <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Text="上游模型" />
                <TextBlock Grid.Column="2" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Text="可用性" />
                <TextBlock Grid.Column="3" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Text="状态" />
                <TextBlock Grid.Column="4" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Text="操作" />
              </Grid>
            </Border>
            <TextBlock HorizontalAlignment="Center" Foreground="#94A3B8" IsVisible="{Binding HasNoSelectedEntry}" Margin="25" Text="请先选择一个路由入口" />
            <ItemsControl ItemsSource="{Binding Rules}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="18,14">
                    <Grid ColumnDefinitions="2*,1.5*,1.3*,1*,Auto" ColumnSpacing="12">
                      <StackPanel Spacing="3"><TextBlock FontWeight="SemiBold" Foreground="#1E293B" Text="{Binding SiteName}" /><TextBlock FontSize="12" Foreground="#94A3B8" Text="{Binding SiteModelName}" /></StackPanel>
                      <TextBlock Grid.Column="1" Foreground="#475569" Text="{Binding UpstreamModelName}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Foreground="#64748B" Text="{Binding AvailabilityMode}" VerticalAlignment="Center" />
                      <Border Grid.Column="3" Background="#E8F7EA" CornerRadius="12" Padding="9,4" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Foreground="#166534" Text="{Binding StatusText}" /></Border>
                      <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"><Button Classes="secondary-button" Command="{Binding DataContext.ToggleRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="{Binding ToggleActionText}" Padding="10,6" /><Button Classes="secondary-button" Command="{Binding DataContext.DeleteRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="删除" Padding="10,6" /></StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
</UserControl>
