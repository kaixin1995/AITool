<UserControl
    x:Class="AITool.Desktop.Views.CodexView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AITool.Desktop.ViewModels"
    x:DataType="vm:CodexViewModel"
    x:CompileBindings="False">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="16">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="4">
          <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#1E293B" Text="Codex 账号" />
          <TextBlock Classes="page-subtitle" Text="管理 OAuth 账号、额度窗口和代理凭证" />
        </StackPanel>
        <Button
            Grid.Column="1"
            Classes="primary-button"
            Command="{Binding StartOAuthCommand}"
            Content="添加 OAuth 账号"
            Padding="14,8" />
      </Grid>

      <Border Background="#E8F7EA" CornerRadius="8" Padding="12" IsVisible="{Binding HasMessage}">
        <TextBlock Foreground="#166534" Text="{Binding Message}" TextWrapping="Wrap" />
      </Border>
      <Border Background="#FEE2E2" CornerRadius="8" Padding="12" IsVisible="{Binding HasError}">
        <TextBlock Foreground="#B91C1C" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
      </Border>

      <Border Classes="content-card" Background="#EFF6FF" Padding="16" IsVisible="{Binding HasOAuthSession}">
        <StackPanel Spacing="9">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock FontWeight="SemiBold" Foreground="#315EA8" Text="OAuth 授权" />
            <TextBlock Grid.Column="1" FontSize="12" Foreground="#64748B" Text="完成授权后粘贴回调地址" />
          </Grid>
          <TextBox Classes="form-input" IsReadOnly="True" Text="{Binding OAuthUrl}" Watermark="授权地址" />
          <Grid ColumnDefinitions="1.5*,1*,Auto" ColumnSpacing="10">
            <TextBox Classes="form-input" Text="{Binding OAuthCallbackUrl}" Watermark="回调 URL" />
            <TextBox Grid.Column="1" Classes="form-input" Text="{Binding OAuthDisplayName}" Watermark="账号名称（可选）" />
            <Button Grid.Column="2" Classes="primary-button" Command="{Binding CompleteOAuthCommand}" Content="完成登录" IsEnabled="{Binding CanCompleteOAuth}" Padding="14,8" />
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock HorizontalAlignment="Center" Foreground="#94A3B8" IsVisible="{Binding HasNoAccounts}" Margin="0,35" Text="暂无 Codex 账号，请先添加 OAuth 账号" />

      <ItemsControl ItemsSource="{Binding Accounts}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" ItemWidth="360" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="content-card" Width="344" Margin="0,0,16,16" Padding="20">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <StackPanel Spacing="4">
                    <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#1E293B" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                    <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding Email}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="5" HorizontalAlignment="Right">
                    <Border Background="#E8F7EA" CornerRadius="12" Padding="8,4">
                      <TextBlock FontSize="11" Foreground="#166534" Text="{Binding StatusText}" />
                    </Border>
                    <TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="#64748B" Text="{Binding PlanType}" />
                  </StackPanel>
                </Grid>

                <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                  <StackPanel Spacing="3">
                    <ItemsControl ItemsSource="{Binding Windows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="92,*,52" RowSpacing="5" Margin="0,0,0,12">
                            <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding Label}" VerticalAlignment="Center" />
                            <ProgressBar Grid.Column="1" Maximum="100" Value="{Binding UsedPercentValue}" Height="7" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontSize="12" Foreground="#475569" Text="{Binding UsedPercentText}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" FontSize="11" Foreground="#94A3B8" Text="{Binding ResetText}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock FontSize="12" Foreground="#64748B" IsVisible="{Binding HasNoWindows}" Text="暂无额度数据" />
                  </StackPanel>
                </Border>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <StackPanel Spacing="3">
                    <TextBlock FontSize="11" Foreground="#94A3B8" Text="最近刷新" />
                    <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding LastQuotaCheckedAt}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Foreground="#64748B" Text="{Binding QuotaText}" />
                </Grid>

                <WrapPanel Orientation="Horizontal" ItemWidth="0" HorizontalAlignment="Right">
                  <Button Classes="secondary-button" Command="{Binding DataContext.RefreshQuotaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="刷新额度" Padding="9,6" Margin="0,0,6,0" />
                  <Button Classes="secondary-button" Command="{Binding DataContext.RefreshTokenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="刷新凭证" Padding="9,6" Margin="0,0,6,0" />
                  <Button Classes="secondary-button" Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="{Binding ToggleActionText}" Padding="9,6" Margin="0,0,6,0" />
                  <Button Classes="secondary-button" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="删除" Padding="9,6" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
