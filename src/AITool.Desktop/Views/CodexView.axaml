<UserControl
    x:Class="AITool.Desktop.Views.CodexView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AITool.Desktop.ViewModels"
    x:DataType="vm:CodexViewModel"
    x:CompileBindings="False">
  <Grid RowDefinitions="Auto,*"><Grid ColumnDefinitions="*,Auto" Margin="0,0,0,18"><StackPanel Spacing="4"><TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#1E293B" Text="Codex OAuth 管理" /><TextBlock Classes="page-subtitle" Text="通过 OAuth 管理 Codex 账号和额度" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"><Button Classes="secondary-button" Command="{Binding RefreshCommand}" Content="刷新" Padding="14,8" /><Button Classes="primary-button" Command="{Binding StartOAuthCommand}" Content="开始 OAuth" Padding="14,8" /></StackPanel></Grid><Grid Grid.Row="1"><StackPanel Spacing="14"><Border Background="#E8F7EA" CornerRadius="8" Padding="12" IsVisible="{Binding HasMessage}"><TextBlock Foreground="#166534" Text="{Binding Message}" TextWrapping="Wrap" /></Border><Border Background="#FEE2E2" CornerRadius="8" Padding="12" IsVisible="{Binding HasError}"><TextBlock Foreground="#B91C1C" Text="{Binding ErrorMessage}" TextWrapping="Wrap" /></Border><Border Background="#EFF6FF" CornerRadius="8" Padding="16" IsVisible="{Binding HasMessage}"><StackPanel Spacing="8"><TextBlock Foreground="#315EA8" Text="授权地址" /><TextBox Classes="form-input" IsReadOnly="True" Text="{Binding OAuthUrl}" /><TextBlock FontSize="12" Foreground="#64748B" Text="完成浏览器授权后粘贴回调 URL" /><TextBox Classes="form-input" Text="{Binding OAuthCallbackUrl}" Watermark="回调 URL" /><TextBox Classes="form-input" Text="{Binding OAuthDisplayName}" Watermark="账号显示名称，可选" /><Button Classes="primary-button" Command="{Binding CompleteOAuthCommand}" Content="完成 OAuth 登录" IsEnabled="{Binding CanCompleteOAuth}" Padding="12,8" /></StackPanel></Border><TextBlock HorizontalAlignment="Center" Foreground="#94A3B8" IsVisible="{Binding HasNoAccounts}" Text="暂无 Codex 账号" Margin="0,30" /><ItemsControl ItemsSource="{Binding Accounts}"><ItemsControl.ItemTemplate><DataTemplate><Border Classes="content-card" Margin="0,0,0,12" Padding="18"><Grid ColumnDefinitions="2*,1.3*,1.3*,Auto" ColumnSpacing="14"><StackPanel Spacing="4"><TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#1E293B" Text="{Binding DisplayName}" /><TextBlock FontSize="12" Foreground="#64748B" Text="{Binding Email}" /><TextBlock FontSize="12" Foreground="#94A3B8" Text="{Binding PlanType}" /></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock Foreground="#64748B" Text="{Binding QuotaText}" /><TextBlock FontSize="12" Foreground="#94A3B8" Text="{Binding LastQuotaCheckedAt}" /></StackPanel><Border Grid.Column="2" Background="#E8F7EA" CornerRadius="12" Padding="9,4" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Foreground="#166534" Text="{Binding StatusText}" /></Border><StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"><Button Classes="secondary-button" Command="{Binding DataContext.RefreshQuotaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="刷新额度" Padding="10,6" /><Button Classes="secondary-button" Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="切换" Padding="10,6" /><Button Classes="secondary-button" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="删除" Padding="10,6" /></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Grid></Grid>
</UserControl>
