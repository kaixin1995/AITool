<UserControl
    x:Class="AITool.Desktop.Views.MainShellView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AITool.Desktop.ViewModels"
    x:DataType="vm:MainShellViewModel"
    x:CompileBindings="False">
  <Grid Background="#F8FAFC" ColumnDefinitions="260,*">
    <!-- 左侧导航，结构和 Vue3 MainLayout 保持一致。 -->
    <Border
        Background="#FFFFFF"
        BorderBrush="#E2E8F0"
        BorderThickness="0,0,1,0">
      <DockPanel>
        <Border
            DockPanel.Dock="Top"
            BorderBrush="#E2E8F0"
            BorderThickness="0,0,0,1"
            Padding="18,16">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Border
                Width="38"
                Height="38"
                Background="#6C9EFF"
                CornerRadius="10">
              <TextBlock
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  FontSize="15"
                  FontWeight="Bold"
                  Foreground="White"
                  Text="AI" />
            </Border>
            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="2">
              <TextBlock FontSize="16" FontWeight="Bold" Foreground="#1E293B" Text="AI Tool" />
              <TextBlock FontSize="11" Foreground="#94A3B8" Text="管理控制台" />
            </StackPanel>
          </Grid>
        </Border>

        <Button
            Classes="secondary-button"
            Command="{Binding LogoutCommand}"
            Content="退出登录"
            DockPanel.Dock="Bottom"
            HorizontalContentAlignment="Center"
            Margin="14"
            Padding="12,9" />

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding NavigationGroups}" Margin="12,10">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,8">
                  <TextBlock
                      FontSize="11"
                      FontWeight="SemiBold"
                      Foreground="#94A3B8"
                      Margin="12,10,12,5"
                      Text="{Binding Title}" />
                  <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <ToggleButton
                            Classes="nav-item"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            IsChecked="{Binding IsSelected, Mode=TwoWay}">
                          <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock FontSize="15" Text="{Binding Icon}" Width="20" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding Label}" />
                          </StackPanel>
                        </ToggleButton>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- 右侧主内容区：顶部标题栏 + 页面内容。 -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*">
      <Border
          Background="#FFFFFF"
          BorderBrush="#E2E8F0"
          BorderThickness="0,0,0,1"
          Padding="30,15">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel VerticalAlignment="Center" Spacing="2">
            <TextBlock Classes="page-title" Text="{Binding SelectedItem.Label}" />
            <TextBlock Classes="page-subtitle" Text="统一管理已部署的 AI Tool 服务" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <Border
                Background="#E8F7EA"
                CornerRadius="14"
                Padding="10,5">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Width="7" Height="7" Fill="#22C55E" VerticalAlignment="Center" />
                <TextBlock FontSize="12" Foreground="#166534" Text="服务已连接" />
              </StackPanel>
            </Border>
            <TextBlock FontSize="12" Foreground="#94A3B8" Text="AI Tool Desktop" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1" Padding="30">
        <StackPanel Spacing="20">
          <Border Classes="content-card" Padding="24">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18">
              <Border
                  Width="52"
                  Height="52"
                  Background="#EEF4FF"
                  CornerRadius="14">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="24"
                    Text="✨" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#1E293B" Text="{Binding CurrentPage.Title}" />
                <TextBlock Classes="page-subtitle" Text="{Binding CurrentPage.Description}" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Classes="content-card" Padding="24">
            <StackPanel Spacing="10">
              <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#1E293B" Text="功能迁移进度" />
              <TextBlock Classes="page-subtitle" Text="桌面端基础框架已就绪，后续将按计划逐个接入现有后端 API。" TextWrapping="Wrap" />
              <Border Background="#F1F5F9" CornerRadius="6" Height="8" Margin="0,5,0,0">
                <Border Background="#6C9EFF" CornerRadius="6" HorizontalAlignment="Left" Width="150" />
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
