<UserControl
    x:Class="AITool.Desktop.Views.DeveloperInvocationsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AITool.Desktop.ViewModels"
    xmlns:models="using:AITool.Desktop.Models"
    x:DataType="vm:DeveloperInvocationsViewModel"
    x:CompileBindings="False">
  <UserControl.DataTemplates>
    <DataTemplate DataType="{x:Type models:DeveloperSimulatorTab}">
      <Grid RowDefinitions="Auto,Auto,*" RowSpacing="14" MinHeight="420">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
          <TextBox Classes="form-input" IsReadOnly="True" Text="{Binding EndpointUrl}" TextWrapping="Wrap" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <ToggleSwitch IsVisible="{Binding IsStreamable}" IsChecked="{Binding StreamEnabled, Mode=TwoWay}" OnContent="流式" OffContent="非流式" />
            <Button Classes="secondary-button" Click="CopyEndpointUrl" Content="复制 URL" Padding="10,7" />
            <Button Classes="primary-button" Command="{Binding DataContext.SendSimulatorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="发送请求" IsVisible="{Binding CanSend}" Padding="12,7" />
            <Button Classes="secondary-button" Command="{Binding DataContext.StopSimulatorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="停止" IsVisible="{Binding IsRunning}" Padding="12,7" />
          </StackPanel>
        </Grid>
        <TextBlock Grid.Row="1" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding Label}" />
        <Grid Grid.Row="2" ColumnDefinitions="1*,1*" ColumnSpacing="14" MinHeight="360">
          <StackPanel Spacing="8">
            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" Text="请求示例" />
            <TextBox
                Classes="code-box"
                AcceptsReturn="True"
                IsReadOnly="True"
                Text="{Binding RequestExample}"
                TextWrapping="Wrap"
                />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="8">
            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" Text="响应结果" />
            <TextBox
                Classes="code-box response-box"
                AcceptsReturn="True"
                IsReadOnly="True"
                Text="{Binding Response}"
                TextWrapping="Wrap"
                />
          </StackPanel>
        </Grid>
      </Grid>
    </DataTemplate>
  </UserControl.DataTemplates>

  <Grid MinWidth="0" ClipToBounds="True" RowDefinitions="Auto,*" RowSpacing="20">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" VerticalAlignment="Center">
      <StackPanel Spacing="4">
        <TextBlock Classes="page-title" Text="调试工具" />
        <TextBlock Classes="page-subtitle" Text="调用调试、客户端模拟和开发者追踪" />
      </StackPanel>
      <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding SelectedTabTitle}" />
    </Grid>

    <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
      <TabItem Header="调用调试">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,16,0,0" Spacing="16">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" VerticalAlignment="Center">
              <StackPanel Spacing="4">
                <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" Text="调用调试" />
                <TextBlock FontSize="13" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="展开每条调用查看请求链路、请求体、响应体和上游尝试记录" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ToggleSwitch IsChecked="{Binding AutoRefresh, Mode=TwoWay}" OnContent="自动刷新" OffContent="手动" />
                <ToggleSwitch IsChecked="{Binding SummarizeDetail, Mode=TwoWay}" OnContent="精简显示" OffContent="完整详情" />
                <Button Classes="primary-button" Command="{Binding RefreshCommand}" Content="立即刷新" Padding="12,7" />
              </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="1*,1*,1*" ColumnSpacing="12">
              <Border Classes="content-card" Padding="18">
                <StackPanel Spacing="6">
                  <TextBlock FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="当前记录数" />
                  <TextBlock FontSize="30" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" Text="{Binding TotalCount}" />
                  <TextBlock FontSize="11" Foreground="{DynamicResource AppTextTertiaryBrush}" Text="当前页最多 40 条记录" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="content-card" Padding="18" Background="#FFF7F7">
                <StackPanel Spacing="6">
                  <TextBlock FontSize="12" Foreground="#991B1B" Text="失败 / 异常" />
                  <TextBlock FontSize="30" FontWeight="Bold" Foreground="#B91C1C" Text="{Binding FailedCount}" />
                  <TextBlock FontSize="11" Foreground="#991B1B" Text="优先检查红色告警记录" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Classes="content-card" Padding="18" Background="#FFFBEB">
                <StackPanel Spacing="6">
                  <TextBlock FontSize="12" Foreground="#92400E" Text="等待返回" />
                  <TextBlock FontSize="30" FontWeight="Bold" Foreground="#B45309" Text="{Binding PendingCount}" />
                  <TextBlock FontSize="11" Foreground="#92400E" Text="请求已到达但响应未补齐" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Background="#EFF6FF" CornerRadius="10" Padding="14" IsVisible="{Binding IsLoading}">
              <StackPanel Spacing="6">
                <ProgressBar Height="4" IsIndeterminate="True" />
                <TextBlock Foreground="#315EA8" Text="正在加载调用记录..." />
              </StackPanel>
            </Border>
            <Border Background="#FEE2E2" CornerRadius="10" Padding="14" IsVisible="{Binding HasError}">
              <TextBlock Foreground="#B91C1C" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </Border>

            <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource AppTextTertiaryBrush}" IsVisible="{Binding HasNoItems}" Margin="0,30" Text="暂无调用记录" />
            <ItemsControl ItemsSource="{Binding Items}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="content-card" Padding="0" Margin="0,0,0,12">
                    <StackPanel>
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="18,16" VerticalAlignment="Center">
                        <StackPanel Spacing="12">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                              <Border Background="#E8F7EA" CornerRadius="14" Padding="10,5" IsVisible="{Binding IsSuccessful}"><TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#166534" Text="成功" /></Border>
                              <Border Background="#FEF3C7" CornerRadius="14" Padding="10,5" IsVisible="{Binding IsPending}"><TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#92400E" Text="等待" /></Border>
                              <Border Background="#FEE2E2" CornerRadius="14" Padding="10,5" IsVisible="{Binding IsFailed}"><TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#B91C1C" Text="失败" /></Border>
                              <Border Background="#EEF4FF" CornerRadius="14" Padding="10,5"><TextBlock FontSize="11" Foreground="#315EA8" Text="{Binding ProtocolType}" /></Border>
                              <Border Background="#F1F5F9" CornerRadius="14" Padding="10,5"><TextBlock FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding Source}" /></Border>
                            </StackPanel>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding CreatedAt}" TextTrimming="CharacterEllipsis" />
                          </Grid>
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                              <TextBlock FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" Text="{Binding RequestModel}" TextTrimming="CharacterEllipsis" />
                              <TextBlock FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AppTextTertiaryBrush}" Text="→" />
                              <TextBlock FontSize="17" FontWeight="Bold" Foreground="#315EA8" Text="{Binding AttemptedModel}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="展开详情后查看完整链路" />
                          </Grid>
                          <Grid ColumnDefinitions="1.4*,1.2*,0.7*,0.8*,1.5*,1.8*" ColumnSpacing="10">
                            <Border Background="{DynamicResource AppSurfaceSoftBrush}" CornerRadius="8" Padding="10,8"><StackPanel Spacing="3"><TextBlock FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="路径" /><TextBlock FontSize="12" Foreground="{DynamicResource AppTextPrimaryBrush}" Text="{Binding RequestPath}" TextTrimming="CharacterEllipsis" /></StackPanel></Border>
                            <Border Grid.Column="1" Background="{DynamicResource AppSurfaceSoftBrush}" CornerRadius="8" Padding="10,8"><StackPanel Spacing="3"><TextBlock FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="站点" /><TextBlock FontSize="12" Foreground="{DynamicResource AppTextPrimaryBrush}" Text="{Binding TargetSiteName}" TextTrimming="CharacterEllipsis" /></StackPanel></Border>
                            <Border Grid.Column="2" Background="{DynamicResource AppSurfaceSoftBrush}" CornerRadius="8" Padding="10,8"><StackPanel Spacing="3"><TextBlock FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="HTTP" /><TextBlock FontSize="12" Foreground="{DynamicResource AppTextPrimaryBrush}" Text="{Binding StatusCode}" /></StackPanel></Border>
                            <Border Grid.Column="3" Background="{DynamicResource AppSurfaceSoftBrush}" CornerRadius="8" Padding="10,8"><StackPanel Spacing="3"><TextBlock FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="耗时" /><TextBlock FontSize="12" Foreground="{DynamicResource AppTextPrimaryBrush}" Text="{Binding DurationText}" /></StackPanel></Border>
                            <Border Grid.Column="4" Background="{DynamicResource AppSurfaceSoftBrush}" CornerRadius="8" Padding="10,8"><StackPanel Spacing="3"><TextBlock FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="尝试次数" /><TextBlock FontSize="12" Foreground="{DynamicResource AppTextPrimaryBrush}" Text="{Binding AttemptCount}" /></StackPanel></Border>
                            <Border Grid.Column="5" Background="{DynamicResource AppSurfaceSoftBrush}" CornerRadius="8" Padding="10,8"><StackPanel Spacing="3"><TextBlock FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="尝试统计" /><TextBlock FontSize="12" Foreground="{DynamicResource AppTextPrimaryBrush}" Text="{Binding AttemptStatsText}" TextTrimming="CharacterEllipsis" /></StackPanel></Border>
                          </Grid>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="secondary-button" Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="查看链路" Padding="11,7" VerticalAlignment="Center" />
                      </Grid>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,0,0,8">
              <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding PaginationSummary}" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Classes="secondary-button" Command="{Binding PreviousPageCommand}" Content="上一页" IsEnabled="{Binding CanPrevious}" Padding="11,7" />
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding PageText}" />
                <Button Classes="secondary-button" Command="{Binding NextPageCommand}" Content="下一页" IsEnabled="{Binding CanNext}" Padding="11,7" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="客户端模拟">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,16,0,0" Spacing="16">
            <Border Classes="content-card" Padding="18">
              <Grid ColumnDefinitions="1*,1*,1*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="12">
                <StackPanel Spacing="4"><TextBlock FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="代理根地址" /><TextBox Classes="form-input" Text="{Binding BaseUrl}" Watermark="http://127.0.0.1:15029" /></StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="访问密钥" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Classes="form-input" Text="{Binding AccessKey}" Watermark="sk-..." />
                    <Button Grid.Column="1" Classes="secondary-button" Click="CopyAccessKey" Content="复制" Padding="10,6" />
                  </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                  <TextBlock FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="模型名" />
                  <ComboBox ItemsSource="{Binding ModelNames}" SelectedItem="{Binding SelectedModel}" IsEditable="True" PlaceholderText="输入对外模型名" />
                  <TextBlock FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding SupportHint}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Spacing="4"><TextBlock FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="测试消息" /><TextBox Classes="form-input" AcceptsReturn="True" Height="82" Text="{Binding InputText}" TextWrapping="Wrap" Watermark="输入测试消息..." /></StackPanel>
              </Grid>
            </Border>
            <Border Classes="content-card" Padding="0">
              <StackPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="16,12">
                  <ItemsControl ItemsSource="{Binding SimulatorTabs}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <ToggleButton Classes="simulator-tab" Command="{Binding DataContext.SelectSimulatorTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Padding="12,7" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="16">
                  <ContentControl Content="{Binding SelectedSimulatorTab}" />
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="当前模型并发数检测">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,16,0,0" Spacing="16">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
              <StackPanel Spacing="4"><TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" Text="当前模型并发数检测" /><TextBlock FontSize="13" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="显示最近出现过的站点模型、当前并发、最大并发和排队数，进入页面后每 5 秒刷新" /></StackPanel>
              <Button Grid.Column="1" Classes="secondary-button" Command="{Binding RefreshCommand}" Content="刷新" Padding="12,7" />
            </Grid>
            <Border Background="#EFF6FF" CornerRadius="10" Padding="14" IsVisible="{Binding IsConcurrencyLoading}">
              <StackPanel Spacing="6">
                <ProgressBar Height="4" IsIndeterminate="True" />
                <TextBlock Foreground="#315EA8" Text="正在加载并发数据..." />
              </StackPanel>
            </Border>
            <Border Background="#FEE2E2" CornerRadius="10" Padding="14" IsVisible="{Binding HasConcurrencyError}"><TextBlock Foreground="#B91C1C" Text="{Binding ConcurrencyError}" TextWrapping="Wrap" /></Border>
            <Border Classes="content-card" Padding="0">
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel MinWidth="760">
                  <Border Background="{DynamicResource AppSurfaceSoftBrush}" Padding="16,13"><Grid ColumnDefinitions="1.7*,1.5*,0.9*,1*,0.9*" ColumnSpacing="12"><TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="模型名" /><TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="站点" /><TextBlock Grid.Column="2" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="并发数" /><TextBlock Grid.Column="3" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="最大并发" /><TextBlock Grid.Column="4" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="排队数" /></Grid></Border>
                  <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource AppTextTertiaryBrush}" Margin="0,28" IsVisible="{Binding HasNoConcurrency}" Text="暂无并发数据" />
                  <ItemsControl ItemsSource="{Binding PagedConcurrency}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="16,12"><Grid ColumnDefinitions="1.7*,1.5*,0.9*,1*,0.9*" ColumnSpacing="12" VerticalAlignment="Center"><TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" Text="{Binding ModelName}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding SiteName}" TextTrimming="CharacterEllipsis" /><Border Grid.Column="2" Background="#E8F7EA" CornerRadius="12" Padding="8,4" HorizontalAlignment="Left"><TextBlock FontWeight="SemiBold" Foreground="#166534" Text="{Binding ActiveCount}" /></Border><TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding MaxConcurrencyText}" /><Border Grid.Column="4" Background="#FEF3C7" CornerRadius="12" Padding="8,4" HorizontalAlignment="Left"><TextBlock FontWeight="SemiBold" Foreground="#92400E" Text="{Binding QueueCount}" /></Border></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                  <Border Background="{DynamicResource AppCardBackgroundBrush}" Padding="16,12" IsVisible="{Binding HasConcurrencyPagination}"><Grid ColumnDefinitions="*,Auto,*"><Button Classes="secondary-button" Command="{Binding PreviousConcurrencyPageCommand}" Content="上一页" IsEnabled="{Binding CanPreviousConcurrencyPage}" HorizontalAlignment="Left" Padding="10,6" /><TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding ConcurrencyPageText}" /><Button Grid.Column="2" Classes="secondary-button" Command="{Binding NextConcurrencyPageCommand}" Content="下一页" IsEnabled="{Binding CanNextConcurrencyPage}" HorizontalAlignment="Right" Padding="10,6" /></Grid></Border>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="熔断监控">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,16,0,0" Spacing="16">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center"><StackPanel Spacing="4"><TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" Text="熔断状态监控" /><TextBlock FontSize="13" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="查看失败累计和已熔断路由，支持单条或全部解除" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Classes="secondary-button" Command="{Binding RefreshCommand}" Content="刷新" Padding="12,7" /><Button Classes="primary-button" Click="ConfirmResetAllCircuits" Content="解除全部熔断" IsVisible="{Binding HasBlockedCircuits}" Padding="12,7" /></StackPanel></Grid>
            <Border Background="#EFF6FF" CornerRadius="10" Padding="14" IsVisible="{Binding IsCircuitLoading}">
              <StackPanel Spacing="6">
                <ProgressBar Height="4" IsIndeterminate="True" />
                <TextBlock Foreground="#315EA8" Text="正在加载熔断状态..." />
              </StackPanel>
            </Border>
            <Border Background="#FEE2E2" CornerRadius="10" Padding="14" IsVisible="{Binding HasError}"><TextBlock Foreground="#B91C1C" Text="{Binding ErrorMessage}" TextWrapping="Wrap" /></Border>
            <Border Classes="content-card" Padding="0">
              <StackPanel>
                <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource AppTextTertiaryBrush}" Margin="0,30" IsVisible="{Binding HasNoCircuitRoutes}" Text="当前无熔断或失败记录" />
                <ItemsControl ItemsSource="{Binding CircuitRoutes}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="16,13"><Grid ColumnDefinitions="Auto,1.3*,1.2*,1*,0.9*,Auto,Auto" ColumnSpacing="12" VerticalAlignment="Center"><Border Background="#FEE2E2" CornerRadius="12" Padding="8,4" IsVisible="{Binding IsBlocked}"><TextBlock FontSize="11" Foreground="#B91C1C" Text="已熔断" /></Border><Border Grid.Column="0" Background="#FEF3C7" CornerRadius="12" Padding="8,4" IsVisible="{Binding IsNotBlocked}"><TextBlock FontSize="11" Foreground="#92400E" Text="失败累计" /></Border><TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" Text="{Binding EntryName}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="#315EA8" Text="{Binding UpstreamModelName}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding SiteName}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="4" VerticalAlignment="Center" Foreground="#B91C1C" Text="{Binding FailureText}" /><TextBlock Grid.Column="5" VerticalAlignment="Center" Foreground="#B45309" Text="{Binding RemainingText}" IsVisible="{Binding IsBlocked}" /><Button Grid.Column="6" Classes="secondary-button" Click="ConfirmResetCircuit" Content="解除" IsVisible="{Binding CanReset}" Padding="10,6" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <Border Grid.Row="1" Classes="content-card" MaxWidth="560" MinWidth="320" Padding="20" HorizontalAlignment="Right" IsVisible="{Binding HasDetail}" ZIndex="20">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14">
          <Border Background="#EFF6FF" CornerRadius="10" Padding="12" IsVisible="{Binding IsDetailLoading}">
            <StackPanel Spacing="6">
              <ProgressBar Height="4" IsIndeterminate="True" />
              <TextBlock Foreground="#315EA8" Text="正在加载请求详情..." />
            </StackPanel>
          </Border>
          <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center"><StackPanel Spacing="3"><TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" Text="请求链路详情" /><TextBlock FontSize="12" Foreground="{DynamicResource AppTextTertiaryBrush}" Text="完整展示请求、响应和每次上游尝试" /></StackPanel><Button Grid.Column="1" Classes="secondary-button" Command="{Binding CloseDetailCommand}" Content="关闭" Padding="10,6" /></Grid>
          <Border Background="{DynamicResource AppSurfaceSoftBrush}" CornerRadius="10" Padding="14"><Grid ColumnDefinitions="1*,1*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8"><StackPanel Spacing="3"><TextBlock FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="RequestId" /><TextBlock Foreground="{DynamicResource AppTextPrimaryBrush}" Text="{Binding SelectedDetail.RequestId}" TextWrapping="Wrap" /></StackPanel><StackPanel Grid.Column="1" Spacing="3"><TextBlock FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="请求时间" /><TextBlock Foreground="{DynamicResource AppTextPrimaryBrush}" Text="{Binding SelectedDetail.CreatedAt}" /></StackPanel><StackPanel Grid.Row="1" Spacing="3"><TextBlock FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="请求模型" /><TextBlock Foreground="{DynamicResource AppTextPrimaryBrush}" Text="{Binding SelectedDetail.RequestModel}" /></StackPanel><StackPanel Grid.Row="1" Grid.Column="1" Spacing="3"><TextBlock FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="实际模型" /><TextBlock Foreground="#315EA8" Text="{Binding SelectedDetail.AttemptedModel}" /></StackPanel><StackPanel Grid.Row="2" Spacing="3"><TextBlock FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="路径" /><TextBlock Foreground="{DynamicResource AppTextPrimaryBrush}" Text="{Binding SelectedDetail.RequestPath}" TextWrapping="Wrap" /></StackPanel><StackPanel Grid.Row="2" Grid.Column="1" Spacing="3"><TextBlock FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="协议" /><TextBlock Foreground="{DynamicResource AppTextPrimaryBrush}" Text="{Binding SelectedDetail.ProtocolType}" /></StackPanel><StackPanel Grid.Row="3" Spacing="3"><TextBlock FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="来源" /><TextBlock Foreground="{DynamicResource AppTextPrimaryBrush}" Text="{Binding SelectedDetail.Source}" TextWrapping="Wrap" /></StackPanel><StackPanel Grid.Row="3" Grid.Column="1" Spacing="3"><TextBlock FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="客户端 IP" /><TextBlock Foreground="{DynamicResource AppTextPrimaryBrush}" Text="{Binding SelectedDetail.ClientIp}" /></StackPanel><StackPanel Grid.Row="4" Spacing="3"><TextBlock FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="TraceId" /><TextBlock Foreground="{DynamicResource AppTextPrimaryBrush}" Text="{Binding SelectedDetail.TraceId}" TextWrapping="Wrap" /></StackPanel><StackPanel Grid.Row="5" Grid.ColumnSpan="2" Spacing="3"><TextBlock FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="User-Agent" /><TextBlock Foreground="{DynamicResource AppTextPrimaryBrush}" Text="{Binding SelectedDetail.UserAgent}" TextWrapping="Wrap" /></StackPanel></Grid></Border>
          <StackPanel Spacing="6"><Grid ColumnDefinitions="*,Auto"><TextBlock FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" Text="请求头" /><Button Grid.Column="1" Classes="secondary-button" Click="CopyDetailText" Tag="{Binding SelectedDetail.RequestHeadersText}" Content="复制" Padding="8,4" /></Grid><TextBox Classes="code-box" AcceptsReturn="True" IsReadOnly="True" Height="120" Text="{Binding SelectedDetail.RequestHeadersText}" TextWrapping="Wrap" /></StackPanel>
          <Border Background="#FEE2E2" CornerRadius="10" Padding="12" IsVisible="{Binding SelectedDetail.HasError}"><TextBlock Foreground="#B91C1C" Text="{Binding SelectedDetail.ErrorMessage}" TextWrapping="Wrap" /></Border>
          <StackPanel Spacing="8"><TextBlock FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" Text="上游尝试" /><ItemsControl ItemsSource="{Binding SelectedDetail.Attempts}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,8"><StackPanel Spacing="7"><Grid ColumnDefinitions="*,Auto"><TextBlock FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" Text="{Binding AttemptedModel}" /><Border Grid.Column="1" Background="#E8F7EA" CornerRadius="12" Padding="8,4" IsVisible="{Binding IsSuccessful}"><TextBlock FontSize="11" Foreground="#166534" Text="成功" /></Border><Border Grid.Column="1" Background="#FEE2E2" CornerRadius="12" Padding="8,4" IsVisible="{Binding IsFailed}"><TextBlock FontSize="11" Foreground="#B91C1C" Text="{Binding StatusText}" /></Border></Grid><TextBlock FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding TargetSiteName}" /><Grid ColumnDefinitions="1.1*,1.1*,0.8*,0.8*,1.3*" ColumnSpacing="8"><TextBlock FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding ForwardingMode}" /><TextBlock Grid.Column="1" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding UpstreamProtocolType}" /><TextBlock Grid.Column="2" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding HttpStatusText}" /><TextBlock Grid.Column="3" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding DurationText}" /><TextBlock Grid.Column="4" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding TokenSummaryText}" TextTrimming="CharacterEllipsis" /></Grid><StackPanel Spacing="4" IsVisible="{Binding HasPreparedRequestBody}"><Grid ColumnDefinitions="*,Auto"><TextBlock FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="请求体" /><Button Grid.Column="1" Classes="secondary-button" Click="CopyDetailText" Tag="{Binding PreparedRequestBody}" Content="复制" Padding="7,3" /></Grid><TextBox Classes="code-box" AcceptsReturn="True" IsReadOnly="True" Height="100" Text="{Binding PreparedRequestBody}" TextWrapping="Wrap" /></StackPanel><StackPanel Spacing="4" IsVisible="{Binding HasResponseBody}"><Grid ColumnDefinitions="*,Auto"><TextBlock FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="响应体" /><Button Grid.Column="1" Classes="secondary-button" Click="CopyDetailText" Tag="{Binding ResponseBody}" Content="复制" Padding="7,3" /></Grid><TextBox Classes="code-box response-box" AcceptsReturn="True" IsReadOnly="True" Height="120" Text="{Binding ResponseBody}" TextWrapping="Wrap" /></StackPanel><TextBlock FontSize="12" Foreground="#B91C1C" Text="{Binding ErrorMessage}" TextWrapping="Wrap" IsVisible="{Binding HasError}" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
          <StackPanel Spacing="6"><Grid ColumnDefinitions="*,Auto"><TextBlock FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" Text="请求体" /><Button Grid.Column="1" Classes="secondary-button" Click="CopyDetailText" Tag="{Binding SelectedDetail.RequestBody}" Content="复制" Padding="8,4" /></Grid><TextBox Classes="code-box" AcceptsReturn="True" IsReadOnly="True" Height="150" Text="{Binding SelectedDetail.RequestBody}" TextWrapping="Wrap" /></StackPanel>
          <StackPanel Spacing="6"><Grid ColumnDefinitions="*,Auto"><TextBlock FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" Text="响应体" /><Button Grid.Column="1" Classes="secondary-button" Click="CopyDetailText" Tag="{Binding SelectedDetail.ResponseBody}" Content="复制" Padding="8,4" /></Grid><TextBox Classes="code-box response-box" AcceptsReturn="True" IsReadOnly="True" Height="150" Text="{Binding SelectedDetail.ResponseBody}" TextWrapping="Wrap" /></StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
