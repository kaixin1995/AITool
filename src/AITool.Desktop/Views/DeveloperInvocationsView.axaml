<UserControl
    x:Class="AITool.Desktop.Views.DeveloperInvocationsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AITool.Desktop.ViewModels"
    x:DataType="vm:DeveloperInvocationsViewModel"
    x:CompileBindings="False">
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="24"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="4"><TextBlock FontSize="22" FontWeight="Bold" Foreground="#1E293B" Text="调试工具" /><TextBlock Classes="page-subtitle" Text="查看开发者调用轨迹和请求详情" /></StackPanel><TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="#64748B" Text="{Binding TotalCount}" /></Grid><Grid Grid.Row="2"><StackPanel Spacing="14"><Border Background="#FEE2E2" CornerRadius="8" Padding="12" IsVisible="{Binding HasError}"><TextBlock Foreground="#B91C1C" Text="{Binding ErrorMessage}" TextWrapping="Wrap" /></Border><Grid ColumnDefinitions="*,*,*" ColumnSpacing="12"><Border Classes="content-card" Padding="14"><TextBlock Foreground="#1E293B" Text="{Binding FailedCount}" /></Border><Border Grid.Column="1" Classes="content-card" Padding="14"><TextBlock Foreground="#1E293B" Text="{Binding PendingCount}" /></Border><Border Grid.Column="2" Classes="content-card" Padding="14"><TextBlock Foreground="#1E293B" Text="{Binding TotalCount}" /></Border></Grid><Border Classes="content-card" Padding="0"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><StackPanel MinWidth="920"><Border Background="#F8FAFC" Padding="18,14"><Grid ColumnDefinitions="1.5*,1.2*,1.3*,1*,1*,Auto" ColumnSpacing="10"><TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Text="时间" /><TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Text="请求模型" /><TextBlock Grid.Column="2" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Text="站点" /><TextBlock Grid.Column="3" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Text="状态" /><TextBlock Grid.Column="4" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Text="耗时" /><TextBlock Grid.Column="5" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Text="操作" /></Grid></Border><TextBlock HorizontalAlignment="Center" Foreground="#94A3B8" IsVisible="{Binding HasNoItems}" Text="暂无调用轨迹" Margin="0,30" /><ItemsControl ItemsSource="{Binding Items}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="18,13"><Grid ColumnDefinitions="1.5*,1.2*,1.3*,1*,1*,Auto" ColumnSpacing="10"><StackPanel Spacing="2"><TextBlock FontSize="12" Foreground="#64748B" Text="{Binding CreatedAt}" /><TextBlock FontSize="11" Foreground="#94A3B8" Text="{Binding TraceId}" /></StackPanel><TextBlock Grid.Column="1" Foreground="#1E293B" Text="{Binding RequestModel}" /><TextBlock Grid.Column="2" Foreground="#64748B" Text="{Binding TargetSiteName}" /><TextBlock Grid.Column="3" Foreground="#1E293B" Text="{Binding StatusText}" /><TextBlock Grid.Column="4" Foreground="#64748B" Text="{Binding TotalDurationMs}" /><Button Grid.Column="5" Classes="secondary-button" Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="详情" Padding="10,6" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></Border><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"><Button Classes="secondary-button" Command="{Binding PreviousPageCommand}" Content="上一页" IsEnabled="{Binding CanPrevious}" Padding="12,7" /><TextBlock VerticalAlignment="Center" Foreground="#64748B" Text="{Binding PageText}" /><Button Classes="secondary-button" Command="{Binding NextPageCommand}" Content="下一页" IsEnabled="{Binding CanNext}" Padding="12,7" /></StackPanel></StackPanel><Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="14" IsVisible="{Binding HasDetail}" Padding="22" Width="720" HorizontalAlignment="Center" VerticalAlignment="Center" ZIndex="10"><StackPanel Spacing="12"><Grid ColumnDefinitions="*,Auto"><TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#1E293B" Text="调用详情" /><Button Grid.Column="1" Classes="secondary-button" Command="{Binding CloseDetailCommand}" Content="关闭" Padding="10,6" /></Grid><TextBlock Foreground="#64748B" Text="{Binding SelectedDetail.RequestPath}" /><TextBlock Foreground="#64748B" Text="{Binding SelectedDetail.RequestModel}" /><TextBox Classes="form-input" IsReadOnly="True" Height="120" Text="{Binding SelectedDetail.RequestBody}" TextWrapping="Wrap" /><TextBox Classes="form-input" IsReadOnly="True" Height="140" Text="{Binding SelectedDetail.ResponseBody}" TextWrapping="Wrap" /><ItemsControl ItemsSource="{Binding SelectedDetail.Attempts}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#F8FAFC" CornerRadius="6" Padding="10"><Grid ColumnDefinitions="*,*,Auto"><TextBlock Foreground="#1E293B" Text="{Binding TargetSiteName}" /><TextBlock Grid.Column="1" Foreground="#64748B" Text="{Binding AttemptedModel}" /><TextBlock Grid.Column="2" Foreground="#64748B" Text="{Binding Status}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></Grid></Grid>
</UserControl>
