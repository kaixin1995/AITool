<UserControl
    x:Class="AITool.Desktop.Views.DetectionTasksView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AITool.Desktop.ViewModels"
    x:DataType="vm:DetectionTasksViewModel"
    x:CompileBindings="False">
  <Grid RowDefinitions="Auto,*">
    <StackPanel Spacing="4" Margin="0,0,0,18"><TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#1E293B" Text="检测任务管理" /><TextBlock Classes="page-subtitle" Text="配置定时检测任务，自动监控模型可用性" /></StackPanel>
    <Grid Grid.Row="1" RowDefinitions="Auto,*">
      <Border Classes="content-card" Padding="18" Margin="0,0,0,14"><Grid ColumnDefinitions="1.3*,1*,1.3*,Auto" ColumnSpacing="12"><StackPanel Spacing="6"><TextBlock FontSize="12" Foreground="#64748B" Text="任务名称" /><TextBox Classes="form-input" Text="{Binding TaskName}" Watermark="如：全量模型半小时检测" /></StackPanel><StackPanel Grid.Column="1" Spacing="6"><TextBlock FontSize="12" Foreground="#64748B" Text="Cron 表达式" /><TextBox Classes="form-input" Text="{Binding CronExpression}" /></StackPanel><StackPanel Grid.Column="2" Spacing="6"><TextBlock FontSize="12" Foreground="#64748B" Text="检测模型" /><ComboBox ItemsSource="{Binding AvailableModels}" SelectedItem="{Binding SelectedModel}" PlaceholderText="全部模型"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel><Button Grid.Column="3" Classes="primary-button" Command="{Binding CreateCommand}" Content="创建任务" IsEnabled="{Binding CanCreate}" VerticalAlignment="Bottom" Padding="14,8" /></Grid></Border>
      <Grid Grid.Row="1"><TextBlock HorizontalAlignment="Center" Foreground="#94A3B8" IsVisible="{Binding HasNoTasks}" Text="暂无检测任务" Margin="0,30" /><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Tasks}"><ItemsControl.ItemTemplate><DataTemplate><Border Classes="content-card" Margin="0,0,0,12" Padding="18"><StackPanel Spacing="10"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="4"><TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#1E293B" Text="{Binding Name}" /><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock FontSize="12" Foreground="#64748B" Text="{Binding CronExpression}" /><TextBlock FontSize="12" Foreground="#64748B" Text="{Binding ModelText}" /></StackPanel></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"><Border Background="#E8F7EA" CornerRadius="12" Padding="9,4"><TextBlock Foreground="#166534" Text="{Binding StatusText}" /></Border><Button Classes="secondary-button" Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="切换" Padding="10,6" /><Button Classes="secondary-button" Command="{Binding DataContext.ExecuteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="立即执行" Padding="10,6" /><Button Classes="secondary-button" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="删除" Padding="10,6" /></StackPanel></Grid><TextBlock FontSize="12" Foreground="#64748B" Text="{Binding LastExecutionStatus, StringFormat='上次执行：{0}'}" /><ItemsControl ItemsSource="{Binding ExecutionHistory}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#F8FAFC" CornerRadius="6" Padding="10" Margin="0,2"><Grid ColumnDefinitions="1.4*,Auto,Auto,*" ColumnSpacing="12"><TextBlock FontSize="12" Foreground="#64748B" Text="{Binding StartedAt}" /><TextBlock Grid.Column="1" FontSize="12" Foreground="#64748B" Text="{Binding DurationText}" /><TextBlock Grid.Column="2" FontSize="12" Foreground="#64748B" Text="{Binding Status}" /><TextBlock Grid.Column="3" FontSize="12" Foreground="#64748B" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid>
    </Grid>
  </Grid>
</UserControl>
