<UserControl
    x:Class="AITool.Desktop.Views.ModelHealthView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AITool.Desktop.ViewModels"
    x:DataType="vm:ModelHealthViewModel"
    x:CompileBindings="False">
  <Grid RowDefinitions="Auto,*" RowSpacing="18" MinWidth="0">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14" VerticalAlignment="Center">
      <StackPanel Spacing="4">
        <TextBlock Classes="page-title" Text="模型健康看板" />
        <TextBlock Classes="page-subtitle" Text="监控指定模型在各站点的健康状态、成功率和检测历史" />
      </StackPanel>
      <Button Grid.Column="1" Classes="secondary-button" Command="{Binding RefreshCommand}" Content="刷新" Padding="12,7" />
    </Grid>

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="16">
        <Border Classes="content-card" Padding="18">
          <StackPanel Spacing="12">
            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#1E293B" Text="添加监控模型" />
            <Grid ColumnDefinitions="1*,1.2*,Auto" ColumnSpacing="12" VerticalAlignment="Bottom">
              <StackPanel Spacing="5">
                <TextBlock FontSize="12" Foreground="#64748B" Text="搜索模型" />
                <TextBox Classes="form-input" Text="{Binding AvailableKeyword}" Watermark="输入模型名称过滤..." />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="5">
                <TextBlock FontSize="12" Foreground="#64748B" Text="选择模型" />
                <ComboBox ItemsSource="{Binding FilteredAvailableModels}" SelectedItem="{Binding SelectedModel}" PlaceholderText="请选择要监控的模型">
                  <ComboBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <Button Grid.Column="2" Classes="primary-button" Command="{Binding AddMonitorCommand}" Content="添加监控" IsEnabled="{Binding CanAddMonitor}" Padding="14,8" />
            </Grid>
            <TextBlock FontSize="12" Foreground="#94A3B8" IsVisible="{Binding HasNoAvailableModels}" Text="暂无可添加的模型，或所有模型已经加入监控。" />
            <TextBlock FontSize="12" Foreground="#94A3B8" IsVisible="{Binding HasNoFilteredAvailableModels}" Text="没有匹配的模型，请调整搜索关键词。" />
          </StackPanel>
        </Border>

        <Border Classes="content-card" Padding="16" IsVisible="{Binding HasMonitoredModels}">
          <Grid ColumnDefinitions="Auto,180" ColumnSpacing="12" VerticalAlignment="Center">
            <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="#64748B" Text="时间范围" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding RangeOptions}" SelectedItem="{Binding SelectedRange}">
              <ComboBox.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
        </Border>

        <Border Background="#FEE2E2" CornerRadius="10" Padding="14" IsVisible="{Binding HasError}">
          <TextBlock Foreground="#B91C1C" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
        </Border>
        <Border Background="#EFF6FF" CornerRadius="10" Padding="14" IsVisible="{Binding IsLoading}">
          <TextBlock Foreground="#315EA8" Text="正在加载模型健康数据..." />
        </Border>

        <Border Classes="content-card" Padding="24" IsVisible="{Binding HasNoMonitoredModels}">
          <StackPanel HorizontalAlignment="Center" Spacing="8">
            <TextBlock HorizontalAlignment="Center" FontSize="30" Text="💊" />
            <TextBlock HorizontalAlignment="Center" Foreground="#64748B" Text="暂未配置监控模型，请在上方选择模型添加" />
          </StackPanel>
        </Border>
        <Border Classes="content-card" Padding="24" IsVisible="{Binding IsEmptyAfterFilter}">
          <TextBlock HorizontalAlignment="Center" Foreground="#64748B" Text="没有匹配当前关键词的模型" />
        </Border>

        <ItemsControl ItemsSource="{Binding FilteredModels}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="content-card" Padding="18" Margin="0,0,0,14">
                <StackPanel Spacing="14">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14" VerticalAlignment="Top">
                    <StackPanel Spacing="4" MinWidth="0">
                      <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="#1E293B" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                      <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding SiteSummaryText}" />
                      <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,4,0,0">
                        <Border Background="#E8F7EA" CornerRadius="12" Padding="9,4"><TextBlock FontSize="11" Foreground="#166534" Text="{Binding HealthySiteText}" /></Border>
                        <Border Background="#FEE2E2" CornerRadius="12" Padding="9,4"><TextBlock FontSize="11" Foreground="#B91C1C" Text="{Binding UnhealthySiteText}" /></Border>
                        <Border Background="#F1F5F9" CornerRadius="12" Padding="9,4"><TextBlock FontSize="11" Foreground="#64748B" Text="{Binding HealthSummaryText}" /></Border>
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                      <Button Classes="secondary-button" Command="{Binding DataContext.ToggleDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="查看明细" IsVisible="{Binding IsCollapsed}" Padding="11,7" />
                      <Button Classes="secondary-button" Command="{Binding DataContext.ToggleDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="收起明细" IsVisible="{Binding IsExpanded}" Padding="11,7" />
                      <Button Classes="secondary-button" Command="{Binding DataContext.RemoveMonitorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="移除监控" IsEnabled="{Binding DataContext.CanRemoveMonitor, RelativeSource={RelativeSource AncestorType=UserControl}}" Padding="11,7" />
                    </StackPanel>
                  </Grid>

                  <Grid ColumnDefinitions="1*,1*,1*,1*,1.5*" ColumnSpacing="10">
                    <Border Background="#F8FAFC" CornerRadius="8" Padding="12,10"><StackPanel Spacing="4"><TextBlock FontSize="11" Foreground="#64748B" Text="成功率" /><TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#166534" Text="{Binding SuccessRateText}" /></StackPanel></Border>
                    <Border Grid.Column="1" Background="#F8FAFC" CornerRadius="8" Padding="12,10"><StackPanel Spacing="4"><TextBlock FontSize="11" Foreground="#64748B" Text="成功 / 失败" /><TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#1E293B" Text="{Binding SuccessFailureText}" /></StackPanel></Border>
                    <Border Grid.Column="2" Background="#F8FAFC" CornerRadius="8" Padding="12,10"><StackPanel Spacing="4"><TextBlock FontSize="11" Foreground="#64748B" Text="总请求" /><TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#1E293B" Text="{Binding TotalRequestCount}" /></StackPanel></Border>
                    <Border Grid.Column="3" Background="#F8FAFC" CornerRadius="8" Padding="12,10"><StackPanel Spacing="4"><TextBlock FontSize="11" Foreground="#64748B" Text="平均延迟" /><TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#B45309" Text="{Binding AverageDurationText}" /></StackPanel></Border>
                    <Border Grid.Column="4" Background="#F8FAFC" CornerRadius="8" Padding="12,10"><StackPanel Spacing="4"><TextBlock FontSize="11" Foreground="#64748B" Text="最近检查" /><TextBlock FontSize="12" Foreground="#64748B" Text="{Binding LastCheckedText}" TextTrimming="CharacterEllipsis" /></StackPanel></Border>
                  </Grid>

                  <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,14,0,0" IsVisible="{Binding IsExpanded}">
                    <StackPanel Spacing="10">
                      <TextBlock FontWeight="SemiBold" Foreground="#1E293B" Text="站点明细" />
                      <TextBlock HorizontalAlignment="Center" Foreground="#94A3B8" IsVisible="{Binding HasNoSites}" Text="该模型暂无站点映射数据" />
                      <ItemsControl ItemsSource="{Binding Sites}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Background="#F8FAFC" CornerRadius="10" Padding="14" Margin="0,0,0,8">
                              <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                  <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock FontWeight="SemiBold" Foreground="#1E293B" Text="{Binding SiteName}" TextTrimming="CharacterEllipsis" />
                                    <Border Background="#E8F7EA" CornerRadius="12" Padding="8,4" IsVisible="{Binding IsSuccess}"><TextBlock FontSize="11" Foreground="#166534" Text="正常" /></Border>
                                    <Border Background="#FEE2E2" CornerRadius="12" Padding="8,4" IsVisible="{Binding IsFailed}"><TextBlock FontSize="11" Foreground="#B91C1C" Text="异常" /></Border>
                                    <Border Background="#F1F5F9" CornerRadius="12" Padding="8,4" IsVisible="{Binding IsUnknown}"><TextBlock FontSize="11" Foreground="#64748B" Text="未知" /></Border>
                                  </StackPanel>
                                  <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Foreground="#64748B" Text="{Binding RemoteModelName}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <Grid ColumnDefinitions="1.2*,1*,1*,1.4*" ColumnSpacing="10">
                                  <StackPanel Spacing="3"><TextBlock FontSize="11" Foreground="#64748B" Text="成功率" /><TextBlock FontWeight="SemiBold" Foreground="#166534" Text="{Binding SuccessRateText}" /></StackPanel>
                                  <StackPanel Grid.Column="1" Spacing="3"><TextBlock FontSize="11" Foreground="#64748B" Text="成功 / 失败" /><TextBlock Foreground="#1E293B" Text="{Binding SuccessFailureText}" /></StackPanel>
                                  <StackPanel Grid.Column="2" Spacing="3"><TextBlock FontSize="11" Foreground="#64748B" Text="最近耗时" /><TextBlock Foreground="#B45309" Text="{Binding DurationText}" /></StackPanel>
                                  <StackPanel Grid.Column="3" Spacing="3"><TextBlock FontSize="11" Foreground="#64748B" Text="最近检查" /><TextBlock FontSize="12" Foreground="#64748B" Text="{Binding LastCheckedText}" TextTrimming="CharacterEllipsis" /></StackPanel>
                                </Grid>
                                <ProgressBar Maximum="100" Value="{Binding SuccessRatePercent}" Height="8" />
                                <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasTimeline}">
                                  <ItemsControl ItemsSource="{Binding TimelineSegments}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate>
                                        <Grid Width="16" Height="10" ToolTip.Tip="{Binding TooltipText}">
                                          <Border Background="#E8F7EA" CornerRadius="3" IsVisible="{Binding IsAllSuccess}" />
                                          <Border Background="#FEE2E2" CornerRadius="3" IsVisible="{Binding IsAllFailed}" />
                                          <Border Background="#FEF3C7" CornerRadius="3" IsVisible="{Binding IsMixed}" />
                                          <Border Background="#E2E8F0" CornerRadius="3" IsVisible="{Binding IsEmpty}" />
                                        </Grid>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>
                                <TextBlock FontSize="12" Foreground="#94A3B8" IsVisible="{Binding HasNoTimeline}" Text="暂无请求记录" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
