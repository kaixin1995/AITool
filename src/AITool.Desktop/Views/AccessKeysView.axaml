<UserControl
    x:Class="AITool.Desktop.Views.AccessKeysView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AITool.Desktop.ViewModels"
    x:DataType="vm:AccessKeysViewModel"
    x:CompileBindings="False">
  <Grid>
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="24">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" Text="访问密钥" />
          <TextBlock Classes="page-subtitle" Text="管理客户端访问凭证和允许的路由范围" />
        </StackPanel>
        <Button Grid.Column="1" Classes="primary-button" Command="{Binding OpenCreateCommand}" Content="新建密钥" IsEnabled="{Binding CanOpenEditor}" Padding="14,8" />
      </Grid>

      <Grid Grid.Row="2">
        <TextBlock HorizontalAlignment="Center" Margin="0,35,0,0" Foreground="{DynamicResource AppTextSecondaryBrush}" IsVisible="{Binding IsLoading}" Text="正在加载访问密钥..." />
        <Border Background="{DynamicResource AppDangerSoftBrush}" CornerRadius="8" Padding="14" IsVisible="{Binding HasError}"><TextBlock Foreground="{DynamicResource AppDangerTextBrush}" Text="{Binding ErrorMessage}" TextWrapping="Wrap" /></Border>
        <Border Background="{DynamicResource AppWarningSoftBrush}" CornerRadius="8" Padding="14" IsVisible="{Binding HasRouteError}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Foreground="{DynamicResource AppWarningTextBrush}" Text="{Binding RouteErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="secondary-button" Command="{Binding RefreshCommand}" Content="重试" IsEnabled="{Binding CanRetryRouteLoad}" Padding="10,6" />
          </Grid>
        </Border>
        <Border Classes="content-card" IsVisible="{Binding IsListVisible}" Padding="0">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel MinWidth="760">
              <Border Background="{DynamicResource AppInputBackgroundBrush}" Padding="18,14">
                <Grid ColumnDefinitions="2*,2.2*,2*,1*,Auto">
                  <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="名称" />
                  <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="密钥" />
                  <TextBlock Grid.Column="2" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="允许路由" />
                  <TextBlock Grid.Column="3" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="状态" />
                  <TextBlock Grid.Column="4" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="操作" />
                </Grid>
              </Border>
              <ItemsControl ItemsSource="{Binding PagedItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="18,14">
                      <Grid ColumnDefinitions="2*,2.2*,2*,1*,Auto" ColumnSpacing="12">
                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" Text="{Binding KeyName}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding MaskedValue}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding AllowedRoutesText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Grid Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center">
                          <Border Background="{DynamicResource AppSuccessSoftBrush}" CornerRadius="12" Padding="9,4" IsVisible="{Binding IsEnabled}"><TextBlock Foreground="{DynamicResource AppSuccessTextBrush}" Text="{Binding StatusText}" /></Border>
                          <Border Background="{DynamicResource AppSurfaceSoftBrush}" CornerRadius="12" Padding="9,4" IsVisible="{Binding IsDisabled}"><TextBlock Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding StatusText}" /></Border>
                        </Grid>
                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <Button Classes="secondary-button" Command="{Binding DataContext.OpenRoutesEditorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="编辑路由" IsEnabled="{Binding DataContext.CanOpenEditor, RelativeSource={RelativeSource AncestorType=UserControl}}" Padding="10,6" />
                          <Button Classes="secondary-button" Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="{Binding ToggleActionText}" Padding="10,6" />
                          <Button Classes="secondary-button" Click="ConfirmDeleteAccessKey" Content="删除" Padding="10,6" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Background="{DynamicResource AppCardBackgroundBrush}" Padding="18,12">
                <Grid ColumnDefinitions="*,Auto,*">
                  <Button Classes="secondary-button" Command="{Binding PreviousPageCommand}" Content="上一页" IsEnabled="{Binding CanPreviousPage}" HorizontalAlignment="Left" Padding="10,6" />
                  <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding PageText}" />
                  <Button Grid.Column="2" Classes="secondary-button" Command="{Binding NextPageCommand}" Content="下一页" IsEnabled="{Binding CanNextPage}" HorizontalAlignment="Right" Padding="10,6" />
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Border>

        <Border Background="{DynamicResource AppCardBackgroundBrush}" BorderBrush="{DynamicResource AppBorderStrongBrush}" BorderThickness="1" CornerRadius="14" IsVisible="{Binding IsEditorOpen}" Padding="24" Margin="12" MaxWidth="520" HorizontalAlignment="Stretch" VerticalAlignment="Center" ZIndex="10">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*,Auto"><TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" Text="新建访问密钥" /><Button Grid.Column="1" Classes="secondary-button" Command="{Binding CloseEditorCommand}" Content="关闭" Padding="10,6" /></Grid>
            <Border Background="{DynamicResource AppSuccessSoftBrush}" CornerRadius="8" IsVisible="{Binding HasCreatedKey}" Padding="12">
              <StackPanel Spacing="8">
                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource AppSuccessTextBrush}" Text="密钥已创建，仅显示一次" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox Classes="form-input" IsReadOnly="True" Text="{Binding CreatedPlainKey}" />
                  <Button Grid.Column="1" Classes="secondary-button" Click="CopyCreatedPlainKey" Content="复制" Padding="10,6" />
                </Grid>
                <TextBlock FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="请立即复制并妥善保存，客户端不会再次获取明文。列表中的密钥仅显示脱敏值，无法复制完整密钥。" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <StackPanel IsVisible="{Binding IsCreateFormVisible}" Spacing="8">
              <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppCodeForegroundBrush}" Text="密钥名称" />
              <TextBox Classes="form-input" Text="{Binding NewKeyName}" Watermark="如：生产环境密钥" />
              <TextBlock FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="不勾选任何路由表示允许全部路由；勾选后仅允许访问选中的路由入口。" TextWrapping="Wrap" />
              <StackPanel Spacing="6" IsVisible="{Binding HasRouteEntries}">
                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppCodeForegroundBrush}" Text="允许路由（不选=全部）" />
                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding RouteEntries}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <CheckBox Content="{Binding EntryName}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,3" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>
              <Button Classes="primary-button" Command="{Binding CreateCommand}" Content="创建密钥" IsEnabled="{Binding CanCreate}" HorizontalContentAlignment="Center" Padding="12,9" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Background="{DynamicResource AppCardBackgroundBrush}" BorderBrush="{DynamicResource AppBorderStrongBrush}" BorderThickness="1" CornerRadius="14" IsVisible="{Binding IsRoutesEditorOpen}" Padding="24" Margin="12" MaxWidth="520" HorizontalAlignment="Stretch" VerticalAlignment="Center" ZIndex="11">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*,Auto"><TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" Text="{Binding RoutesEditorTitle}" /><Button Grid.Column="1" Classes="secondary-button" Command="{Binding CloseRoutesEditorCommand}" Content="关闭" Padding="10,6" /></Grid>
            <TextBlock FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="勾选允许访问的路由入口。不勾选任何项表示允许全部路由。" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="secondary-button" Command="{Binding SelectAllRoutesCommand}" Content="全选" Padding="10,6" />
              <Button Classes="secondary-button" Command="{Binding ClearSelectedRoutesCommand}" Content="清空（全部路由）" Padding="10,6" />
            </StackPanel>
            <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding RouteEntries}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox Content="{Binding EntryName}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,3" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <Button Classes="primary-button" Command="{Binding SaveRoutesCommand}" Content="保存路由权限" IsEnabled="{Binding CanSaveRoutes}" HorizontalContentAlignment="Center" Padding="12,9" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
