<UserControl
    x:Class="AITool.Desktop.Views.ModelsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AITool.Desktop.ViewModels"
    x:DataType="vm:ModelsViewModel"
    x:CompileBindings="False">
  <Grid>
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="24">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock FontSize="22" FontWeight="Bold" Foreground="#1E293B" Text="模型库" />
          <TextBlock Classes="page-subtitle" Text="统一管理模型映射和启用状态" />
        </StackPanel>
        <Button Grid.Column="1" Classes="primary-button" Command="{Binding OpenCreateCommand}" Content="新增模型" Padding="14,8" />
      </Grid>

      <Grid Grid.Row="2">
        <TextBlock HorizontalAlignment="Center" Margin="0,35,0,0" Foreground="#64748B" IsVisible="{Binding IsLoading}" Text="正在加载模型..." />
        <Border Background="#FEE2E2" CornerRadius="8" Padding="14" IsVisible="{Binding HasError}"><TextBlock Foreground="#B91C1C" Text="{Binding ErrorMessage}" TextWrapping="Wrap" /></Border>
        <ScrollViewer IsVisible="{Binding IsListVisible}" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding VendorGroups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="content-card" Margin="0,0,0,14" Padding="0">
                  <StackPanel>
                    <Border Background="#F8FAFC" Padding="18,13">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#1E293B" Text="{Binding VendorName}" />
                        <TextBlock Grid.Column="1" Foreground="#94A3B8" Text="{Binding Models.Count, StringFormat='共 {0} 个模型'}" />
                      </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Models}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="18,13">
                            <Grid ColumnDefinitions="2.2*,1.2*,1*,Auto" ColumnSpacing="14">
                              <StackPanel Spacing="3">
                                <TextBlock FontWeight="SemiBold" Foreground="#1E293B" Text="{Binding DisplayName}" />
                                <TextBlock FontSize="12" Foreground="#94A3B8" Text="{Binding ModelName}" />
                              </StackPanel>
                              <TextBlock Grid.Column="1" Foreground="#64748B" Text="{Binding SiteCount, StringFormat='关联站点：{0}'}" VerticalAlignment="Center" />
                              <Border Grid.Column="2" Background="#E8F7EA" CornerRadius="12" Padding="9,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Foreground="#166534" Text="{Binding StatusText}" />
                              </Border>
                              <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button Classes="secondary-button" Command="{Binding DataContext.OpenEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="编辑" Padding="10,6" />
                                <Button Classes="secondary-button" Command="{Binding DataContext.OpenMappingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="映射" IsEnabled="{Binding DataContext.CanOpenMapping, RelativeSource={RelativeSource AncestorType=UserControl}}" Padding="10,6" />
                                <Button Classes="secondary-button" Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="{Binding ToggleActionText}" Padding="10,6" />
                                <Button Classes="secondary-button" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="删除" Padding="10,6" />
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="14" IsVisible="{Binding IsEditorOpen}" Padding="24" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" ZIndex="10">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*,Auto"><TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#1E293B" Text="{Binding EditorTitle}" /><Button Grid.Column="1" Classes="secondary-button" Command="{Binding CloseEditorCommand}" Content="关闭" Padding="10,6" /></Grid>
            <StackPanel Spacing="6"><TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#334155" Text="模型名称" /><TextBox Classes="form-input" Text="{Binding Form.ModelName}" Watermark="例如 claude-3-7-sonnet" /></StackPanel>
            <StackPanel Spacing="6"><TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#334155" Text="显示名称" /><TextBox Classes="form-input" Text="{Binding Form.DisplayName}" /></StackPanel>
            <StackPanel Spacing="6"><TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#334155" Text="推理强度覆盖" /><TextBox Classes="form-input" Text="{Binding Form.OverrideReasoningEffort}" Watermark="可选" /></StackPanel>
            <StackPanel Spacing="6">
              <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#334155" Text="兼容规则集" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <ComboBox ItemsSource="{Binding ProfileOptions}" SelectedItem="{Binding SelectedCompatibilityProfile}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="1" Classes="secondary-button" Command="{Binding ClearCompatibilityProfileCommand}" Content="清除" Padding="10,6" />
              </Grid>
            </StackPanel>
            <CheckBox Content="启用模型" IsChecked="{Binding Form.IsEnabled}" />
            <TextBlock Foreground="#B91C1C" IsVisible="{Binding HasError}" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            <Button Classes="primary-button" Command="{Binding SaveCommand}" Content="保存模型" IsEnabled="{Binding CanSave}" HorizontalContentAlignment="Center" Padding="12,9" />
          </StackPanel>
        </Border>

        <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="14" IsVisible="{Binding IsMappingOpen}" Padding="24" Width="560" MaxHeight="720" HorizontalAlignment="Center" VerticalAlignment="Center" ZIndex="11">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#1E293B" Text="{Binding MappingTitle}" />
                <Button Grid.Column="1" Classes="secondary-button" Command="{Binding CloseMappingCommand}" Content="关闭" Padding="10,6" />
              </Grid>

              <Border Background="#EFF6FF" CornerRadius="8" IsVisible="{Binding IsMappingLoading}" Padding="12">
                <TextBlock Foreground="#315EA8" Text="正在加载站点映射..." />
              </Border>
              <Border Background="#FEE2E2" CornerRadius="8" IsVisible="{Binding HasMappingError}" Padding="12">
                <TextBlock Foreground="#B91C1C" Text="{Binding MappingErrorMessage}" TextWrapping="Wrap" />
              </Border>
              <Border Background="#E8F7EA" CornerRadius="8" IsVisible="{Binding HasMappingMessage}" Padding="12">
                <TextBlock Foreground="#166534" Text="{Binding MappingMessage}" TextWrapping="Wrap" />
              </Border>

              <StackPanel IsVisible="{Binding HasMappingRows}" Spacing="8">
                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#334155" Text="已关联站点" />
                <ItemsControl ItemsSource="{Binding MappingDetail.SiteMappings}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8" Padding="12">
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="10">
                          <StackPanel Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock FontWeight="SemiBold" Foreground="#1E293B" Text="{Binding SiteName}" />
                              <Border Background="#FEE2E2" CornerRadius="10" IsVisible="{Binding IsDisabled}" Padding="7,2">
                                <TextBlock FontSize="11" Foreground="#B91C1C" Text="{Binding StatusText}" />
                              </Border>
                            </StackPanel>
                            <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding RemoteModelName}" TextWrapping="Wrap" />
                          </StackPanel>
                          <Button Grid.Column="1" Classes="secondary-button" Click="ConfirmDeleteMapping" Content="删除" Padding="9,5" />
                          <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="Auto,100,Auto" ColumnSpacing="8">
                            <TextBlock Foreground="#64748B" Text="最大并发" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" Minimum="0" Maximum="100000" Value="{Binding MaxConcurrency, Mode=TwoWay}" Padding="5,2" />
                            <Button Grid.Column="2" Classes="secondary-button" Command="{Binding DataContext.UpdateMappingConcurrencyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="保存" IsEnabled="{Binding DataContext.CanSaveMapping, RelativeSource={RelativeSource AncestorType=UserControl}}" Padding="9,5" />
                          </Grid>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <TextBlock HorizontalAlignment="Center" Foreground="#94A3B8" IsVisible="{Binding ShowNoMappingRows}" Text="暂无关联站点" />

              <Border Background="#F8FAFC" CornerRadius="8" Padding="14">
                <StackPanel Spacing="9">
                  <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#334155" Text="添加站点映射" />
                  <TextBlock FontSize="12" Foreground="#64748B" Text="同一站点可配置站点侧实际使用的模型名称；最大并发为 0 时表示不限制。" TextWrapping="Wrap" />
                  <ComboBox ItemsSource="{Binding MappingDetail.AvailableSites}" SelectedItem="{Binding SelectedMappingSite}" IsEnabled="{Binding CanEditMapping}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBox Classes="form-input" Text="{Binding NewMappingRemoteName}" Watermark="站点上的模型名" />
                  <CheckBox Content="启用映射" IsChecked="{Binding NewMappingEnabled}" />
                  <Button Classes="primary-button" Command="{Binding AddMappingCommand}" Content="添加映射" IsEnabled="{Binding CanAddMapping}" HorizontalContentAlignment="Center" Padding="12,8" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
