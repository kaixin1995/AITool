@page "/Admin/RouteFallback"
@model AITool.Admin.Pages.Admin.RouteFallback.IndexModel
@{
    ViewData["Title"] = "路由回退";
}

<div class="page-header">
    <div>
        <h2 class="page-title">路由回退</h2>
        <p class="page-subtitle">监控路由回退事件，诊断模型站点故障与降级情况</p>
    </div>
</div>

<div id="routeFallbackStatus" class="alert" style="display:none;"></div>

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>筛选条件</span>
        <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" id="autoRefreshToggle" checked>
            <label class="form-check-label" for="autoRefreshToggle">自动刷新</label>
        </div>
    </div>
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-sm-6 col-lg-3">
                <label class="form-label" for="modelKeywordInput">模型关键字</label>
                <input id="modelKeywordInput" type="text" class="form-control" placeholder="按模型名筛选" />
            </div>
            <div class="col-sm-6 col-lg-3">
                <label class="form-label" for="reasonKeywordInput">回退原因</label>
                <input id="reasonKeywordInput" type="text" class="form-control" placeholder="按原因筛选" />
            </div>
            <div class="col-sm-12 col-lg-3">
                <button type="button" class="btn btn-primary" onclick="loadRouteFallbackList(1)">查询</button>
                <button type="button" class="btn btn-outline-secondary ms-2" onclick="resetFilters()">重置</button>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-secondary small">回退总数</div>
                <div id="summaryTotalCount" class="fs-4 fw-semibold">@Model.InitialTotalCount</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-secondary small">涉及源站点</div>
                <div id="summaryUniqueFromSites" class="fs-4 fw-semibold">@Model.InitialUniqueFromSites</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-secondary small">涉及目标站点</div>
                <div id="summaryUniqueToSites" class="fs-4 fw-semibold">@Model.InitialUniqueToSites</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-secondary small">最近回退时间</div>
                <div id="summaryLatestOccurredAt" class="fs-4 fw-semibold">@(Model.InitialLatestOccurredAt.HasValue ? Model.InitialLatestOccurredAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") : "-")</div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th style="width:180px;">发生时间</th>
                        <th style="width:130px;">请求模型</th>
                        <th style="width:160px;">源站点</th>
                        <th style="width:40px;"></th>
                        <th style="width:160px;">目标站点</th>
                        <th>回退原因</th>
                    </tr>
                </thead>
                <tbody id="fallbackTableBody">
                    <tr>
                        <td colspan="6" class="text-center text-secondary py-4">
                            <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                            加载中...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer d-flex justify-content-between align-items-center">
        <div id="paginationInfo" class="text-secondary small"></div>
        <div id="paginationControls"></div>
    </div>
</div>

@section Scripts {
<script>
    // 当前页码
    let currentPage = 1;
    // 自动刷新定时器标识
    let autoRefreshTimer = null;
    // 自动刷新间隔（毫秒）
    const autoRefreshInterval = 5000;

    /**
     * HTML 特殊字符转义，防止 XSS。
     */
    function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.appendChild(document.createTextNode(text));
        return div.innerHTML;
    }

    /**
     * 格式化 ISO 时间字符串为本地可读格式。
     */
    function formatTime(isoString) {
        if (!isoString) return '-';
        try {
            const d = new Date(isoString);
            return d.toLocaleString('zh-CN', {
                year: 'numeric', month: '2-digit', day: '2-digit',
                hour: '2-digit', minute: '2-digit', second: '2-digit'
            });
        } catch {
            return isoString;
        }
    }

    /**
     * 将 Guid 截取前 8 位显示，悬停显示完整值。
     */
    function renderShortGuid(guid) {
        if (!guid) return '-';
        const short = guid.substring(0, 8);
        return `<span title="${escapeHtml(guid)}">${escapeHtml(short)}…</span>`;
    }

    /**
     * 渲染站点信息：模型名 + 短 Guid。
     */
    function renderSite(modelName, siteId) {
        return `${escapeHtml(modelName || '-')} <small class="text-secondary">(${renderShortGuid(siteId)})</small>`;
    }

    /**
     * 渲染回退原因，过长时截断。
     */
    function renderReason(reason) {
        if (!reason) return '-';
        const escaped = escapeHtml(reason);
        if (escaped.length > 100) {
            return `<span title="${escaped}">${escaped.substring(0, 100)}…</span>`;
        }
        return escaped;
    }

    /**
     * 从页面表单获取筛选参数。
     */
    function getFilterParams() {
        return {
            modelKeyword: document.getElementById('modelKeywordInput').value.trim(),
            reasonKeyword: document.getElementById('reasonKeywordInput').value.trim()
        };
    }

    /**
     * 加载路由回退事件列表。
     * 通过 AJAX 调用 PageModel 的 OnGetListAsync 处理方法。
     */
    async function loadRouteFallbackList(page) {
        if (page === undefined) page = currentPage;
        currentPage = page;

        const filters = getFilterParams();
        const params = new URLSearchParams({
            page: page,
            pageSize: 20,
            modelKeyword: filters.modelKeyword,
            reasonKeyword: filters.reasonKeyword
        });

        try {
            const response = await fetch(`@Url.Page("./Index", "List")&${params.toString()}`);
            if (!response.ok) throw new Error(`HTTP ${response.status}`);
            const data = await response.json();
            renderTable(data);
            renderPagination(data);
        } catch (err) {
            document.getElementById('fallbackTableBody').innerHTML =
                `<tr><td colspan="6" class="text-center text-danger py-4">加载失败: ${escapeHtml(err.message)}</td></tr>`;
        }
    }

    /**
     * 根据返回数据渲染表格行。
     */
    function renderTable(data) {
        const tbody = document.getElementById('fallbackTableBody');

        if (!data.Items || data.Items.length === 0) {
            tbody.innerHTML = `<tr><td colspan="6" class="text-center text-secondary py-4">暂无回退事件记录</td></tr>`;
            return;
        }

        tbody.innerHTML = data.Items.map(item => `
            <tr>
                <td class="small">${formatTime(item.OccurredAt)}</td>
                <td><code>${escapeHtml(item.RequestModel)}</code></td>
                <td>${renderSite(item.FromSiteModelName, item.FromSiteId)}</td>
                <td class="text-secondary">→</td>
                <td>${renderSite(item.ToSiteModelName, item.ToSiteId)}</td>
                <td>${renderReason(item.Reason)}</td>
            </tr>
        `).join('');
    }

    /**
     * 渲染分页信息与控制按钮。
     */
    function renderPagination(data) {
        const info = document.getElementById('paginationInfo');
        const controls = document.getElementById('paginationControls');

        if (data.TotalCount === 0) {
            info.textContent = '共 0 条记录';
            controls.innerHTML = '';
            return;
        }

        const start = (data.Page - 1) * data.PageSize + 1;
        const end = Math.min(data.Page * data.PageSize, data.TotalCount);
        info.textContent = `第 ${start}-${end} 条，共 ${data.TotalCount} 条`;

        let html = '<nav><ul class="pagination pagination-sm mb-0">';
        html += `<li class="page-item ${data.Page <= 1 ? 'disabled' : ''}">
            <a class="page-link" href="#" onclick="loadRouteFallbackList(${data.Page - 1}); return false;">&laquo;</a></li>`;

        // 显示页码按钮，最多显示 5 页
        const maxVisible = 5;
        let startPage = Math.max(1, data.Page - Math.floor(maxVisible / 2));
        let endPage = Math.min(data.TotalPages, startPage + maxVisible - 1);
        startPage = Math.max(1, endPage - maxVisible + 1);

        for (let i = startPage; i <= endPage; i++) {
            html += `<li class="page-item ${i === data.Page ? 'active' : ''}">
                <a class="page-link" href="#" onclick="loadRouteFallbackList(${i}); return false;">${i}</a></li>`;
        }

        html += `<li class="page-item ${data.Page >= data.TotalPages ? 'disabled' : ''}">
            <a class="page-link" href="#" onclick="loadRouteFallbackList(${data.Page + 1}); return false;">&raquo;</a></li>`;
        html += '</ul></nav>';

        controls.innerHTML = html;
    }

    /**
     * 刷新摘要统计卡片。
     */
    async function refreshSummary() {
        try {
            const response = await fetch('@Url.Page("./Index", "Summary")');
            if (!response.ok) return;
            const data = await response.json();
            document.getElementById('summaryTotalCount').textContent = data.TotalCount;
            document.getElementById('summaryUniqueFromSites').textContent = data.UniqueFromSites;
            document.getElementById('summaryUniqueToSites').textContent = data.UniqueToSites;

            const latestEl = document.getElementById('summaryLatestOccurredAt');
            if (data.LatestOccurredAt) {
                latestEl.textContent = formatTime(data.LatestOccurredAt);
            } else {
                latestEl.textContent = '-';
            }
        } catch {
            // 摘要刷新失败不影响主流程
        }
    }

    /**
     * 重置筛选条件并重新加载。
     */
    function resetFilters() {
        document.getElementById('modelKeywordInput').value = '';
        document.getElementById('reasonKeywordInput').value = '';
        loadRouteFallbackList(1);
    }

    /**
     * 启动或停止自动刷新。
     */
    function setupAutoRefresh() {
        const toggle = document.getElementById('autoRefreshToggle');
        toggle.addEventListener('change', function () {
            if (this.checked) {
                startAutoRefresh();
            } else {
                stopAutoRefresh();
            }
        });
        // 默认开启自动刷新
        startAutoRefresh();
    }

    function startAutoRefresh() {
        stopAutoRefresh();
        autoRefreshTimer = setInterval(() => {
            loadRouteFallbackList();
            refreshSummary();
        }, autoRefreshInterval);
    }

    function stopAutoRefresh() {
        if (autoRefreshTimer) {
            clearInterval(autoRefreshTimer);
            autoRefreshTimer = null;
        }
    }

    // 页面初始化
    document.addEventListener('DOMContentLoaded', function () {
        loadRouteFallbackList(1);
        setupAutoRefresh();
    });
</script>
}
