<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Workstation GC（覆盖 Web SDK 的 Server GC 默认值）：小内存部署（2核4G）实测
         托管堆仅 ~62MB 而 RSS 460MB，Server GC 每核一堆、已提交内存不主动归还是大头；
         本服务 CPU 利用率 <1%，远达不到 Server GC 有吞吐优势的量级（8核+/持续数百MB/s分配率）。
         若未来迁移到多核大内存机器且 CPU 成为瓶颈，改回 true 即可。 -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!-- GC 堆硬上限见 runtimeconfig.template.json（SDK 不透传 GCHeapHardLimit 的 MSBuild 属性，
         模板内容会合并进构建产物 runtimeconfig.json——随程序走、换机器不依赖环境变量）：
         实测托管堆活对象 31-62MB，256MB 是 4-8 倍余量；逼近上限时 GC 会积极完整回收并
         decommit 段内存，把"分配历史留下的水位"压回来。单机如需临时覆盖可用
         DOTNET_GCHeapHardLimit 环境变量。 -->
    <!-- 只生成 zh-Hans 的语言资源 -->
    <SatelliteResourceLanguages>zh</SatelliteResourceLanguages>
    <Version>1.0.1.22</Version>
    <AssemblyVersion>1.0.1.22</AssemblyVersion>
    <FileVersion>1.0.1.22</FileVersion>
    <!-- 编译时间戳注入到程序集元数据（AssemblyMetadata），供运行时读取展示，
         避免单文件/独立发布下读取 dll 文件时间戳失效 -->
    <BuildTimestamp>$([System.DateTime]::UtcNow.ToString("O"))</BuildTimestamp>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="BuildTimestamp" Value="$(BuildTimestamp)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AITool.Admin.IntegrationTests" />
    <InternalsVisibleTo Include="AITool.ApplicationTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AITool.Application\AITool.Application.csproj" />
    <ProjectReference Include="..\AITool.Infrastructure\AITool.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.8" />
    <PackageReference Include="NLog.Web.AspNetCore" Version="6.0.5" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.7.3" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="model-vendor-catalog.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Update="client-header-profiles.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Update="model-pricing.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
