@page
@model AITool.Web.Pages.IndexModel
@{
    ViewData["Title"] = "代理服务";
}
<div class="welcome-banner">
    <h1>AI Tool 代理服务运行中</h1>
    <p>管理后台已迁移至 Admin 宿主，此页面仅展示代理运行状态。</p>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="stat-card" style="cursor:default;">
            <div class="stat-card-icon success">✅</div>
            <div class="stat-card-value">@Model.ActiveRouteCount</div>
            <div class="stat-card-label">活跃路由规则</div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="stat-card" style="cursor:default;">
            <div class="stat-card-icon primary">🔗</div>
            <div class="stat-card-value">@Model.ActiveSiteCount</div>
            <div class="stat-card-label">启用站点</div>
        </div>
    </div>
</div>
