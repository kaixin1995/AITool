@page
@model AITool.Web.Pages.Admin.Codex.InspectionModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Codex 巡检</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            min-height: 100%;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background: #f7f4ef;
            color: #1f2421;
        }

        .inspection-page {
            width: 100%;
            min-height: 100vh;
            padding: 20px;
            box-sizing: border-box;
        }

        .inspection-shell {
            width: 100%;
            max-width: 100%;
            margin: 0;
        }

        .inspection-main {
            width: 100%;
        }

        .inspection-toolbar {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 16px;
        }

        .inspection-summary-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 16px;
            margin-bottom: 16px;
        }

        .card {
            background: #fbf9f5;
            border: 1px solid #e7e1d7;
            border-radius: 10px;
            box-shadow: 0 1px 3px rgba(196, 97, 47, 0.05);
            margin-bottom: 16px;
            width: 100%;
        }
        .card-title {
            font-size: 14px;
            font-weight: 600;
            color: #1f2421;
            margin-bottom: 12px;
        }
        .card-body {
            padding: 16px;
        }
        .table-wrapper {
            width: 100%;
            overflow-x: auto;
        }
        .table {
            width: 100%;
            font-size: 13px;
            color: #1f2421;
            margin-bottom: 0;
            table-layout: auto;
        }
        .table th {
            font-weight: 600;
            color: #6c757d;
            border-bottom: 2px solid #e7e1d7;
            padding: 8px 12px;
            white-space: nowrap;
        }
        .table td {
            padding: 8px 12px;
            border-bottom: 1px solid #f0ede6;
            vertical-align: middle;
        }
        .table tbody tr:last-child td {
            border-bottom: none;
        }
        .table tbody tr:hover {
            background: rgba(196, 97, 47, 0.02);
        }
        .codex-inspection-logs {
            max-height: 320px;
            overflow-y: auto;
            font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
            font-size: 12px;
            line-height: 1.7;
            color: #7a8599;
            background: rgba(245, 247, 251, 0.6);
            border-radius: 8px;
            padding: 10px 12px;
        }
        .codex-inspection-logs .log-line {
            white-space: pre-wrap;
            word-break: break-word;
        }
        .codex-inspection-logs .log-time {
            color: #9ca3af;
            margin-right: 8px;
        }
        .btn {
            border-radius: 6px;
            font-weight: 500;
        }

        @@media (max-width: 900px) {
            .inspection-summary-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="inspection-page">
        <div class="inspection-shell">
            <div class="inspection-main">
                <div class="inspection-toolbar">
                    <button type="button" class="btn btn-outline-primary btn-sm" id="btnInspectionRun" onclick="runInspection(false)">手动巡检</button>
                    <button type="button" class="btn btn-outline-warning btn-sm" id="btnInspectionForce" onclick="runInspection(true)">真实巡检</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="loadInspectionData()">刷新状态</button>
                </div>

                <div class="inspection-summary-grid">
                    <div class="card">
                        <div class="card-body">
                            <h6 class="card-title">巡检状态</h6>
                            <div id="inspectionStatus" class="text-secondary" style="font-size:13px;">加载中...</div>
                        </div>
                    </div>
                    <div class="card">
                        <div class="card-body">
                            <h6 class="card-title">上次巡检结果</h6>
                            <div id="inspectionSummary" class="text-secondary" style="font-size:13px;">暂无</div>
                        </div>
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-body">
                        <h6 class="card-title">账号明细</h6>
                        <div class="table-wrapper">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>账号</th>
                                        <th>动作</th>
                                        <th>5小时</th>
                                        <th>周</th>
                                        <th>缓存</th>
                                        <th>原因</th>
                                    </tr>
                                </thead>
                                <tbody id="inspectionAccountsBody">
                                    <tr><td colspan="6" class="text-center text-secondary">暂无数据</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title">运行输出</h6>
                        <div id="inspectionLogs" class="codex-inspection-logs"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let inspectionTimer = null;

        // 页面加载时启动
        document.addEventListener('DOMContentLoaded', () => {
            loadInspectionData();
            startInspectionPolling();
        });

        // 页面卸载时停止轮询
        window.addEventListener('beforeunload', stopInspectionPolling);

        // 页面隐藏时停止轮询
        document.addEventListener('visibilitychange', () => {
            if (document.hidden) {
                stopInspectionPolling();
            } else {
                startInspectionPolling();
            }
        });

        function startInspectionPolling() {
            stopInspectionPolling();
            inspectionTimer = setInterval(loadInspectionData, 5000);
        }

        function stopInspectionPolling() {
            if (inspectionTimer) {
                clearInterval(inspectionTimer);
                inspectionTimer = null;
            }
        }

        async function runInspection(force) {
            const btn = force ? document.getElementById('btnInspectionForce') : document.getElementById('btnInspectionRun');
            btn.disabled = true;
            btn.textContent = '运行中...';
            try {
                const r = await fetch(`/api/admin/codex/inspection/run?force=${force}`, { method: 'POST' });
                if (r.ok) {
                    await loadInspectionData();
                } else {
                    alert('启动巡检失败');
                }
            } catch (e) {
                alert('请求异常：' + e.message);
            } finally {
                btn.disabled = false;
                btn.textContent = force ? '真实巡检' : '手动巡检';
            }
        }

        async function loadInspectionData() {
            try {
                const [status, lastRun, logs] = await Promise.all([
                    fetch('/api/admin/codex/inspection/status').then(r => r.json()),
                    fetch('/api/admin/codex/inspection/last-run').then(r => r.json()),
                    fetch('/api/admin/codex/inspection/logs').then(r => r.json()),
                ]);
                renderInspectionStatus(status);
                renderInspectionSummary(lastRun);
                renderInspectionAccounts(lastRun);
                renderInspectionLogs(logs);
            } catch (e) {
                console.error('加载巡检数据失败', e);
            }
        }

        function renderInspectionStatus(status) {
            const el = document.getElementById('inspectionStatus');
            const isRunning = status.isRunning ? '<span class="badge bg-primary">运行中</span>' : '<span class="badge bg-secondary">空闲</span>';
            const nextRun = status.nextScheduledAt ? `下次调度：${formatTime(status.nextScheduledAt)}` : '';
            const lastCompleted = status.lastCompletedAt ? `上次完成：${formatTime(status.lastCompletedAt)}` : '';
            el.innerHTML = `${isRunning}<br>${nextRun}<br>${lastCompleted}`;
        }

        function renderInspectionSummary(lastRun) {
            const el = document.getElementById('inspectionSummary');
            if (!lastRun || !lastRun.accounts || lastRun.accounts.length === 0) {
                el.textContent = '暂无';
                return;
            }
            const actions = {
                enabled: lastRun.accounts.filter(a => a.action === 'Enabled').length,
                disabled: lastRun.accounts.filter(a => a.action === 'Disabled').length,
                skipped: lastRun.accounts.filter(a => a.action === 'Skipped').length,
            };
            el.innerHTML = `共 ${lastRun.accounts.length} 个账号<br>启用：${actions.enabled}，禁用：${actions.disabled}，跳过：${actions.skipped}`;
        }

        function renderInspectionAccounts(lastRun) {
            const tbody = document.getElementById('inspectionAccountsBody');
            if (!lastRun || !lastRun.accounts || lastRun.accounts.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" class="text-center text-secondary">暂无数据</td></tr>';
                return;
            }
            tbody.innerHTML = lastRun.accounts.map(a => {
                const actionBadge = a.action === 'Enabled' ? '<span class="badge bg-success">启用</span>' :
                                   a.action === 'Disabled' ? '<span class="badge bg-danger">禁用</span>' :
                                   '<span class="badge bg-secondary">跳过</span>';
                const fiveHour = a.fiveHourUsedPercent != null ? a.fiveHourUsedPercent.toFixed(1) + '%' : '—';
                const weekly = a.weeklyUsedPercent != null ? a.weeklyUsedPercent.toFixed(1) + '%' : '—';
                const cached = a.wasCached ? '✓' : '✗';
                return `<tr>
                    <td>${escapeHtml(a.accountName)}</td>
                    <td>${actionBadge}</td>
                    <td>${fiveHour}</td>
                    <td>${weekly}</td>
                    <td>${cached}</td>
                    <td>${escapeHtml(a.reason || '—')}</td>
                </tr>`;
            }).join('');
        }

        function renderInspectionLogs(logs) {
            const el = document.getElementById('inspectionLogs');
            if (!logs || logs.length === 0) {
                el.innerHTML = '<div class="text-secondary">暂无日志</div>';
                return;
            }
            el.innerHTML = logs.map(log => {
                const time = log.timestamp ? formatTime(log.timestamp) : '';
                return `<div class="log-line"><span class="log-time">${time}</span>${escapeHtml(log.message)}</div>`;
            }).join('');
            el.scrollTop = el.scrollHeight;
        }

        function formatTime(s) {
            if (!s) return '—';
            try {
                return new Date(s).toLocaleString();
            } catch {
                return s;
            }
        }

        function escapeHtml(s) {
            return String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
        }
    </script>
</body>
</html>
