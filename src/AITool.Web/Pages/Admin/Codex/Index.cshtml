@page
@model AITool.Web.Pages.Admin.Codex.IndexModel
@{
    ViewData["Title"] = "Codex 账号";
}

<style>
    /* 卡片网格 + 进度条样式，移植自 codex-patrol wwwroot/css/app.css */
    .codex-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: 18px;
        margin-top: 16px;
    }
    .codex-card {
        background: #fbf9f5;
        border: 1px solid #e7e1d7;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 2px 8px rgba(196, 97, 47, 0.06);
        display: flex;
        flex-direction: column;
        transition: all 0.2s ease;
    }
    .codex-card:hover {
        box-shadow: 0 4px 16px rgba(196, 97, 47, 0.12);
        border-color: #d4c5b4;
    }
    
    /* 导出模式 */
    .codex-card {
        position: relative;
    }
    .codex-export-checkbox {
        display: none;
        position: absolute;
        top: 16px;
        left: 16px;
        width: 20px;
        height: 20px;
        cursor: pointer;
        z-index: 10;
        accent-color: #C4612F;
    }
    .export-mode .codex-export-checkbox {
        display: block;
    }
    .export-mode .codex-card {
        cursor: pointer;
        padding-left: 48px;
    }
    .export-mode .codex-card.selected {
        border-color: #C4612F;
        box-shadow: 0 0 0 3px rgba(196, 97, 47, 0.15);
        background: rgba(196, 97, 47, 0.02);
    }
    
    .codex-card-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 16px;
        padding-bottom: 12px;
        border-bottom: 1px solid #e7e1d7;
    }
    .codex-card-header-main { min-width: 0; flex: 1; }
    .codex-account-name {
        font-weight: 700;
        font-size: 15px;
        line-height: 1.45;
        color: #1f2421;
        word-break: break-all;
    }
    .codex-account-email {
        font-size: 12px;
        color: #6c757d;
        margin-top: 4px;
        word-break: break-all;
    }
    .codex-badges {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
        margin-top: 8px;
    }
    .codex-plan {
        flex-shrink: 0;
        font-size: 11px;
        padding: 3px 10px;
        border-radius: 12px;
        background: #f2e3d6;
        color: #c4612f;
        font-weight: 500;
    }
    /* 单个额度窗口：label | bar | percent 三列网格，保证多窗口进度条对齐 */
    .codex-window {
        display: grid;
        grid-template-columns: 92px minmax(0, 1fr) 56px;
        column-gap: 12px;
        row-gap: 6px;
        align-items: center;
        padding: 10px 0 12px;
        border-bottom: 1px solid #f3f4f6;
    }
    .codex-window:last-child { border-bottom: none; }
    .codex-window-label {
        min-width: 0;
        font-size: 13px;
        color: var(--text-secondary, #7a8599);
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
    }
    .codex-window-bar {
        min-width: 0;
        height: 6px;
        background: #e5e7eb;
        border-radius: 3px;
        overflow: hidden;
    }
    .codex-window-fill {
        height: 100%;
        border-radius: 3px;
        transition: width 0.3s;
    }
    .codex-window-fill.good { background: #67c23a; }
    .codex-window-fill.warn { background: #e6a23c; }
    .codex-window-fill.bad { background: #ff6b6b; }
    .codex-window-percent {
        font-size: 13px;
        font-weight: 600;
        min-width: 56px;
        text-align: right;
        color: var(--text-color, #1f2a37);
    }
    .codex-window-reset {
        grid-column: 2 / 4;
        min-width: 0;
        font-size: 11px;
        line-height: 1.5;
        color: var(--text-secondary, #7a8599);
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
    }
    
    /* 窗口容器 - 确保即使没有数据也占据空间 */
    .codex-windows-container {
        min-height: 60px;
        margin: 16px 0;
    }
    
    /* 窗口占位符 */
    .codex-window-placeholder {
        padding: 20px;
        text-align: center;
        font-size: 13px;
        color: #9ca3af;
        background: #f9fafb;
        border-radius: 8px;
        border: 1px dashed #e5e7eb;
    }
    
    .codex-card-meta {
        margin-top: 12px;
        padding-top: 16px;
        border-top: 1px solid #e7e1d7;
    }
    .codex-source-meta { 
        display: flex;
        flex-direction: column;
        gap: 4px;
        margin-bottom: 12px;
        font-size: 11px;
        color: #9ca3af;
        line-height: 1.5;
    }
    .codex-source-meta div {
        word-break: break-word;
    }
    .codex-card-actions {
        display: flex;
        gap: 8px;
        justify-content: flex-start;
        align-items: center;
    }
    .codex-card-actions .btn-icon {
        width: 36px;
        height: 36px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #d4c5b4;
        border-radius: 6px;
        background: transparent;
        color: #6c757d;
        cursor: pointer;
        transition: all 0.15s ease;
        flex-shrink: 0;
    }
    .codex-card-actions .btn-icon:hover {
        transform: translateY(-1px);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        border-color: #C4612F;
        color: #C4612F;
    }
    .codex-card-actions .btn-icon.btn-primary {
        color: #C4612F;
        border-color: #C4612F;
    }
    .codex-card-actions .btn-icon.btn-primary:hover {
        background: #C4612F;
        color: #fff;
    }
    .codex-card-actions .btn-icon.btn-info {
        color: #0ea5e9;
        border-color: #bae6fd;
    }
    .codex-card-actions .btn-icon.btn-info:hover {
        background: #0ea5e9;
        border-color: #0ea5e9;
        color: #fff;
    }
    .codex-card-actions .btn-icon.btn-danger {
        color: #dc2626;
        border-color: #fecaca;
    }
    .codex-card-actions .btn-icon.btn-danger:hover {
        background: #dc2626;
        border-color: #dc2626;
        color: #fff;
    }
    .codex-card-actions .btn-icon svg {
        display: block;
    }
    .codex-account-name {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }
    .codex-empty {
        grid-column: 1 / -1;
        padding: 48px 0;
        text-align: center;
        color: var(--text-secondary, #7a8599);
    }
    .codex-hint-error { color: #dc2626; font-size: 13px; padding: 8px 0; }
    /* 暗夜模式适配 */
    [data-theme="dark"] .codex-card,
    body.theme-dark .codex-card {
        background: rgba(40, 44, 52, 0.96);
        border-color: rgba(255, 255, 255, 0.08);
    }
    [data-theme="dark"] .codex-window,
    body.theme-dark .codex-window { border-bottom-color: rgba(255, 255, 255, 0.06); }
    [data-theme="dark"] .codex-window-bar,
    body.theme-dark .codex-window-bar { background: rgba(255, 255, 255, 0.12); }

    /* Reset credits 小字提示 */
    .codex-reset-credits-hint {
        display: inline-block;
        margin-left: 8px;
        font-size: 11px;
        color: #6c757d;
        cursor: pointer;
        text-decoration: underline dotted;
        user-select: none;
    }
    .codex-reset-credits-hint:hover { color: #0d6efd; }
</style>

<div class="page-header">
    <div>
        <h2 class="page-title">OAuth 管理</h2>
        <p class="page-subtitle">管理 Codex OAuth 登录账号、凭证导入、额度、巡检与自动禁用</p>
    </div>
</div>

<!-- Tab 导航 -->
<ul class="nav nav-tabs mb-3" id="codexTab" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="quota-tab" data-bs-toggle="tab" data-bs-target="#quota-pane" type="button" role="tab">账号额度</button>
    </li>
    @if (Model.InspectionEnabled)
    {
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="inspection-tab" data-bs-toggle="tab" data-bs-target="#inspection-pane" type="button" role="tab">巡检</button>
        </li>
    }
</ul>

<div class="tab-content">
    <!-- Tab 1：账号额度 -->
    <div class="tab-pane fade show active" id="quota-pane" role="tabpanel">
        <div class="d-flex justify-content-end gap-2 mb-3">
            <button type="button" class="btn btn-outline-secondary" onclick="toggleExportMode()">
                <span id="exportModeText">导出凭证</span>
            </button>
            <button type="button" class="btn btn-primary" onclick="openOAuthModal()">＋ OAuth 登录</button>
            <button type="button" class="btn btn-outline-primary" onclick="openImportModal()">上传凭证</button>
        </div>
        <div id="exportToolbar" style="display:none;margin-bottom:16px;padding:12px;background:#fff3cd;border-radius:8px;border:1px solid #ffc107;">
            <div style="display:flex;align-items:center;gap:12px;">
                <span style="font-weight:600;color:#856404;">已选中 <span id="selectedCount">0</span> 个账号</span>
                <button type="button" class="btn btn-sm btn-warning" onclick="exportSelectedCredentials()">下载凭证 JSON</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="cancelExportMode()">取消</button>
            </div>
        </div>
        <div id="accountsContainer" class="codex-grid">
            <div class="codex-empty">加载中...</div>
        </div>
    </div>

    @if (Model.InspectionEnabled)
    {
        <!-- Tab 2：巡检 -->
        <div class="tab-pane fade" id="inspection-pane" role="tabpanel">
            <iframe src="/Admin/Codex/Inspection" style="width:100%;height:800px;border:none;border-radius:8px;"></iframe>
        </div>
    }
</div>

<!-- OAuth 登录 Modal -->
<div class="modal fade" id="oauthModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Codex OAuth 登录</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">账号显示名称（可选）</label>
                    <input type="text" id="oauthDisplayName" class="form-control" placeholder="留空则用邮箱" />
                </div>
                <button type="button" class="btn btn-primary mb-3" id="btnStartOAuth" onclick="startOAuth()">开始登录</button>

                <div id="oauthUrlBox" style="display:none;">
                    <div class="alert alert-info">
                        <div style="font-weight:600;">操作步骤：</div>
                        <ol class="mb-0 mt-2" style="font-size:13px;">
                            <li>点击下方链接，在<span style="font-weight:600;">新标签页</span>中登录 OpenAI 账号。</li>
                            <li>登录后浏览器会跳转到 <code>http://localhost:1455/...</code>，页面会显示「无法访问」—— 这是<span style="font-weight:600;">正常现象</span>。</li>
                            <li>复制浏览器地址栏的<span style="font-weight:600;">完整 URL</span>，粘贴到下方输入框。</li>
                            <li>点击「完成登录」。</li>
                        </ol>
                    </div>
                    <label class="form-label">授权链接</label>
                    <div class="input-group mb-3">
                        <input type="text" id="oauthUrl" class="form-control" readonly />
                        <button type="button" class="btn btn-outline-secondary" onclick="copyOAuthUrl()">复制</button>
                        <a id="oauthUrlLink" href="#" target="_blank" class="btn btn-outline-primary">打开</a>
                    </div>
                    <label class="form-label">粘贴登录后跳转的完整 URL</label>
                    <textarea id="callbackUrlInput" class="form-control" rows="3" placeholder="http://localhost:1455/auth/callback?code=...&state=..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary" id="btnCompleteOAuth" onclick="completeOAuth()">完成登录</button>
            </div>
        </div>
    </div>
</div>

<!-- 上传凭证 Modal -->
<div class="modal fade" id="importModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">上传 Codex 凭证</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-secondary" style="font-size:13px;">支持 CPA 格式 JSON（type=codex，含 access_token/refresh_token/id_token）。可上传多个文件，或直接粘贴 JSON 文本。</p>
                <label class="form-label">选择文件（可多选）</label>
                <input type="file" id="credentialFile" class="form-control mb-3" multiple accept=".json,application/json" />

                <label class="form-label">或粘贴 JSON 文本</label>
                <textarea id="credentialText" class="form-control" rows="6" placeholder='{"type":"codex","access_token":"...","refresh_token":"...","id_token":"..."}'></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary" onclick="submitImport()">导入</button>
            </div>
        </div>
    </div>
</div>

<!-- 编辑 Modal -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">编辑 Codex 账号</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editId" />
                <div class="mb-3">
                    <label class="form-label">显示名称</label>
                    <input type="text" id="editDisplayName" class="form-control" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary" onclick="submitEdit()">保存</button>
            </div>
        </div>
    </div>
</div>

<!-- Reset Credits Modal -->
<div class="modal fade" id="resetCreditsModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">手动重置额度</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-3">当前账号：<strong id="resetCreditsAccountName"></strong></p>
                <p class="mb-3">剩余可用重置次数：<strong id="resetCreditsAvailableCount">-</strong></p>
                <div id="resetCreditsListContainer" style="display:none;">
                    <h6>各次重置过期时间（北京时间 GMT+8）</h6>
                    <div id="resetCreditsList" style="max-height:240px;overflow-y:auto;"></div>
                </div>
                <div id="resetCreditsError" class="alert alert-danger" style="display:none;"></div>
                <div id="resetCreditsLoading" class="text-center text-secondary">加载中...</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">关闭</button>
                <button type="button" class="btn btn-danger" id="btnExecuteReset" onclick="executeResetCredit()" disabled>执行重置</button>
            </div>
        </div>
    </div>
</div>

<!-- Codex 模型选择 Modal -->
<div class="modal fade" id="codexModelSelectModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="codexModalTitle">选择要导入的模型</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="codexModalLoading" class="text-center py-4">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2 text-secondary">正在拉取模型列表...</p>
                </div>
                <div id="codexModalToolbar" style="display:none;">
                    <div id="codexModalErrorBox" class="alert alert-danger" style="display:none;">
                        <div>拉取失败</div>
                        <pre id="codexModalErrorText" style="margin:8px 0 0;white-space:pre-wrap;word-break:break-word;font-size:12px;"></pre>
                    </div>
                    <div class="d-flex gap-2 align-items-center mb-3">
                        <input type="text" id="codexModalSearch" class="form-control form-control-sm" placeholder="搜索模型名称..." style="max-width:300px;" />
                        <span id="codexModalSelectedCount" class="text-secondary" style="font-size:13px;white-space:nowrap;">已选 0 个</span>
                        <div class="form-check ms-auto">
                            <input type="checkbox" id="codexModalSelectAll" class="form-check-input" onchange="updateCodexSelectAllState()" />
                            <label for="codexModalSelectAll" class="form-check-label" style="font-size:13px;">全选</label>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2 py-1 border-bottom" style="font-size:12px;color:var(--text-secondary);font-weight:600;">
                        <div style="width:30px;"></div>
                        <div style="flex:1;">远程模型名</div>
                        <div style="width:200px;">显示别名</div>
                    </div>
                </div>
                <div id="codexModelListContainer"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" id="btnImportCodexSelected" class="btn btn-primary" onclick="submitCodexImport()">导入选中模型</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let codexAccounts = [];
    let oauthState = null;

    document.addEventListener('DOMContentLoaded', () => {
        // 支持 URL 参数切换 tab：?tab=inspection
        const urlParams = new URLSearchParams(window.location.search);
        const tab = urlParams.get('tab');
        if (tab === 'inspection') {
            const inspectionTab = document.getElementById('inspection-tab');
            const inspectionPane = document.getElementById('inspection-pane');
            const quotaTab = document.getElementById('quota-tab');
            const quotaPane = document.getElementById('quota-pane');
            
            if (inspectionTab && inspectionPane && quotaTab && quotaPane) {
                quotaTab.classList.remove('active');
                quotaPane.classList.remove('show', 'active');
                inspectionTab.classList.add('active');
                inspectionPane.classList.add('show', 'active');
            }
        }
        
        loadAccounts();
        
        // 账号额度 Tab 可见时，每 10 秒局部刷新数据
        let quotaPollTimer = null;
        const quotaPane = document.getElementById('quota-pane');
        const quotaTab = document.getElementById('quota-tab');
        
        function startQuotaPolling() {
            stopQuotaPolling();
            quotaPollTimer = setInterval(partialRefreshAccounts, 10000);
        }
        function stopQuotaPolling() {
            if (quotaPollTimer) { clearInterval(quotaPollTimer); quotaPollTimer = null; }
        }
        
        if (quotaTab) {
            quotaTab.addEventListener('shown.bs.tab', startQuotaPolling);
            quotaTab.addEventListener('hidden.bs.tab', stopQuotaPolling);
        }
        // 页面隐藏时暂停
        document.addEventListener('visibilitychange', () => {
            if (document.hidden) { stopQuotaPolling(); }
            else if (quotaPane && quotaPane.classList.contains('active')) { startQuotaPolling(); }
        });
        
        // 默认在账号额度 Tab 时启动
        if (quotaPane && quotaPane.classList.contains('active')) { startQuotaPolling(); }
    });

    // 局部刷新：只更新数值变化的部分，不重建整个 DOM
    async function partialRefreshAccounts() {
        try {
            const r = await fetch('/api/admin/codex/accounts');
            if (!r.ok) return;
            const fresh = await r.json();
            
            // 对比并更新每个卡片的数值
            fresh.forEach(freshAccount => {
                const oldAccount = codexAccounts.find(a => a.id === freshAccount.id);
                if (!oldAccount) return; // 新账号，跳过（下次全量渲染会带上）
                
                const card = document.querySelector(`.codex-card[data-id="${freshAccount.id}"]`);
                if (!card) return;
                
                // 更新额度窗口进度条和百分比
                if (JSON.stringify(oldAccount.windows) !== JSON.stringify(freshAccount.windows)) {
                    const container = card.querySelector('.codex-windows-container');
                    if (container && freshAccount.windows && freshAccount.windows.length) {
                        container.innerHTML = freshAccount.windows.map(w => {
                            const usedPercent = w.usedPercent ?? 0;
                            const remainingPercent = Math.max(0, 100 - usedPercent);
                            const tone = remainingPercent < 20 ? 'bad' : remainingPercent < 50 ? 'warn' : 'good';
                            const label = w.label || '-';
                            const resetLabel = w.resetLabel || '-';
                            const percentText = (w.usedPercent !== null && w.usedPercent !== undefined) ? remainingPercent.toFixed(1) + '%' : '--';
                            return `<div class="codex-window">
                                <div class="codex-window-label" title="${escapeHtml(label)}">${escapeHtml(label)}</div>
                                <div class="codex-window-bar"><div class="codex-window-fill ${tone}" style="width:${Math.min(remainingPercent, 100)}%"></div></div>
                                <div class="codex-window-percent">${percentText}</div>
                                <div class="codex-window-reset" title="${escapeHtml(resetLabel)}">${escapeHtml(resetLabel)}</div>
                            </div>`;
                        }).join('');
                    }
                }
                
                // 更新剩余重置次数小字
                const hintEl = card.querySelector('.codex-reset-credits-hint');
                if (hintEl) {
                    const newText = freshAccount.resetCreditsAvailableCount > 0
                        ? `剩余 ${freshAccount.resetCreditsAvailableCount} 次手动重置`
                        : '';
                    if (hintEl.textContent !== newText) {
                        hintEl.textContent = newText;
                        if (!newText) hintEl.style.display = 'none';
                        else hintEl.style.display = '';
                    }
                }
                
                // 更新状态徽章
                const badgesEl = card.querySelector('.codex-badges');
                if (badgesEl) {
                    const freshStatusBadge = renderStatusBadge(freshAccount);
                    const freshPlanBadge = freshAccount.planType ? `<span class="codex-plan">${escapeHtml(freshAccount.planType)}</span>` : '';
                    const newBadgesHtml = freshStatusBadge + freshPlanBadge;
                    if (badgesEl.innerHTML !== newBadgesHtml) {
                        badgesEl.innerHTML = newBadgesHtml;
                    }
                }
                
                // 更新时间信息
                const metaEl = card.querySelector('.codex-source-meta');
                if (metaEl) {
                    const lastCheck = freshAccount.lastQuotaCheckedAt ? '刷新时间：' + formatTime(freshAccount.lastQuotaCheckedAt) : '';
                    const newMetaHtml = lastCheck ? `<div>${escapeHtml(lastCheck)}</div>` : '';
                    if (metaEl.innerHTML !== newMetaHtml) {
                        metaEl.innerHTML = newMetaHtml;
                    }
                }
                
                // 更新启用/禁用按钮文字
                const toggleBtn = Array.from(card.querySelectorAll('.codex-card-actions .btn-icon')).find(b => b.getAttribute('onclick')?.includes('toggleAccount'));
                if (toggleBtn && oldAccount.isEnabled !== freshAccount.isEnabled) {
                    toggleBtn.innerHTML = freshAccount.isEnabled
                        ? '<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\"></line><line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\"></line></svg>'
                        : '<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"20 6 9 17 4 12\"></polyline></svg>';
                    toggleBtn.title = freshAccount.isEnabled ? '禁用账号' : '启用账号';
                }
            });
            
            // 更新内存数据
            codexAccounts = fresh;
        } catch (e) { /* 静默 */ }
    }

    async function loadAccounts() {
        try {
            const r = await fetch('/api/admin/codex/accounts');
            if (!r.ok) { document.getElementById('accountsContainer').innerHTML = '<div class="codex-empty">加载失败</div>'; return; }
            codexAccounts = await r.json();
            renderAccounts();
        } catch (e) {
            document.getElementById('accountsContainer').innerHTML = '<div class="codex-empty">加载失败：' + escapeHtml(String(e)) + '</div>';
        }
    }

    function renderAccounts() {
        const container = document.getElementById('accountsContainer');
        if (!codexAccounts.length) {
            container.innerHTML = '<div class="codex-empty">暂无 Codex 账号，点击右上角「新增 OAuth 登录」或「上传凭证」</div>';
            return;
        }
        container.innerHTML = codexAccounts.map(renderCard).join('');
    }

    // 渲染单个额度窗口（label | 进度条 | 百分比）
    function renderWindow(w) {
        const usedPercent = w.usedPercent ?? 0;
        const remainingPercent = Math.max(0, 100 - usedPercent);
        
        // 颜色规则：剩余越少越红（剩余 < 20% 红色，< 50% 黄色，>= 50% 绿色）
        const tone = remainingPercent < 20 ? 'bad' : remainingPercent < 50 ? 'warn' : 'good';
        
        const label = w.label || '-';
        const resetLabel = w.resetLabel || '-';
        const percentText = (w.usedPercent !== null && w.usedPercent !== undefined) 
            ? remainingPercent.toFixed(1) + '%' 
            : '--';
        
        return `
        <div class="codex-window">
            <div class="codex-window-label" title="${escapeHtml(label)}">${escapeHtml(label)}</div>
            <div class="codex-window-bar">
                <div class="codex-window-fill ${tone}" style="width:${Math.min(remainingPercent, 100)}%"></div>
            </div>
            <div class="codex-window-percent">${percentText}</div>
            <div class="codex-window-reset" title="${escapeHtml(resetLabel)}">${escapeHtml(resetLabel)}</div>
        </div>`;
    }

    function renderCard(a) {
        const planBadge = a.planType ? `<span class="codex-plan">${escapeHtml(a.planType)}</span>` : '';
        const statusBadge = renderStatusBadge(a);

        // 手动重置次数小字（可点击）
        const resetCreditsHint = a.resetCreditsAvailableCount > 0
            ? `<span class="codex-reset-credits-hint" onclick="openResetCreditsModal('${a.id}', '${escapeHtml(a.displayName)}', event)" title="点击查看详情">剩余 ${a.resetCreditsAvailableCount} 次手动重置</span>`
            : '';

        // 额度窗口区域 - 始终保留区域，即使没有数据
        let windowsHtml = '';
        if (a.windows && a.windows.length) {
            windowsHtml = a.windows.map(renderWindow).join('');
        } else if (!a.lastQuotaCheckedAt) {
            windowsHtml = '<div class="codex-window-placeholder">未刷新额度，点击下方「刷新额度」获取</div>';
        } else {
            windowsHtml = '<div class="codex-window-placeholder">暂无额度窗口数据</div>';
        }

        const lastCheck = a.lastQuotaCheckedAt ? '刷新时间：' + formatTime(a.lastQuotaCheckedAt) : '';

        return `
        <div class="codex-card" data-id="${a.id}" onclick="handleCardClick(event, '${a.id}')">
            <input type="checkbox" class="codex-export-checkbox" data-account-id="${a.id}" onclick="toggleCardSelection(event, '${a.id}')">
            <div class="codex-card-header">
                <div class="codex-card-header-main">
                    <div class="codex-account-name">
                        ${escapeHtml(a.displayName)}
                    </div>
                    <div class="codex-account-email">
                        ${escapeHtml(a.email || '')}
                        ${resetCreditsHint}
                    </div>
                    <div class="codex-badges">
                        ${statusBadge}${planBadge}
                    </div>
                </div>
            </div>
            <div class="codex-windows-container">${windowsHtml}</div>
            <div class="codex-card-meta">
                <div class="codex-source-meta">
                    <div>${escapeHtml(lastCheck)}</div>
                </div>
                <div class="codex-card-actions">
                    <button class="btn btn-icon" onclick="refreshQuota('${a.id}', this)" title="刷新额度">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"></polyline><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path></svg>
                    </button>
                    <button class="btn btn-icon" onclick="toggleAccount('${a.id}')" title="${a.isEnabled ? '禁用账号' : '启用账号'}">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${a.isEnabled ? '<line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line>' : '<polyline points="20 6 9 17 4 12"></polyline>'}</svg>
                    </button>
                    <button class="btn btn-icon btn-primary" onclick="openEditModal('${a.id}')" title="编辑账号">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                    </button>
                    <button class="btn btn-icon btn-info" onclick="openCodexModelModal('${a.id}', '${escapeHtml(a.displayName)}')" title="拉取模型">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                    </button>
                    <button class="btn btn-icon btn-danger" onclick="deleteAccount('${a.id}')" title="删除账号">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                    </button>
                </div>
            </div>
        </div>`;
    }

    function renderStatusBadge(a) {
        if (a.isQuotaCooling) {
            return `<span class="badge bg-warning text-dark">冷却中${a.quotaCoolingUntil ? '·恢复 ' + formatTime(a.quotaCoolingUntil) : ''}</span>`;
        }
        if (!a.isEnabled) {
            return `<span class="badge bg-secondary">已禁用</span>`;
        }
        return `<span class="badge bg-success">正常</span>`;
    }

    // —— OAuth ——
    function openOAuthModal() {
        document.getElementById('oauthDisplayName').value = '';
        document.getElementById('oauthUrlBox').style.display = 'none';
        document.getElementById('callbackUrlInput').value = '';
        new bootstrap.Modal(document.getElementById('oauthModal')).show();
    }

    async function startOAuth() {
        const btn = document.getElementById('btnStartOAuth');
        btn.disabled = true;
        try {
            const r = await fetch('/api/admin/codex/start-oauth', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({})
            });
            const data = await r.json();
            if (!r.ok) { alert(data.message || '启动失败'); return; }
            oauthState = data.state;
            document.getElementById('oauthUrl').value = data.url;
            document.getElementById('oauthUrlLink').href = data.url;
            document.getElementById('oauthUrlBox').style.display = 'block';
        } catch (e) { alert('启动失败：' + e); }
        finally { btn.disabled = false; }
    }

    function copyOAuthUrl() {
        const input = document.getElementById('oauthUrl');
        input.select();
        navigator.clipboard.writeText(input.value).then(() => alert('已复制授权链接'));
    }

    async function completeOAuth() {
        const callbackUrl = document.getElementById('callbackUrlInput').value.trim();
        if (!callbackUrl) { alert('请粘贴登录后浏览器跳转到的完整 URL'); return; }
        const displayName = document.getElementById('oauthDisplayName').value.trim();
        const btn = document.getElementById('btnCompleteOAuth');
        btn.disabled = true;
        try {
            const r = await fetch('/api/admin/codex/complete-oauth', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ callbackUrl, displayName: displayName || null })
            });
            const data = await r.json();
            if (!r.ok) { alert(data.message || '登录失败'); return; }
            bootstrap.Modal.getInstance(document.getElementById('oauthModal')).hide();
            await loadAccounts();
        } catch (e) { alert('登录失败：' + e); }
        finally { btn.disabled = false; }
    }

    // —— 导入 ——
    function openImportModal() {
        document.getElementById('credentialFile').value = '';
        document.getElementById('credentialText').value = '';
        new bootstrap.Modal(document.getElementById('importModal')).show();
    }

    async function submitImport() {
        const fileInput = document.getElementById('credentialFile');
        const textInput = document.getElementById('credentialText').value.trim();
        try {
            if (fileInput.files.length > 0) {
                const fd = new FormData();
                for (const f of fileInput.files) fd.append('files', f);
                return await handleImportResult(await fetch('/api/admin/codex/import-credential', { method: 'POST', body: fd }));
            }
            if (textInput) {
                return await handleImportResult(await fetch('/api/admin/codex/import-credential?name=imported.json', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' }, body: textInput
                }));
            }
            alert('请选择文件或粘贴 JSON');
        } catch (e) { alert('导入失败：' + e); }
    }

    async function handleImportResult(r) {
        const data = await r.json();
        if (r.status === 207 && data.failures && data.failures.length) {
            const failMsgs = data.failures.map(f => (f.fileName || '(文本)') + ': ' + (f.error || '未知')).join('\n');
            alert('部分导入失败：\n' + failMsgs);
        } else if (!r.ok) {
            alert(data.message || '导入失败'); return;
        }
        bootstrap.Modal.getInstance(document.getElementById('importModal')).hide();
        await loadAccounts();
    }

    // —— 操作 ——
    async function refreshQuota(id, btn) {
        const orig = btn.disabled; btn.disabled = true;
        try {
            const r = await fetch(`/api/admin/codex/accounts/${id}/refresh-quota`, { method: 'POST' });
            if (!r.ok) { const e = await r.json(); alert(e.message || '额度查询失败'); return; }
            await loadAccounts();
        } catch (e) { alert('额度查询失败：' + e); }
        finally { btn.disabled = orig; }
    }

    async function toggleAccount(id) {
        const r = await fetch(`/api/admin/codex/accounts/${id}/toggle`, { method: 'POST' });
        if (!r.ok) { const e = await r.json(); alert(e.message || '操作失败'); return; }
        await loadAccounts();
    }

    async function deleteAccount(id) {
        if (!confirm('确认删除该 Codex 账号？\n\n将同时删除关联的隐藏站点、模型映射和路由规则，不可恢复。')) return;
        const r = await fetch(`/api/admin/codex/accounts/${id}`, { method: 'DELETE' });
        if (!r.ok) { const e = await r.json(); alert(e.message || '删除失败'); return; }
        await loadAccounts();
    }

    async function pullModels(id) {
        if (!confirm('从上游拉取该账号的模型目录并追加映射？')) return;
        const r = await fetch(`/api/admin/codex/accounts/${id}/pull-models`, { method: 'POST' });
        const data = await r.json();
        if (!r.ok) { alert(data.message || '拉取失败'); return; }
        alert('已拉取 ' + (data.count || 0) + ' 个模型');
    }

    // —— 编辑 ——
    function openEditModal(id) {
        const a = codexAccounts.find(x => x.id === id);
        if (!a) return;
        document.getElementById('editId').value = id;
        document.getElementById('editDisplayName').value = a.displayName || '';
        new bootstrap.Modal(document.getElementById('editModal')).show();
    }

    async function submitEdit() {
        const id = document.getElementById('editId').value;
        const displayName = document.getElementById('editDisplayName').value.trim();
        const r = await fetch(`/api/admin/codex/accounts/${id}`, {
            method: 'PUT', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ displayName: displayName || null })
        });
        if (!r.ok) { const e = await r.json(); alert(e.message || '保存失败'); return; }
        bootstrap.Modal.getInstance(document.getElementById('editModal')).hide();
        await loadAccounts();
    }

    // —— 巡检 ——
    let inspectionTimer = null;

    // 切到巡检 Tab 时加载；离开时停轮询
    document.addEventListener('DOMContentLoaded', () => {
        const inspectionTab = document.getElementById('inspection-tab');
        if (inspectionTab) {
            inspectionTab.addEventListener('shown.bs.tab', () => {
                loadInspectionData();
                startInspectionPolling();
            });
        }
        const quotaTab = document.getElementById('quota-tab');
        if (quotaTab) {
            quotaTab.addEventListener('shown.bs.tab', stopInspectionPolling);
        }
    });

    function startInspectionPolling() {
        stopInspectionPolling();
        inspectionTimer = setInterval(loadInspectionData, 5000);
    }
    function stopInspectionPolling() {
        if (inspectionTimer) { clearInterval(inspectionTimer); inspectionTimer = null; }
    }

    async function loadInspectionData() {
        try {
            const [status, lastRun, logs] = await Promise.all([
                fetch('/api/admin/codex/inspection/status').then(r => r.ok ? r.json() : null).catch(() => null),
                fetch('/api/admin/codex/inspection/last-run').then(r => r.ok ? r.json() : null).catch(() => null),
                fetch('/api/admin/codex/inspection/logs').then(r => r.ok ? r.json() : null).catch(() => null),
            ]);
            renderInspectionStatus(status);
            renderInspectionSummary(lastRun);
            renderInspectionAccounts(lastRun);
            renderInspectionLogs(logs);
        } catch (e) { /* 静默 */ }
    }

    function renderInspectionStatus(status) {
        const el = document.getElementById('inspectionStatus');
        if (!status) { el.textContent = '加载失败'; return; }
        const running = status.isRunning ? '<span class="badge bg-primary">运行中</span>' : '<span class="badge bg-secondary">空闲</span>';
        const next = status.nextScheduledAt ? formatTime(status.nextScheduledAt) : '—';
        const last = status.lastFinishedAt ? formatTime(status.lastFinishedAt) : '—';
        el.innerHTML = `${running}<br>下次调度：${next}<br>上次完成：${last}<br><span class="text-secondary" style="font-size:12px;">自动巡检周期/开关在 系统设置 → Codex 巡检 配置</span>`;
    }

    function renderInspectionSummary(lastRun) {
        const el = document.getElementById('inspectionSummary');
        if (!lastRun || !lastRun.startedAt) { el.textContent = '暂无'; return; }
        const tone = lastRun.autoTriggered ? '自动' : '手动';
        const force = lastRun.forcedRefresh ? '（强制真实刷新）' : '';
        el.innerHTML = `${tone}巡检${force}<br>` +
            `保留 ${lastRun.keepCount ?? 0} · 禁用 ${lastRun.disableCount ?? 0} · 启用 ${lastRun.enableCount ?? 0}<br>` +
            `缓存命中 ${lastRun.cacheCount ?? 0} · 真实刷新 ${lastRun.realRefreshCount ?? 0}<br>` +
            `<span class="text-secondary" style="font-size:12px;">开始：${formatTime(lastRun.startedAt)} · 完成：${lastRun.finishedAt ? formatTime(lastRun.finishedAt) : '进行中'}</span>`;
    }

    function renderInspectionAccounts(lastRun) {
        const body = document.getElementById('inspectionAccountsBody');
        if (!lastRun || !lastRun.accounts || !lastRun.accounts.length) {
            body.innerHTML = '<tr><td colspan="6" class="text-center text-secondary">暂无数据</td></tr>';
            return;
        }
        body.innerHTML = lastRun.accounts.map(a => {
            const actionBadge = {
                disable: '<span class="badge bg-danger">禁用</span>',
                enable: '<span class="badge bg-success">启用</span>',
                keep: '<span class="badge bg-secondary">保留</span>'
            }[a.action] || a.action;
            const fiveHour = (a.fiveHourUsedPercent !== null && a.fiveHourUsedPercent !== undefined) ? a.fiveHourUsedPercent.toFixed(1) + '%' : '—';
            const weekly = (a.weeklyUsedPercent !== null && a.weeklyUsedPercent !== undefined) ? a.weeklyUsedPercent.toFixed(1) + '%' : '—';
            const cache = a.fromCache ? '<span class="badge bg-info text-dark">缓存</span>' : '<span class="badge bg-light text-dark border">实时</span>';
            return `<tr>
                <td>${escapeHtml(a.displayName)}</td>
                <td>${actionBadge}</td>
                <td>${fiveHour}</td>
                <td>${weekly}</td>
                <td>${cache}</td>
                <td style="font-size:12px;max-width:320px;">${escapeHtml(a.reason || '')}</td>
            </tr>`;
        }).join('');
    }

    function renderInspectionLogs(logs) {
        const el = document.getElementById('inspectionLogs');
        if (!logs || !logs.length) { el.innerHTML = '<div class="text-secondary">暂无日志</div>'; return; }
        el.innerHTML = logs.map(l => {
            return `<div class="log-line"><span class="log-time">[${formatTime(l.at)}]</span>${escapeHtml(l.message)}</div>`;
        }).join('');
    }

    async function runInspection(force) {
        const btnId = force ? 'btnInspectionForce' : 'btnInspectionRun';
        const btn = document.getElementById(btnId);
        if (btn) btn.disabled = true;
        try {
            const r = await fetch(`/api/admin/codex/inspection/run?force=${force}`, { method: 'POST' });
            if (!r.ok) { const e = await r.json(); alert(e.message || '巡检失败'); return; }
            await loadInspectionData();
        } catch (e) { alert('巡检失败：' + e); }
        finally { if (btn) btn.disabled = false; }
    }

    // —— Reset Credits ——
    let currentResetAccountId = null;

    async function openResetCreditsModal(accountId, accountName, event) {
        event.stopPropagation();
        currentResetAccountId = accountId;

        const modal = new bootstrap.Modal(document.getElementById('resetCreditsModal'));
        document.getElementById('resetCreditsAccountName').textContent = accountName;
        document.getElementById('resetCreditsAvailableCount').textContent = '-';
        document.getElementById('resetCreditsList').innerHTML = '';
        document.getElementById('resetCreditsListContainer').style.display = 'none';
        document.getElementById('resetCreditsError').style.display = 'none';
        document.getElementById('resetCreditsLoading').style.display = 'block';
        document.getElementById('btnExecuteReset').disabled = true;

        modal.show();

        try {
            const r = await fetch(`/api/admin/codex/accounts/${accountId}/reset-credits`);
            const data = await r.json();
            document.getElementById('resetCreditsLoading').style.display = 'none';

            if (!r.ok || !data.success) {
                document.getElementById('resetCreditsError').textContent = data.error || '加载失败';
                document.getElementById('resetCreditsError').style.display = 'block';
                return;
            }

            document.getElementById('resetCreditsAvailableCount').textContent = data.availableCount || 0;
            if (data.availableCount > 0) {
                document.getElementById('btnExecuteReset').disabled = false;
            }

            if (data.credits && data.credits.length > 0) {
                document.getElementById('resetCreditsListContainer').style.display = 'block';
                const listHtml = data.credits.map((c, idx) => {
                    const granted = c.grantedAt ? formatBeijingTime(c.grantedAt) : '—';
                    const expires = c.expiresAt ? formatBeijingTime(c.expiresAt) : '—';
                    return `<div style="display:flex;align-items:center;justify-content:space-between;padding:12px 16px;margin-bottom:8px;border-radius:6px;background:#f7f4ef;border:1px solid #e7e1d7;">
                        <div style="flex:1;">
                            <div style="font-size:14px;font-weight:600;color:#1f2421;margin-bottom:4px;">第 ${idx + 1} 次重置</div>
                            <div style="font-size:12px;color:#6c757d;">发放时间：${granted}</div>
                        </div>
                        <div style="text-align:right;">
                            <div style="font-size:11px;color:#6c757d;margin-bottom:2px;">过期时间</div>
                            <div style="font-size:13px;font-weight:600;color:#c4612f;">${expires}</div>
                        </div>
                    </div>`;
                }).join('');
                document.getElementById('resetCreditsList').innerHTML = listHtml;
            }
        } catch (e) {
            document.getElementById('resetCreditsLoading').style.display = 'none';
            document.getElementById('resetCreditsError').textContent = '加载异常：' + e.message;
            document.getElementById('resetCreditsError').style.display = 'block';
        }
    }

    async function executeResetCredit() {
        if (!currentResetAccountId) return;
        if (!confirm('确认消耗一张手动重置额度，执行真实额度重置？此操作不可撤销。')) return;

        const btn = document.getElementById('btnExecuteReset');
        btn.disabled = true;

        try {
            const r = await fetch(`/api/admin/codex/accounts/${currentResetAccountId}/consume-reset-credit`, { method: 'POST' });
            const data = await r.json();
            if (!r.ok) {
                alert(data.message || '执行失败');
                return;
            }
            alert('手动重置额度成功！');
            bootstrap.Modal.getInstance(document.getElementById('resetCreditsModal')).hide();
            await loadAccounts();
        } catch (e) {
            alert('执行异常：' + e.message);
        } finally {
            btn.disabled = false;
        }
    }

    function formatBeijingTime(utcStr) {
        try {
            const d = new Date(utcStr);
            return d.toLocaleString('zh-CN', { timeZone: 'Asia/Shanghai', hour12: false });
        } catch {
            return utcStr;
        }
    }

    // —— Codex Model Selection ——
    let currentCodexAccountId = null;
    let currentCodexModels = [];
    let bsCodexModelModal = null;

    async function openCodexModelModal(accountId, accountName) {
        currentCodexAccountId = accountId;
        currentCodexModels = [];

        if (!bsCodexModelModal) {
            bsCodexModelModal = new bootstrap.Modal(document.getElementById('codexModelSelectModal'));
        }

        document.getElementById('codexModalTitle').textContent = '拉取模型 - ' + accountName;
        document.getElementById('codexModalLoading').style.display = 'block';
        document.getElementById('codexModalToolbar').style.display = 'none';
        document.getElementById('codexModalErrorBox').style.display = 'none';
        document.getElementById('codexModelListContainer').innerHTML = '';

        bsCodexModelModal.show();

        try {
            const r = await fetch(`/api/admin/codex/accounts/${accountId}/fetch-models`);
            const data = await r.json();

            if (data && data.success === false) {
                showCodexModalError(data.message || '拉取失败');
                return;
            }

            currentCodexModels = data.map(m => ({
                remoteModelName: m.remoteModelName,
                displayName: m.displayName || m.remoteModelName,
                existingMappingId: m.existingMappingId,
                isEnabled: m.isEnabled,
                existingDisplayName: m.existingDisplayName
            }));

            renderCodexModelList();
        } catch (e) {
            showCodexModalError(e.message || '拉取失败');
        }
    }

    function renderCodexModelList() {
        document.getElementById('codexModalLoading').style.display = 'none';
        document.getElementById('codexModalToolbar').style.display = '';
        document.getElementById('codexModalSearch').value = '';

        const container = document.getElementById('codexModelListContainer');
        container.innerHTML = '';

        if (currentCodexModels.length === 0) {
            container.innerHTML = '<div class="text-center text-secondary py-3">未拉取到任何模型</div>';
            updateCodexSelectedCount();
            return;
        }

        currentCodexModels.forEach((m, index) => {
            const row = document.createElement('div');
            row.className = 'align-items-center gap-2 py-2 border-bottom codex-model-row';
            row.style.display = 'flex';
            row.setAttribute('data-model-name', m.remoteModelName);
            row.setAttribute('data-index', index);

            const checked = m.existingMappingId ? m.isEnabled : true;
            const displayName = m.existingDisplayName || m.displayName;

            const checkbox = document.createElement('input');
            checkbox.type = 'checkbox';
            checkbox.className = 'codex-model-check';
            checkbox.checked = checked;
            checkbox.style.cssText = 'width:30px;flex-shrink:0;';
            checkbox.onchange = updateCodexSelectedCount;

            const nameCol = document.createElement('code');
            nameCol.style.cssText = 'flex:1;font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;';
            nameCol.title = m.remoteModelName;
            nameCol.textContent = m.remoteModelName;

            const aliasInput = document.createElement('input');
            aliasInput.type = 'text';
            aliasInput.className = 'form-control form-control-sm codex-alias-input';
            aliasInput.value = displayName;
            aliasInput.style.cssText = 'width:200px;flex-shrink:0;';
            aliasInput.placeholder = '显示别名';

            const badge = document.createElement('span');
            badge.className = m.existingMappingId ? (m.isEnabled ? 'badge bg-success' : 'badge bg-secondary') : 'badge bg-light text-dark';
            badge.style.cssText = 'font-size:10px;flex-shrink:0;';
            badge.textContent = m.existingMappingId ? (m.isEnabled ? '已启用' : '已禁用') : '新';

            row.appendChild(checkbox);
            row.appendChild(nameCol);
            row.appendChild(aliasInput);
            row.appendChild(badge);
            container.appendChild(row);
        });

        updateCodexSelectedCount();
        setupCodexModelSearch();
    }

    function setupCodexModelSearch() {
        const searchInput = document.getElementById('codexModalSearch');
        searchInput.oninput = () => {
            const keyword = searchInput.value.toLowerCase();
            document.querySelectorAll('.codex-model-row').forEach(row => {
                const name = row.getAttribute('data-model-name').toLowerCase();
                row.style.display = name.includes(keyword) ? 'flex' : 'none';
            });
            updateCodexSelectedCount();
        };
    }

    function updateCodexSelectedCount() {
        const visible = Array.from(document.querySelectorAll('.codex-model-row')).filter(r => r.style.display !== 'none');
        const total = visible.length;
        const checked = visible.filter(r => r.querySelector('.codex-model-check').checked).length;
        document.getElementById('codexModalSelectedCount').textContent = `已选 ${checked} / ${total} 个`;
        updateCodexSelectAllState();
    }

    function updateCodexSelectAllState() {
        const visible = Array.from(document.querySelectorAll('.codex-model-row')).filter(r => r.style.display !== 'none');
        const checks = visible.map(r => r.querySelector('.codex-model-check'));
        const allChecked = checks.length > 0 && checks.every(c => c.checked);
        const someChecked = checks.some(c => c.checked);
        const selectAll = document.getElementById('codexModalSelectAll');
        selectAll.checked = allChecked;
        selectAll.indeterminate = !allChecked && someChecked;
        selectAll.onchange = () => {
            const newState = selectAll.checked;
            checks.forEach(c => c.checked = newState);
            updateCodexSelectedCount();
        };
    }

    async function submitCodexImport() {
        const selections = currentCodexModels.map((m, index) => {
            const row = document.querySelector(`.codex-model-row[data-index="${index}"]`);
            const checked = row.querySelector('.codex-model-check').checked;
            const alias = row.querySelector('.codex-alias-input').value.trim() || m.remoteModelName;
            return {
                RemoteModelName: m.remoteModelName,
                DisplayName: alias,
                Selected: checked
            };
        });

        if (selections.filter(s => s.Selected).length === 0) {
            alert('请至少选择一个模型');
            return;
        }

        const btn = document.getElementById('btnImportCodexSelected');
        btn.disabled = true;
        btn.textContent = '导入中...';

        try {
            const r = await fetch(`/api/admin/codex/accounts/${currentCodexAccountId}/import-selected-models`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ Selections: selections })
            });
            const data = await r.json();
            if (!r.ok) {
                throw new Error(data.message || '导入失败');
            }
            bsCodexModelModal.hide();
            alert('导入完成，共导入 ' + data.importedCount + ' 个模型');
            await loadAccounts();
        } catch (e) {
            alert('导入失败：' + e.message);
        } finally {
            btn.disabled = false;
            btn.textContent = '导入选中模型';
        }
    }

    function showCodexModalError(message) {
        document.getElementById('codexModalLoading').style.display = 'none';
        document.getElementById('codexModalToolbar').style.display = '';
        document.getElementById('codexModalErrorText').textContent = message;
        document.getElementById('codexModalErrorBox').style.display = 'block';
        currentCodexModels = [];
        renderCodexModelList();
    }

    // —— 导出模式 ——
    let isExportMode = false;
    let selectedAccountIds = new Set();

    function toggleExportMode() {
        isExportMode = !isExportMode;
        const container = document.getElementById('accountsContainer');
        const toolbar = document.getElementById('exportToolbar');
        const btnText = document.getElementById('exportModeText');
        
        if (isExportMode) {
            container.classList.add('export-mode');
            toolbar.style.display = 'block';
            btnText.textContent = '取消导出';
            selectedAccountIds.clear();
            updateSelectedCount();
        } else {
            cancelExportMode();
        }
    }

    function cancelExportMode() {
        isExportMode = false;
        const container = document.getElementById('accountsContainer');
        const toolbar = document.getElementById('exportToolbar');
        const btnText = document.getElementById('exportModeText');
        
        container.classList.remove('export-mode');
        toolbar.style.display = 'none';
        btnText.textContent = '导出凭证';
        selectedAccountIds.clear();
        
        document.querySelectorAll('.codex-card.selected').forEach(card => {
            card.classList.remove('selected');
        });
        document.querySelectorAll('.codex-export-checkbox:checked').forEach(cb => {
            cb.checked = false;
        });
    }

    function handleCardClick(event, accountId) {
        if (!isExportMode) return;
        if (event.target.tagName === 'INPUT') return;
        if (event.target.tagName === 'BUTTON') return;
        if (event.target.closest('button')) return;
        if (event.target.classList.contains('codex-reset-credits-hint')) return;
        
        event.preventDefault();
        event.stopPropagation();
        toggleCardSelection(event, accountId);
    }

    function toggleCardSelection(event, accountId) {
        if (!isExportMode) return;
        event.stopPropagation();
        
        const card = document.querySelector(`.codex-card[data-id="${accountId}"]`);
        const checkbox = card.querySelector('.codex-export-checkbox');
        
        if (selectedAccountIds.has(accountId)) {
            selectedAccountIds.delete(accountId);
            card.classList.remove('selected');
            checkbox.checked = false;
        } else {
            selectedAccountIds.add(accountId);
            card.classList.add('selected');
            checkbox.checked = true;
        }
        
        updateSelectedCount();
    }

    function updateSelectedCount() {
        const countEl = document.getElementById('selectedCount');
        if (countEl) {
            countEl.textContent = selectedAccountIds.size;
        }
    }

    async function exportSelectedCredentials() {
        if (selectedAccountIds.size === 0) {
            alert('请至少选择一个账号');
            return;
        }

        try {
            const r = await fetch('/api/admin/codex/accounts/export-credentials', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ accountIds: Array.from(selectedAccountIds) })
            });

            if (!r.ok) {
                const data = await r.json();
                alert(data.message || '导出失败');
                return;
            }

            const data = await r.json();
            
            // 为每个账号生成独立的 JSON 文件并下载
            data.credentials.forEach((cred, index) => {
                const fileName = `codex_credential_${cred.email || cred.account_id || index + 1}.json`;
                const blob = new Blob([JSON.stringify(cred, null, 2)], { type: 'application/json' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = fileName;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                setTimeout(() => URL.revokeObjectURL(url), 1000);
            });

            alert(`成功导出 ${data.credentials.length} 个账号的凭证文件`);
            cancelExportMode();
        } catch (e) {
            alert('导出异常：' + e.message);
        }
    }

    // —— 工具 ——
    function escapeHtml(s) {
        return String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }
    function formatTime(s) {
        if (!s) return '—';
        try { return new Date(s).toLocaleString(); } catch { return s; }
    }
</script>
}
